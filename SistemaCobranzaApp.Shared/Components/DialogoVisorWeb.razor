@using MudBlazor

@*
    Visor de una web externa dentro de un diálogo.
    - En web: diálogo centrado de tamaño grande.
    - En móvil (MAUI): el llamador abre el diálogo con FullScreen = true, por lo que el iframe
      ocupa toda la pantalla gracias al alto 100% del contenedor.
    El contenido se muestra en un <iframe>; si la web externa prohíbe ser embebida
    (X-Frame-Options / CSP), el usuario puede abrirla en el navegador con el botón "Abrir en navegador".
*@
<MudDialog>
    <TitleContent>
        <div class="d-flex align-center justify-space-between" style="width:100%;">
            <MudText Typo="Typo.h6" Style="font-weight:600;">
                <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Class="mr-2" Style="vertical-align:middle;" Color="Color.Primary" />
                @Titulo
            </MudText>
            <div>
                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Color="Color.Inherit" title="Abrir en navegador"
                               Href="@Url" Target="_blank" />
                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" title="Cerrar" OnClick="Cerrar" />
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <div class="visor-web-contenedor">
            <iframe src="@Url" class="visor-web-iframe" title="@Titulo"
                    sandbox="allow-scripts allow-same-origin allow-popups allow-forms"
                    referrerpolicy="no-referrer"></iframe>
        </div>
    </DialogContent>
</MudDialog>

<style>
    .visor-web-contenedor {
        width: 100%;
        /* En diálogo normal usa una altura cómoda; en fullscreen el padre ocupa toda la pantalla. */
        height: 75vh;
        min-height: 320px;
    }
    .mud-dialog-fullscreen .visor-web-contenedor {
        height: 100%;
    }
    .visor-web-iframe {
        width: 100%;
        height: 100%;
        border: 0;
        display: block;
    }
</style>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>URL de la web a mostrar.</summary>
    [Parameter] public string Url { get; set; } = "";

    /// <summary>Título del diálogo.</summary>
    [Parameter] public string Titulo { get; set; } = "Ayuda";

    private void Cerrar() => MudDialog.Close(DialogResult.Ok(true));
}
