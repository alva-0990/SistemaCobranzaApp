@using MudBlazor
@using SistemaCobranzaApp.Shared.Dtos

<MudDialog Class="@ClaseDialogo">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight: 600;">
            <MudIcon Icon="@Icono" Class="mr-2" Style="vertical-align: middle;" />
            @Titulo
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_formValido">
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudTextField T="string"
                                  Label="Código / Clave"
                                  @bind-Value="Modelo.CodigoClave"
                                  Required="true"
                                  RequiredError="El código es obligatorio."
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="8">
                    <MudTextField T="string"
                                  Label="Descripción"
                                  @bind-Value="Modelo.Descripcion"
                                  Required="true"
                                  RequiredError="La descripción es obligatoria."
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <AutocompletarCatalogo TItem="CategoriaDto" Label="Categoría"
                                           Placeholder="Busca una categoría..."
                                           Margin="Margin.Dense"
                                           Required="true" RequiredError="La categoría es obligatoria."
                                           @bind-Value="Modelo.IdCategoria"
                                           Items="Categorias"
                                           ObtenerId="@(c => c.Id)"
                                           ObtenerTexto="@(c => c.Descripcion)" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <AutocompletarCatalogo TItem="MarcaDto" Label="Marca"
                                           Placeholder="Busca una marca..."
                                           Margin="Margin.Dense"
                                           Required="true" RequiredError="La marca es obligatoria."
                                           @bind-Value="Modelo.IdMarca"
                                           Items="Marcas"
                                           ObtenerId="@(m => m.Id)"
                                           ObtenerTexto="@(m => m.Descripcion)" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <AutocompletarCatalogo TItem="ColorDto" Label="Color (opcional)"
                                           Placeholder="Busca un color..."
                                           Margin="Margin.Dense"
                                           @bind-Value="Modelo.IdColor"
                                           Items="Colores"
                                           ObtenerId="@(c => c.Id)"
                                           ObtenerTexto="@(c => c.Descripcion)" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <AutocompletarCatalogo TItem="TallaDto" Label="Talla (opcional)"
                                           Placeholder="Busca una talla..."
                                           Margin="Margin.Dense"
                                           @bind-Value="Modelo.IdTalla"
                                           Items="Tallas"
                                           ObtenerId="@(t => t.Id)"
                                           ObtenerTexto="@(t => $"{t.Descripcion} ({t.Tipo})")" />
                </MudItem>

                <MudItem xs="12">
                    <MudAutocomplete T="long?" Label="Esquema de comisión"
                                     @bind-Value="Modelo.IdCatalogoComision"
                                     SearchFunc="BuscarComisiones"
                                     ToStringFunc="TextoComision"
                                     Required="true" RequiredError="Selecciona un esquema de comisión."
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     ResetValueOnEmptyText="true" CoerceText="true"
                                     Placeholder="Busca un esquema de comisión...">
                        <ItemTemplate Context="id">
                            @TextoComision(id)
                        </ItemTemplate>
                        <NoItemsTemplate>
                            <MudText Align="Align.Center" Class="px-4 py-1">Sin coincidencias.</MudText>
                        </NoItemsTemplate>
                    </MudAutocomplete>
                    @if (Comisiones.FirstOrDefault(c => c.Id == Modelo.IdCatalogoComision) is { } seleccionada)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @(seleccionada.TipoCalculo == "PORCENTAJE" ? "Porcentaje" : "Monto fijo"):
                            contado @FormatearComision(seleccionada.ComisionContado, seleccionada.TipoCalculo)
                            · crédito @FormatearComision(seleccionada.ComisionCredito, seleccionada.TipoCalculo)
                        </MudText>
                    }
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal"
                                     Label="Costo"
                                     @bind-Value="Modelo.Costo"
                                     Min="0"
                                     Format="N2"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Adornment="Adornment.Start"
                                     AdornmentText="$" />
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal"
                                     Label="Precio sugerido"
                                     @bind-Value="Modelo.PrecioSugerido"
                                     Min="0"
                                     Format="N2"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Adornment="Adornment.Start"
                                     AdornmentText="$" />
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal"
                                     Label="Precio mínimo"
                                     @bind-Value="Modelo.PrecioMinimo"
                                     Min="0"
                                     Format="N2"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Adornment="Adornment.Start"
                                     AdornmentText="$" />
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudNumericField T="int"
                                     Label="Stock mínimo"
                                     @bind-Value="Modelo.StockMini"
                                     Min="0"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" Class="d-flex align-center">
                    <MudSwitch T="bool"
                               @bind-Value="Modelo.Activo"
                               Color="Color.Primary"
                               Label="@(Modelo.Activo ? "Estatus: Activo" : "Estatus: Inactivo")" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancelar" Variant="Variant.Text" Color="Color.Default">Cancelar</MudButton>
        <MudButton OnClick="Guardar" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_formValido)">
            Guardar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string Titulo { get; set; } = "Gestionar producto";
    [Parameter] public string Icono { get; set; } = Icons.Material.Filled.Inventory2;
    [Parameter] public bool EsNuevo { get; set; }
    [Parameter] public FormModel Modelo { get; set; } = new();

    /// <summary>Clase CSS extra aplicada al contenedor del diálogo (p. ej. safe-area en móvil a pantalla completa).</summary>
    [Parameter] public string? ClaseDialogo { get; set; }

    [Parameter] public IReadOnlyList<CategoriaDto> Categorias { get; set; } = new List<CategoriaDto>();
    [Parameter] public IReadOnlyList<MarcaDto> Marcas { get; set; } = new List<MarcaDto>();
    [Parameter] public IReadOnlyList<ColorDto> Colores { get; set; } = new List<ColorDto>();
    [Parameter] public IReadOnlyList<TallaDto> Tallas { get; set; } = new List<TallaDto>();

    [Parameter] public IReadOnlyList<CatalogoComisionDto> Comisiones { get; set; } = new List<CatalogoComisionDto>();

    private static string FormatearComision(decimal valor, string tipoCalculo)
        => tipoCalculo == "PORCENTAJE" ? $"{valor:N2} %" : valor.ToString("C2");

    // Texto visible de un esquema de comisión. Incluye el esquema actual aunque esté inactivo
    // (cuando se edita un producto cuyo esquema ya no está en el catálogo activo).
    private string TextoComision(long? id)
    {
        if (id is null) return string.Empty;
        var comision = Comisiones.FirstOrDefault(c => c.Id == id.Value);
        if (comision is not null) return comision.NombreEsquema;
        if (id.Value == Modelo.IdCatalogoComision && !string.IsNullOrWhiteSpace(Modelo.NombreComisionActual))
            return $"{Modelo.NombreComisionActual} (inactivo)";
        return string.Empty;
    }

    // Candidatos (ids) filtrados por el texto. Mantiene visible el esquema inactivo ya asignado.
    private Task<IEnumerable<long?>> BuscarComisiones(string? valor, CancellationToken ct)
    {
        IEnumerable<CatalogoComisionDto> activos = Comisiones;
        if (!string.IsNullOrWhiteSpace(valor))
            activos = activos.Where(c => (c.NombreEsquema ?? string.Empty)
                .Contains(valor, StringComparison.OrdinalIgnoreCase));

        var ids = activos.Select(c => (long?)c.Id).ToList();

        // Al editar: si el esquema actual está inactivo (fuera del catálogo), lo incluimos para no perderlo.
        if (!EsNuevo && Modelo.IdCatalogoComision is long idActual && Comisiones.All(c => c.Id != idActual))
        {
            var texto = Modelo.NombreComisionActual ?? string.Empty;
            var coincide = string.IsNullOrWhiteSpace(valor)
                || texto.Contains(valor, StringComparison.OrdinalIgnoreCase);
            if (coincide && !ids.Contains(idActual)) ids.Insert(0, idActual);
        }

        return Task.FromResult<IEnumerable<long?>>(ids);
    }

    private MudForm _form = null!;
    private bool _formValido;

    private void Cancelar() => MudDialog.Cancel();

    private async Task Guardar()
    {
        await _form.ValidateAsync();
        if (_formValido)
            MudDialog.Close(DialogResult.Ok(Modelo));
    }

    public class FormModel
    {
        public string CodigoClave { get; set; } = string.Empty;
        public string Descripcion { get; set; } = string.Empty;
        public decimal Costo { get; set; }
        public decimal PrecioSugerido { get; set; }
        public decimal PrecioMinimo { get; set; }
        public int StockMini { get; set; }
        public long? IdCategoria { get; set; }
        public long? IdMarca { get; set; }
        public long? IdColor { get; set; }
        public long? IdTalla { get; set; }
        public long? IdCatalogoComision { get; set; }
        public string NombreComisionActual { get; set; } = string.Empty;
        public bool Activo { get; set; } = true;
    }
}
