@typeparam TItem
@using MudBlazor

@*
    Selector con búsqueda para catálogos del tipo (id numérico + descripción).
    Reemplaza a un MudSelect<long?> manteniendo el mismo binding (@bind-Value sobre long?).
    - Items:        colección de opciones.
    - ObtenerId:    extrae el id (long) de cada item.
    - ObtenerTexto: extrae el texto visible de cada item.
    El valor nulo representa "todas / todos" (sin filtro).
*@

<MudAutocomplete T="long?"
                 Label="@Label"
                 Value="Value"
                 ValueChanged="OnValueChanged"
                 SearchFunc="Buscar"
                 ToStringFunc="TextoDe"
                 Dense="@Dense"
                 Margin="@Margin"
                 Variant="@Variant"
                 Required="@Required"
                 RequiredError="@RequiredError"
                 Class="@Class"
                 Disabled="@Disabled"
                 Clearable="@Clearable"
                 ResetValueOnEmptyText="true"
                 CoerceText="true"
                 Placeholder="@Placeholder">
    <ItemTemplate Context="id">
        @TextoDe(id)
    </ItemTemplate>
    <NoItemsTemplate>
        <MudText Align="Align.Center" Class="px-4 py-1">Sin coincidencias.</MudText>
    </NoItemsTemplate>
</MudAutocomplete>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; } = "Busca y selecciona...";

    [Parameter] public long? Value { get; set; }
    [Parameter] public EventCallback<long?> ValueChanged { get; set; }

    [Parameter] public IEnumerable<TItem> Items { get; set; } = Array.Empty<TItem>();
    [Parameter] public Func<TItem, long> ObtenerId { get; set; } = _ => 0;
    [Parameter] public Func<TItem, string?> ObtenerTexto { get; set; } = _ => string.Empty;

    [Parameter] public bool Dense { get; set; } = true;
    [Parameter] public Margin Margin { get; set; } = Margin.None;
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public string? Class { get; set; }

    [Parameter] public bool Required { get; set; }
    [Parameter] public string RequiredError { get; set; } = "Este campo es obligatorio.";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Clearable { get; set; } = true;

    private Task OnValueChanged(long? valor) => ValueChanged.InvokeAsync(valor);

    // Texto visible de un id (para el cuadro y para la lista desplegable).
    private string TextoDe(long? id)
    {
        if (id is null) return string.Empty;
        var item = Items.FirstOrDefault(x => ObtenerId(x) == id.Value);
        return item is null ? string.Empty : (ObtenerTexto(item) ?? string.Empty);
    }

    // Candidatos (ids) filtrados por el texto escrito.
    private Task<IEnumerable<long?>> Buscar(string? valor, CancellationToken ct)
    {
        IEnumerable<TItem> origen = Items;
        if (!string.IsNullOrWhiteSpace(valor))
            origen = origen.Where(x => (ObtenerTexto(x) ?? string.Empty)
                .Contains(valor, StringComparison.OrdinalIgnoreCase));

        IEnumerable<long?> ids = origen.Select(x => (long?)ObtenerId(x));
        return Task.FromResult(ids);
    }
}
