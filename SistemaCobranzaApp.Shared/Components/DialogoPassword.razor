@using MudBlazor
@using SistemaCobranzaApp.Shared.Dtos
@using SistemaCobranzaApp.Shared.Services
@using SistemaCobranzaApp.Domain.Seguridad
@inject ApiCliente Api

<MudDialog Class="dialogo-usuario-fullscreen">
    <DialogContent>
        <MudTextField T="string" Label="Nueva contraseña" @bind-Value="_nueva"
                      InputType="@(_mostrarNueva ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_mostrarNueva ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      AdornmentAriaLabel="@(_mostrarNueva ? "Ocultar contraseña" : "Mostrar contraseña")"
                      OnAdornmentClick="() => _mostrarNueva = !_mostrarNueva"
                      Immediate="true"
                      Validation="@((Func<string?, string?>)ValidarNueva)"
                      HelperText="@ValidacionUsuario.RequisitosPassword"
                      Variant="Variant.Outlined" Disabled="_guardando" autocomplete="new-password" />
        <MudTextField T="string" Label="Confirmar contraseña" @bind-Value="_confirmacion"
                      InputType="@(_mostrarConfirmacion ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_mostrarConfirmacion ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      AdornmentAriaLabel="@(_mostrarConfirmacion ? "Ocultar contraseña" : "Mostrar contraseña")"
                      OnAdornmentClick="() => _mostrarConfirmacion = !_mostrarConfirmacion"
                      Immediate="true"
                      Validation="@((Func<string?, string?>)ValidarConfirmacion)"
                      Variant="Variant.Outlined" Class="mt-4" Disabled="_guardando" autocomplete="new-password" />
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Disabled="_guardando">Cancelar</MudButton>
        <MudButton OnClick="Guardar" Color="Color.Primary" Variant="Variant.Filled" Disabled="_guardando">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string _nueva = "";
    private string _confirmacion = "";
    private string? _error;
    private bool _guardando;
    private bool _mostrarNueva;
    private bool _mostrarConfirmacion;
    private void Cancelar() => MudDialog.Cancel();

    // Mientras no se escriba nada no se marca error; al guardar se valida completo.
    private static string? ValidarNueva(string? valor)
        => string.IsNullOrEmpty(valor) ? null : ValidacionUsuario.ValidarPassword(valor);

    private string? ValidarConfirmacion(string? valor)
        => string.IsNullOrEmpty(valor) || valor == _nueva ? null : "Las contraseñas no coinciden.";
    private async Task Guardar()
    {
        if (_guardando) return;
        _error = ValidacionUsuario.ValidarPassword(_nueva)
                 ?? (_nueva != _confirmacion ? "Las contraseñas no coinciden." : null);
        if (_error is not null) return;
        _guardando = true;
        try
        {
            _error = await Api.ActualizarPasswordAsync(new(_nueva, _confirmacion));
            if (_error is null) MudDialog.Close(DialogResult.Ok(true));
        }
        catch
        {
            _error = "No se pudo actualizar la contraseña. Intenta de nuevo.";
        }
        finally { _guardando = false; }
    }
}
