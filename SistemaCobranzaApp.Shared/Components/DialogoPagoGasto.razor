@using MudBlazor
@using SistemaCobranzaApp.Shared.Dtos

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6"><b>Registrar pago — @Folio</b></MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Saldo pendiente: <b>@SaldoPendiente.ToString("C2")</b>
        </MudText>

        <MudSelect T="long?" @bind-Value="IdCuenta" Label="Cuenta de origen"
                   Variant="Variant.Outlined" Class="mb-3">
            @foreach (var c in Cuentas)
            {
                <MudSelectItem T="long?" Value="@c.IdCuentaGasto">
                    @c.Nombre (@c.SaldoActual.ToString("C2"))
                </MudSelectItem>
            }
        </MudSelect>

        <MudNumericField T="decimal" @bind-Value="Importe" Label="Importe"
                         Variant="Variant.Outlined" Min="0" Max="@SaldoPendiente" Format="N2" Class="mb-3" />

        <MudSelect T="string" @bind-Value="FormaPago" Label="Forma de pago"
                   Variant="Variant.Outlined" Class="mb-3">
            <MudSelectItem T="string" Value="@("EFECTIVO")">Efectivo</MudSelectItem>
            <MudSelectItem T="string" Value="@("TRANSFERENCIA")">Transferencia</MudSelectItem>
            <MudSelectItem T="string" Value="@("TARJETA")">Tarjeta</MudSelectItem>
            <MudSelectItem T="string" Value="@("CHEQUE")">Cheque</MudSelectItem>
            <MudSelectItem T="string" Value="@("OTRO")">Otro</MudSelectItem>
        </MudSelect>

        <MudTextField T="string" @bind-Value="Referencia" Label="Referencia (opcional)"
                      Variant="Variant.Outlined" MaxLength="100" Class="mb-3" />

        <MudTextField T="string" @bind-Value="Observaciones" Label="Observaciones (opcional)"
                      Variant="Variant.Outlined" Lines="2" Class="mb-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Aceptar">Aplicar pago</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Folio { get; set; } = "";
    [Parameter] public decimal SaldoPendiente { get; set; }
    [Parameter] public IReadOnlyList<CuentaGastoDto> Cuentas { get; set; } = Array.Empty<CuentaGastoDto>();

    private long? IdCuenta { get; set; }
    private decimal Importe { get; set; }
    private string FormaPago { get; set; } = "EFECTIVO";
    private string? Referencia { get; set; }
    private string? Observaciones { get; set; }

    protected override void OnInitialized()
    {
        if (Cuentas.Count > 0) IdCuenta = Cuentas[0].IdCuentaGasto;
        Importe = SaldoPendiente;
    }

    public record Resultado(long IdCuenta, decimal Importe, string FormaPago, string? Referencia, string? Observaciones);

    private void Aceptar()
    {
        if (IdCuenta is null || Importe <= 0 || Importe > SaldoPendiente) return;
        MudDialog.Close(DialogResult.Ok(new Resultado(
            IdCuenta.Value, Importe, FormaPago,
            string.IsNullOrWhiteSpace(Referencia) ? null : Referencia!.Trim(),
            string.IsNullOrWhiteSpace(Observaciones) ? null : Observaciones!.Trim())));
    }

    private void Cancelar() => MudDialog.Cancel();
}
