@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight: 600;">
            <MudIcon Icon="@Icono" Class="mr-2" Style="vertical-align: middle;" Color="@ColorIcono" />
            @Titulo
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudText Typo="Typo.body1" Style="white-space: pre-line;">@Mensaje</MudText>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancelar" Variant="Variant.Text" Color="Color.Default">
            @TextoCancelar
        </MudButton>
        <MudButton OnClick="Aceptar" Variant="Variant.Filled" Color="@ColorAceptar">
            @TextoAceptar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string Titulo { get; set; } = "Confirmar";
    [Parameter] public string Mensaje { get; set; } = "";
    [Parameter] public string Icono { get; set; } = Icons.Material.Filled.HelpOutline;
    [Parameter] public Color ColorIcono { get; set; } = Color.Warning;
    [Parameter] public string TextoAceptar { get; set; } = "Aceptar";
    [Parameter] public string TextoCancelar { get; set; } = "Cancelar";
    [Parameter] public Color ColorAceptar { get; set; } = Color.Primary;

    private void Cancelar() => MudDialog.Cancel();
    private void Aceptar() => MudDialog.Close(DialogResult.Ok(true));
}
