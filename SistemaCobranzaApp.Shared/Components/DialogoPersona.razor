@using MudBlazor
@using SistemaCobranzaApp.Shared.Dtos

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight: 600;">
            <MudIcon Icon="@Icono" Class="mr-2" Style="vertical-align: middle;" />
            @Titulo
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_formValido">
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="@LabelNombre"
                                  @bind-Value="Modelo.Nombre"
                                  Required="true"
                                  RequiredError="El nombre es obligatorio."
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                @if (MostrarZona)
                {
                    <MudItem xs="12">
                        <MudSelect T="long?"
                                   Label="Zona asignada"
                                   @bind-Value="Modelo.IdZona"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Clearable="true"
                                  >
                            @foreach (var z in Zonas)
                            {
                                <MudSelectItem T="long?" Value="@z.IdZona">@z.Descripcion</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }

                @if (MostrarUsuario)
                {
                    <MudItem xs="12">
                        <MudSelect T="long?" Label="Usuario asignado"
                                   @bind-Value="Modelo.IdUsuario"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Clearable="true">
                            @foreach (var usuario in Usuarios)
                            {
                                <MudSelectItem T="long?" Value="@usuario.IdUsuario">
                                    @usuario.Usuario — @usuario.NombreCompleto @(!usuario.Activo ? "(Inactivo)" : "")
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }

                <MudItem xs="12" Class="d-flex align-center">
                    <MudSwitch T="bool"
                               @bind-Value="Modelo.Activo"
                               Color="Color.Primary"
                               Label="@(Modelo.Activo ? "Estatus: Activo" : "Estatus: Inactivo")" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancelar" Variant="Variant.Text" Color="Color.Default">Cancelar</MudButton>
        <MudButton OnClick="Guardar" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_formValido)">
            Guardar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string Titulo { get; set; } = "Gestionar";
    [Parameter] public string Icono { get; set; } = Icons.Material.Filled.PersonAdd;
    [Parameter] public string LabelNombre { get; set; } = "Nombre completo";
    [Parameter] public FormModel Modelo { get; set; } = new();
    [Parameter] public IReadOnlyList<ZonaDto> Zonas { get; set; } = new List<ZonaDto>();
    [Parameter] public bool MostrarZona { get; set; } = true;
    [Parameter] public bool MostrarUsuario { get; set; }
    [Parameter] public IReadOnlyList<UsuarioDto> Usuarios { get; set; } = new List<UsuarioDto>();

    private MudForm _form = null!;
    private bool _formValido;

    private void Cancelar() => MudDialog.Cancel();

    private async Task Guardar()
    {
        await _form.Validate();
        if (_formValido)
            MudDialog.Close(DialogResult.Ok(Modelo));
    }

    public class FormModel
    {
        public string Nombre { get; set; } = string.Empty;
        public long? IdZona { get; set; }
        public long? IdUsuario { get; set; }
        public bool Activo { get; set; } = true;
    }
}
