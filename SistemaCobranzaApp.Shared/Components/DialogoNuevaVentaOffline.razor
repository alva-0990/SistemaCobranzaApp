        /* ACCIONES */
        .acciones-dialogo {
            flex-direction: column-reverse;
            align-items: stretch;
            gap: 8px;
            padding: 4px 0;
        }

        .acciones-dialogo .mud-button {
            width: 100%;
            min-height: 42px;
        }

    }


    /* ================================================================ */
    /* TELÉFONOS MUY PEQUEÑOS */
    /* ================================================================ */

    @@media (max-width: 380px) {

        .captura-articulo {
            grid-template-columns: 1fr;
        }

        .campo-producto,
        .campo-cantidad,
        .campo-precio,
        .campo-agregar {
            grid-column: 1;
        }

        .captura-condicion {
            grid-template-columns: 1fr;
        }

        .campo-plazo,
        .campo-liquidacion,
        .campo-agregar-condicion {
            grid-column: 1;
        }

        .detalle-card-datos {
            grid-template-columns: 1fr 1fr;
        }

        .detalle-card-total {
            grid-column: 1 / -1;
            text-align: left;
        }

    }

