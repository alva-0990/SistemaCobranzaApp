@using MudBlazor
@using SistemaCobranzaApp.Shared.Dtos
@using SistemaCobranzaApp.Domain.Ventas
@using SistemaCobranzaApp.Shared.Services

@inject ISnackbar _snackbar
@inject ApiCliente Api

<MudDialog Class="dialogo-adaptativo">

    <TitleContent>
        <div class="encabezado-venta">
            <MudIcon Icon="@Icons.Material.Filled.AddShoppingCart"
                     Color="Color.Success"
                     Size="Size.Medium" />

            <MudText Typo="Typo.h6" Class="titulo-venta">
                Nueva Venta a Crédito
            </MudText>

            <MudText Typo="Typo.caption"
                     Color="Color.Secondary"
                     Class="cliente-venta">
                @Cliente.NombreCompleto
            </MudText>
        </div>
    </TitleContent>

    <DialogContent>
        @if (ModoRenovacion)
        {
            <div class="alert alert-warning banner-renovacion" role="alert">
                ⚠️ Modo Renovación: Liquidando cuenta <strong>@(CodigoVentaVieja ?? $"#{IdVentaVieja}")</strong>
            </div>
        }


        <MudGrid Spacing="3" Class="contenido-dialogo-venta">

            <!-- ========================================================= -->
            <!-- SECCIÓN 1: ARTÍCULOS -->
            <!-- ========================================================= -->

            <MudItem xs="12" md="7">

                <MudText Typo="Typo.subtitle2" Class="mb-3" Color="Color.Primary">
                    <b>🛒 Artículos de la Venta</b>
                </MudText>

                <!-- CAPTURA DE ARTÍCULO -->
                <div class="captura-articulo">

                    <div class="campo-producto">
                        <MudAutocomplete T="ArticuloInventario"
                                         Label="Seleccionar Artículo"
                                         Value="_productoSeleccionado"
                                         ValueChanged="OnProductoSeleccionado"
                                         SearchFunc="BuscarArticulos"
                                         Variant="Variant.Outlined"
                                         Dense="true"
                                         FullWidth="true"
                                         Clearable="true"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="true"
                                         Placeholder="Busca por nombre o categoría..."
                                         ToStringFunc="@(a => a is null ? "" : a.Descripcion)">
                            <ItemTemplate Context="art">
                                @art.Descripcion (@art.Categoria) — Disp.: @art.Disponible
                            </ItemTemplate>
                            <NoItemsTemplate>
                                <MudText Align="Align.Center" Class="px-4 py-1">Sin coincidencias.</MudText>
                            </NoItemsTemplate>
                        </MudAutocomplete>
                    </div>

                    <div class="campo-cantidad">
                        <MudNumericField T="int"
                                         Label="Cant."
                                         @bind-Value="_cantidadCaptura"
                                         Min="1"
                                         Max="@_maxCantidadCaptura"
                                         Variant="Variant.Outlined"
                                         Dense="true"
                                         FullWidth="true" 
                                         InputAttributes="@(new Dictionary<string, object>
                                                          {
                                                              ["onfocus"] = "this.select()"
                                                          })"/>
                    </div>

                    <div class="campo-precio">
                        <MudNumericField T="decimal"
                                         Label="Precio"
                                         @bind-Value="_precioCaptura"
                                         Min="0"
                                         Format="C2"
                                         Variant="Variant.Outlined"
                                         Dense="true"
                                         FullWidth="true" 
                                         InputAttributes="@(new Dictionary<string, object>
                                                          {
                                                              ["onfocus"] = "this.select()"
                                                          })"/>
                    </div>

                    <div class="campo-agregar">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AgregarArticulo"
                                   Class="boton-agregar-articulo">
                            Agregar artículo
                        </MudButton>
                    </div>

                </div>

                <!-- INFORMACIÓN DEL PRODUCTO -->
                @if (_productoSeleccionado is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="info-producto">
                        Disponible en zona: <b>@_productoSeleccionado.Disponible</b>
                        <span class="separador-info">·</span>
                        Precio sugerido: <b>@_productoSeleccionado.PrecioSugerido.ToString("C2")</b>
                    </MudText>
                }
                else if (!_catalogoInventario.Any())
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                        No hay productos con existencia en la zona del cliente.
                    </MudAlert>
                }

                <!-- DETALLE ESCRITORIO -->
                <div class="detalle-escritorio">
                    <MudTable Items="_detallesCapturados" Dense="true" Hover="true"
                              Elevation="0" Height="240px" FixedHeader="true">
                        <HeaderContent>
                            <MudTh>Artículo</MudTh>
                            <MudTh Style="text-align:center; width:15%;">Cant.</MudTh>
                            <MudTh Style="text-align:right; width:20%;">Precio</MudTh>
                            <MudTh Style="text-align:right; width:25%;">Importe</MudTh>
                            <MudTh Style="width:10%;"></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.NombreProducto</MudTd>
                            <MudTd Style="text-align:center;">@context.Cantidad</MudTd>
                            <MudTd Style="text-align:right;">@context.PrecioCobrado.ToString("C2")</MudTd>
                            <MudTd Style="text-align:right;"><b>@((context.Cantidad * context.PrecioCobrado).ToString("C2"))</b></MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => EliminarArticulo(context))" />
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="pa-3">
                                Agrega al menos un artículo a la venta.
                            </MudText>
                        </NoRecordsContent>
                    </MudTable>
                </div>

                <!-- DETALLE MÓVIL -->
                <div class="detalle-movil">
                    @if (_detallesCapturados.Any())
                    {
                        @foreach (var detalle in _detallesCapturados)
                        {
                            <MudPaper Elevation="1" Class="detalle-card">
                                <div class="detalle-card-header">
                                    <MudText Typo="Typo.subtitle2"><b>@detalle.NombreProducto</b></MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => EliminarArticulo(detalle))" />
                                </div>
                                <MudDivider Class="my-2" />
                                <div class="detalle-card-datos">
                                    <div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Cantidad</MudText>
                                        <MudText Typo="Typo.body2"><b>@detalle.Cantidad</b></MudText>
                                    </div>
                                    <div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Precio</MudText>
                                        <MudText Typo="Typo.body2"><b>@detalle.PrecioCobrado.ToString("C2")</b></MudText>
                                    </div>
                                    <div class="detalle-card-total">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Importe</MudText>
                                        <MudText Typo="Typo.body1" Color="Color.Success">
                                            <b>@((detalle.Cantidad * detalle.PrecioCobrado).ToString("C2"))</b>
                                        </MudText>
                                    </div>
                                </div>
                            </MudPaper>
                        }
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="sin-articulos">
                            Agrega al menos un artículo a la venta.
                        </MudText>
                    }
                </div>

                <!-- ========================================================= -->
                <!-- SECCIÓN: PROMOCIÓN / CONDICIONES DE LIQUIDACIÓN -->
                <!-- ========================================================= -->

                <MudDivider Class="my-4" />

                <MudText Typo="Typo.subtitle2" Color="Color.Primary">
                    <b>🏷️ Promoción / Condiciones de liquidación</b>
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
                    Condiciones negociadas con el cliente (opcional).
                </MudText>

                <!-- CAPTURA DE CONDICIÓN -->
                <div class="captura-condicion">

                    <div class="campo-plazo">
                        <MudAutocomplete T="MesDto"
                                         Label="Plazo"
                                         Value="_mesSeleccionado"
                                         ValueChanged="@(m => _mesSeleccionado = m)"
                                         SearchFunc="BuscarPlazos"
                                         Variant="Variant.Outlined"
                                         Dense="true"
                                         FullWidth="true"
                                         Clearable="true"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="true"
                                         Placeholder="Busca un plazo..."
                                         ToStringFunc="@(m => m is null ? "" : $"{m.NumMeses}{m.Descripcion}")">
                            <ItemTemplate Context="mes">
                                @mes.NumMeses@mes.Descripcion
                            </ItemTemplate>
                            <NoItemsTemplate>
                                <MudText Align="Align.Center" Class="px-4 py-1">Sin coincidencias.</MudText>
                            </NoItemsTemplate>
                        </MudAutocomplete>
                    </div>

                    <div class="campo-liquidacion">
                        <MudNumericField T="decimal"
                                         Label="Monto de liquidación"
                                         @bind-Value="_montoLiquidacionCaptura"
                                         Min="0"
                                         Format="C2"
                                         Variant="Variant.Outlined"
                                         Dense="true"
                                         FullWidth="true" 
                                         InputAttributes="@(new Dictionary<string, object>
                                                          {
                                                              ["onfocus"] = "this.select()"
                                                          })"/>
                    </div>

                    <div class="campo-agregar-condicion">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AgregarCondicion"
                                   FullWidth="true"
                                   Class="boton-agregar-condicion">
                            Agregar condición
                        </MudButton>
                    </div>

                </div>

                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
                    Ejemplo: 1 mes → $1,200 · 2 meses → $1,500 · 3 meses → $1,800
                </MudText>

                @if (_planesCapturados.Any())
                {
                    <!-- CONDICIONES ESCRITORIO -->
                    <div class="detalle-escritorio">
                        <MudTable Items="_planesCapturados" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Plazo</MudTh>
                                <MudTh Style="text-align:right; width:35%;">Monto de liquidación</MudTh>
                                <MudTh Style="width:12%;"></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.NumeroMeses @(context.NumeroMeses == 1 ? "mes" : "meses")</MudTd>
                                <MudTd Style="text-align:right;"><b>@context.MontoLiquidacion.ToString("C2")</b></MudTd>
                                <MudTd Style="text-align:right;">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => EliminarCondicion(context))" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>

                    <!-- CONDICIONES MÓVIL -->
                    <div class="detalle-movil">
                        @foreach (var plan in _planesCapturados)
                        {
                            <MudPaper Elevation="1" Class="detalle-card">
                                <div class="detalle-card-header">
                                    <MudText Typo="Typo.subtitle2">
                                        <b>@plan.NumeroMeses @(plan.NumeroMeses == 1 ? "mes" : "meses")</b>
                                    </MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => EliminarCondicion(plan))" />
                                </div>
                                <div class="detalle-card-datos">
                                    <div class="detalle-card-total">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Monto de liquidación</MudText>
                                        <MudText Typo="Typo.body1" Color="Color.Success">
                                            <b>@plan.MontoLiquidacion.ToString("C2")</b>
                                        </MudText>
                                    </div>
                                </div>
                            </MudPaper>
                        }
                    </div>
                }

            </MudItem>


            <!-- ========================================================= -->
            <!-- SECCIÓN 2: CRÉDITO -->
            <!-- ========================================================= -->

            <MudItem xs="12" md="5" Class="seccion-credito">

                <MudText Typo="Typo.subtitle2" Class="mb-3" Color="Color.Primary">
                    <b>💰 Resumen y Plan de Crédito</b>
                </MudText>

                <!-- Vendedor que realiza la venta -->
                <MudAutocomplete T="VendedorDto"
                                 Value="_vendedorSeleccionado"
                                 ValueChanged="OnVendedorSeleccionado"
                                 SearchFunc="BuscarVendedores"
                                 Label="Vendedor"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Class="mb-3"
                                 Clearable="true"
                                 ResetValueOnEmptyText="true"
                                 CoerceText="true"
                                 Placeholder="Busca un vendedor..."
                                 Adornment="Adornment.Start"
                                 AdornmentIcon="@Icons.Material.Filled.Person"
                                 ToStringFunc="@(v => v?.Nombre ?? "")">
                    <ItemTemplate Context="vend">@vend.Nombre</ItemTemplate>
                    <NoItemsTemplate>
                        <MudText Align="Align.Center" Class="px-4 py-1">Sin coincidencias.</MudText>
                    </NoItemsTemplate>
                </MudAutocomplete>

                <!-- Tipo de venta (CRÉDITO / CONTADO) -->
                <MudSelect T="CondicionCreditoDto"
                           Value="_condicionSeleccionada"
                           ValueChanged="OnCondicionSeleccionada"
                           Label="Tipo de venta"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="mb-3"
                           Adornment="Adornment.Start"
                           AdornmentIcon="@Icons.Material.Filled.Sell"
                           ToStringFunc="@(c => c?.Descripcion ?? "")">
                    @foreach (var cond in _condiciones)
                    {
                        <MudSelectItem T="CondicionCreditoDto" Value="cond">@cond.Descripcion</MudSelectItem>
                    }
                </MudSelect>

                <div class="fila-resumen">
                    <MudText>Subtotal:</MudText>
                    <MudText Typo="Typo.body1"><b>@_subtotal.ToString("C2")</b></MudText>
                </div>

                <MudNumericField T="decimal"
                                 Label="Descuento Global"
                                 @bind-Value="_descuentoGlobal"
                                 Min="0"
                                 Format="C2"
                                 Variant="Variant.Outlined"
                                 Dense="true"
                                 Class="mb-3"
                                 Immediate="true"
                                 FullWidth="true" 
                                 InputAttributes="@(new Dictionary<string, object>
                                                  {
                                                      ["onfocus"] = "this.select()"
                                                  })"/>

                @if (ModoRenovacion)
                {
                    <div class="fila-resumen">
                        <MudText>Cargo por Liquidación:</MudText>
                        <MudText><b>@CargoRenovacion.ToString("C2")</b></MudText>
                    </div>
                }
                <div class="total-final">
                    <MudText Typo="Typo.button">TOTAL FINAL:</MudText>
                    <MudText Typo="Typo.h6"><b>@_totalFinal.ToString("C2")</b></MudText>
                </div>

                <MudNumericField T="decimal"
                                 Label="Enganche (Pronto Pago)"
                                 @bind-Value="_enganche"
                                 Min="0"
                                 Format="C2"
                                 Variant="Variant.Outlined"
                                 Dense="true"
                                 Class="mt-3 mb-2"
                                 Immediate="true"
                                 FullWidth="true" 
                                 InputAttributes="@(new Dictionary<string, object>
                                                  {
                                                      ["onfocus"] = "this.select()"
                                                  })"/>

                <div class="fila-resumen monto-financiado">
                    <MudText>Monto Neto a Financiar:</MudText>
                    <MudText><b>@_montoFinanciado.ToString("C2")</b></MudText>
                </div>

                <MudDivider Class="my-3" />

                <MudSelect T="CatalogoFrecuenciaPagoDto"
                           Label="📅 Frecuencia de Cobro"
                           @bind-Value="_frecuenciaSeleccionada"
                           Variant="Variant.Outlined"
                           Dense="true"
                           Class="mb-3"
                           FullWidth="true">
                    @foreach (var f in _catalogoFrecuencias)
                    {
                        <MudSelectItem Value="@f">@f.Descripcion (@f.DiasPeriodo días)</MudSelectItem>
                    }
                </MudSelect>

                <MudNumericField T="decimal"
                                 Label="@(ModoRenovacion ? "Cuota base para calcular plazo" : "Cuota Fija Exigida/Pactada")"
                                 @bind-Value="_cuotaFijaExigida"
                                 Min="1"
                                 Format="C2"
                                 Variant="Variant.Outlined"
                                 Dense="true"
                                 Class="mb-3"
                                 Immediate="true"
                                 FullWidth="true" 
                                 InputAttributes="@(new Dictionary<string, object>
                                                  {
                                                      ["onfocus"] = "this.select()"
                                                  })"/>

                @if (_montoFinanciado > 0 && _cuotaFijaExigida > 0)
                {
                    <div class="proyeccion-cuotas">
                        <MudText Typo="Typo.caption">Plazo Proyectado:</MudText>
                        <MudText Typo="Typo.subtitle2"><b>@_cuotasProyectadas cuotas fijas</b></MudText>
                    </div>
                    @if (ModoRenovacion)
                    {
                        <MudText Typo="Typo.body2" Class="mt-1">Cuota con liquidación: @CuotaRenovada.ToString("C2")</MudText>
                    }
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">
                        La última cuota será de @_ultimaCuotaAjuste.ToString("C2").
                    </MudText>
                }

            </MudItem>

        </MudGrid>

    </DialogContent>


    <!-- ============================================================= -->
    <!-- ACCIONES -->
    <!-- ============================================================= -->

    <DialogActions>
        <div class="acciones-dialogo">
        <MudButton OnClick="Cancelar" Variant="Variant.Text" Color="Color.Default">
            Cancelar
        </MudButton>
        <MudButton Color="Color.Success"
                   Variant="Variant.Filled"
                   OnClick="ProcesarEstructuraVenta"
                   Disabled="@(!_detallesCapturados.Any())"
                   StartIcon="@Icons.Material.Filled.CheckCircle">
            @(ModoRenovacion ? "Confirmar renovación" : "Confirmar Venta")
        </MudButton>
        </div>
    </DialogActions>

</MudDialog>


<style>
    .banner-renovacion { position: sticky; top: 0; z-index: 2; }


    /* ================================================================ */
    /* DIÁLOGO GENERAL */
    /* ================================================================ */

    .dialogo-adaptativo {
        width: min(900px, 96vw);
        max-width: 900px;
    }

    .contenido-dialogo-venta {
        overflow-x: hidden;
    }


    /* ================================================================ */
    /* ENCABEZADO */
    /* ================================================================ */

    .encabezado-venta {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
    }

    .titulo-venta {
        white-space: nowrap;
    }

    .cliente-venta {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }


    /* ================================================================ */
    /* CAPTURA DE ARTÍCULOS */
    /* ================================================================ */

    .captura-articulo {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 90px 130px;
        gap: 10px;
        align-items: center;
        width: 100%;
    }

    .campo-producto,
    .campo-cantidad,
    .campo-precio,
    .campo-agregar {
        min-width: 0;
    }

    .campo-agregar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        /* El botón ocupa su propia fila completa debajo de los campos (no comprime el selector). */
        grid-column: 1 / -1;
    }

    .boton-agregar-articulo {
        /* En escritorio el botón queda compacto a la derecha de su fila; en móvil (media query) va al 100%. */
        width: auto;
        margin-top: 4px;
    }

    .info-producto {
        display: block;
        margin-top: 8px;
        margin-bottom: 12px;
    }

    .separador-info {
        margin: 0 5px;
    }


    /* ================================================================ */
    /* CAPTURA DE CONDICIÓN DE LIQUIDACIÓN */
    /* ================================================================ */

    .captura-condicion {
        display: grid;
        grid-template-columns: 120px minmax(0, 1fr) auto;
        gap: 10px;
        align-items: center;
        width: 100%;
        margin-bottom: 6px;
    }

    .campo-plazo,
    .campo-liquidacion,
    .campo-agregar-condicion {
        min-width: 0;
    }


    /* ================================================================ */
    /* DETALLE ESCRITORIO / MÓVIL */
    /* ================================================================ */

    .detalle-escritorio {
        width: 100%;
        margin-top: 12px;
    }

    .detalle-movil {
        display: none;
    }


    /* ================================================================ */
    /* RESUMEN */
    /* ================================================================ */

    .seccion-credito {
        border-left: 1px solid var(--mud-palette-lines-inputs);
        padding-left: 24px !important;
    }

    .fila-resumen {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin: 8px 0;
    }

    .monto-financiado {
        color: var(--mud-palette-text-secondary);
    }

    .total-final {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 9px 12px;
        margin: 8px 0;
        border-radius: 6px;
        background: var(--mud-palette-primary);
        color: var(--mud-palette-primary-text);
    }

    .proyeccion-cuotas {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 9px 10px;
        border-radius: 6px;
        background: var(--mud-palette-info-hover);
    }


    /* ================================================================ */
    /* ACCIONES */
    /* ================================================================ */

    .acciones-dialogo {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 4px 0;
        width: 100%;
    }


    /* ================================================================ */
    /* MÓVILES (tablet) */
    /* ================================================================ */

    @@media (max-width: 959px) {

        .dialogo-adaptativo {
            width: 98vw;
            max-width: 98vw;
        }

        .seccion-credito {
            border-left: none;
            border-top: 1px solid var(--mud-palette-lines-inputs);
            padding-left: 12px !important;
            padding-top: 20px !important;
        }

    }


    /* ================================================================ */
    /* TELÉFONOS */
    /* ================================================================ */

    @@media (max-width: 600px) {

        .dialogo-adaptativo {
            /* 100vw desbordaba el área segura lateral del contenedor del diálogo
               (.mud-dialog-container ya aplica el padding de safe-area). Usamos
               el 100% del espacio disponible dentro de ese contenedor. */
            width: 100%;
            max-width: 100%;
            margin: 0;
        }

        .encabezado-venta {
            align-items: flex-start;
            gap: 8px;
        }

        .titulo-venta {
            white-space: normal;
            font-size: 1rem;
            line-height: 1.25;
        }

        .cliente-venta {
            display: none;
        }


        /* CAPTURA ARTÍCULO */
        .captura-articulo {
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .campo-producto {
            grid-column: 1 / -1;
        }

        .campo-cantidad {
            grid-column: 1;
        }

        .campo-precio {
            grid-column: 2;
        }

        .campo-agregar {
            grid-column: 1 / -1;
            justify-content: stretch;
        }

        .boton-agregar-articulo {
            width: 100%;
            margin-top: 0;
        }


        /* CAPTURA CONDICIÓN */
        .captura-condicion {
            grid-template-columns: 1fr 1fr;
        }

        .campo-plazo {
            grid-column: 1;
        }

        .campo-liquidacion {
            grid-column: 2;
        }

        .campo-agregar-condicion {
            grid-column: 1 / -1;
        }


        /* OCULTAR TABLA / MOSTRAR TARJETAS */
        .detalle-escritorio {
            display: none;
        }

        .detalle-movil {
            display: block;
            margin-top: 14px;
        }


        /* TARJETA */
        .detalle-card {
            padding: 10px 12px;
            margin-bottom: 10px;
            border-radius: 8px;
        }

        .detalle-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
        }

        .detalle-card-datos {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 8px;
            align-items: center;
        }

        .detalle-card-total {
