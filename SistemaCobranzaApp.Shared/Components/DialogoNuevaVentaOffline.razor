@code {

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public ClienteDto Cliente { get; set; } = default!;

    [Parameter]
    public string CodigoVenta { get; set; } = default!;

    [Parameter]
    public long IdVendedor { get; set; }

    [Parameter]
    public long IdZona { get; set; }

    [Parameter] public long? IdVentaVieja { get; set; }
    [Parameter] public string? CodigoVentaVieja { get; set; }
    [Parameter] public decimal? SaldoArrastre { get; set; }
    private bool ModoRenovacion => IdVentaVieja is > 0;
    private decimal CargoRenovacion => ModoRenovacion ? Math.Max(0, SaldoArrastre ?? 0m) : 0m;

    // Modo edición: cuando VentaExistente != null, el diálogo precarga sus datos
    // y el resultado se marca como edición de esa venta.
    [Parameter]
    public VentaDto? VentaExistente { get; set; }


    // ================================================================
    // CATÁLOGOS
    // ================================================================

    [Parameter] public JornadaDescargaDto? CatalogosJornada { get; set; }

    private List<ArticuloInventario> _catalogoInventario = new();
    private List<CatalogoFrecuenciaPagoDto> _catalogoFrecuencias = new();
    private List<MesDto> _catalogoMeses = new();
    // Tipo de venta (CRÉDITO / CONTADO). Determina el IdCondicion que se envía.
    private List<CondicionCreditoDto> _condiciones = new();
    private CondicionCreditoDto? _condicionSeleccionada;

    // Vendedor que realiza la venta (por defecto el asignado al cliente).
    private List<VendedorDto> _vendedores = new();
    private VendedorDto? _vendedorSeleccionado;


    // ================================================================
    // ESTADO DEL FORMULARIO (ARTÍCULOS)
    // ================================================================

    private List<DetalleVentaDto> _detallesCapturados = new();
    private ArticuloInventario? _productoSeleccionado;
    private int _cantidadCaptura = 1;
    private decimal _precioCaptura;

    // Tope de cantidad capturable según existencia disponible.
    private int _maxCantidadCaptura => _productoSeleccionado?.Disponible ?? 1;


    // ================================================================
    // ESTADO DEL FORMULARIO (CONDICIONES DE LIQUIDACIÓN)
    // ================================================================

    private List<CrearVentaPlanRequest> _planesCapturados = new();
    private MesDto? _mesSeleccionado;
    private decimal _montoLiquidacionCaptura;


    // ================================================================
    // CAMPOS FINANCIEROS
    // ================================================================

    private decimal _descuentoGlobal;
    private decimal _enganche;
    private CatalogoFrecuenciaPagoDto? _frecuenciaSeleccionada;
    private decimal _cuotaFijaExigida;


    // ================================================================
    // CÁLCULOS
    // ================================================================

    private decimal _subtotal =>
        _detallesCapturados.Sum(d => d.Cantidad * d.PrecioCobrado);

    private decimal TotalBase => Math.Max(0, _subtotal - _descuentoGlobal);
    private decimal FinanciadoBase => Math.Max(0, TotalBase - _enganche);
    private decimal _totalFinal => TotalBase + CargoRenovacion;
    private decimal CuotaRenovada => _cuotasProyectadas > 0
        ? Math.Round(_montoFinanciado / _cuotasProyectadas, 2, MidpointRounding.AwayFromZero) : 0;

    private decimal _montoFinanciado =>
        Math.Max(0, _totalFinal - _enganche);

    private int _cuotasProyectadas =>
        _cuotaFijaExigida > 0
            ? (int)Math.Ceiling((ModoRenovacion ? FinanciadoBase : _montoFinanciado) / _cuotaFijaExigida)
            : 0;

    private decimal _ultimaCuotaAjuste =>
        _cuotasProyectadas > 0
            ? _montoFinanciado - ((ModoRenovacion ? CuotaRenovada : _cuotaFijaExigida) * (_cuotasProyectadas - 1))
            : 0;


    // ================================================================
    // INICIALIZACIÓN
    // ================================================================

    protected override async Task OnInitializedAsync()
    {
        if (CatalogosJornada is { } jornada)
        {
            var productos = jornada.Productos.ToDictionary(p => p.Id);
            _catalogoInventario = jornada.Inventario.Where(e => e.Cantidad > 0 && productos.ContainsKey(e.IdProducto))
                .Select(e => new ArticuloInventario(e.IdProducto, e.Descripcion, e.Categoria ?? "—",
                    e.Cantidad, productos[e.IdProducto].PrecioSugerido)).OrderBy(a => a.Descripcion).ToList();
            _catalogoFrecuencias = jornada.Frecuencias;
            _frecuenciaSeleccionada = _catalogoFrecuencias.FirstOrDefault(f => f.Descripcion == "SEMANAL")
                ?? _catalogoFrecuencias.FirstOrDefault();
            _catalogoMeses = jornada.Meses.OrderBy(m => m.NumMeses).ToList();
            _condiciones = jornada.Condiciones;
            _condicionSeleccionada = _condiciones.FirstOrDefault(c => c.Descripcion.Contains("CRÉDITO", StringComparison.OrdinalIgnoreCase)
                || c.Descripcion.Contains("CREDITO", StringComparison.OrdinalIgnoreCase)) ?? _condiciones.FirstOrDefault();
            _vendedores = [new VendedorDto(IdVendedor, Api.Sesion?.NombreCompleto ?? "Vendedor", IdZona, null, null, null,true)];
            _vendedorSeleccionado = _vendedores[0];
            return;
        }
        throw new InvalidOperationException("Descarga los catálogos de la jornada antes de vender sin conexión.");
    }

    // Carga en el formulario los datos de una venta existente para editarla.
    // El inventario de la zona ya tiene descontadas las unidades de esta venta; por eso
    // sumamos de vuelta esas cantidades al "Disponible" de cada producto afectado,
    // reflejando que al editar el servidor repone primero el stock original.
    private void PrecargarVentaExistente(VentaDto v)
    {
        _descuentoGlobal = v.DescuentoGlobal;
        _enganche = v.Enganche;
        _cuotaFijaExigida = v.MontoCuotaFija;

        // Tipo de venta de la venta existente.
        _condicionSeleccionada = _condiciones.FirstOrDefault(c => c.IdCondicion == v.IdCondicion)
                                 ?? _condicionSeleccionada;

        if (v.IdFrecuenciaPago is { } idFrec)
            _frecuenciaSeleccionada = _catalogoFrecuencias.FirstOrDefault(f => f.Id == idFrec)
                                      ?? _frecuenciaSeleccionada;

        var detalles = v.Detalles ?? new();

        // Reponer al disponible las cantidades que esta venta ya tenía tomadas.
        foreach (var grupo in detalles.GroupBy(d => d.IdProducto))
        {
            var tomado = grupo.Sum(x => x.Cantidad);
            var idx = _catalogoInventario.FindIndex(a => a.IdProducto == grupo.Key);
            if (idx >= 0)
            {
                var art = _catalogoInventario[idx];
                _catalogoInventario[idx] = art with { Disponible = art.Disponible + tomado };
            }
            else
            {
                // El producto ya no está en el catálogo de la zona: lo agregamos con lo que tenía la venta.
                var primero = grupo.First();
                _catalogoInventario.Add(new ArticuloInventario(
                    IdProducto: grupo.Key,
                    Descripcion: primero.NombreProducto,
                    Categoria: "—",
                    Disponible: tomado,
                    PrecioSugerido: primero.PrecioCobrado));
            }
        }

        _catalogoInventario = _catalogoInventario.OrderBy(a => a.Descripcion).ToList();

        // Capturar los renglones de la venta.
        _detallesCapturados = detalles
            .Select(d => new DetalleVentaDto(
                d.IdDetalle, d.IdVenta, d.IdProducto, d.NombreProducto,
                d.Cantidad, d.PrecioCobrado, d.Importe))
            .ToList();

        // Capturar los planes promocionales.
        _planesCapturados = (v.PlanesPromocionales ?? new())
            .Select(p => new CrearVentaPlanRequest(p.NumeroMeses, p.MontoLiquidacion))
            .ToList();
    }


    // ================================================================
    // ARTÍCULOS
    // ================================================================

    // Cambia el tipo de venta (CRÉDITO / CONTADO).
    private void OnCondicionSeleccionada(CondicionCreditoDto? condicion)
    {
        _condicionSeleccionada = condicion;
    }

    private void OnVendedorSeleccionado(VendedorDto? vendedor)
    {
        _vendedorSeleccionado = vendedor;
    }

    // ---- Búsqueda para los autocompletados (artículo, plazo, vendedor) ----
    private Task<IEnumerable<ArticuloInventario>> BuscarArticulos(string? valor, CancellationToken ct)
    {
        IEnumerable<ArticuloInventario> origen = _catalogoInventario;
        if (!string.IsNullOrWhiteSpace(valor))
            origen = origen.Where(a =>
                a.Descripcion.Contains(valor, StringComparison.OrdinalIgnoreCase)
                || (a.Categoria ?? string.Empty).Contains(valor, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(origen);
    }

    private Task<IEnumerable<MesDto>> BuscarPlazos(string? valor, CancellationToken ct)
    {
        IEnumerable<MesDto> origen = _catalogoMeses;
        if (!string.IsNullOrWhiteSpace(valor))
            origen = origen.Where(m =>
                $"{m.NumMeses}{m.Descripcion}".Contains(valor, StringComparison.OrdinalIgnoreCase)
                || (m.Descripcion ?? string.Empty).Contains(valor, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(origen);
    }

    private Task<IEnumerable<VendedorDto>> BuscarVendedores(string? valor, CancellationToken ct)
    {
        IEnumerable<VendedorDto> origen = _vendedores;
        if (!string.IsNullOrWhiteSpace(valor))
            origen = origen.Where(v => (v.Nombre ?? string.Empty).Contains(valor, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(origen);
    }

    private void OnProductoSeleccionado(ArticuloInventario? articulo)
    {
        _productoSeleccionado = articulo;
        if (articulo is null) return;

        _precioCaptura = articulo.PrecioSugerido;
        if (_cantidadCaptura < 1) _cantidadCaptura = 1;
        if (_cantidadCaptura > articulo.Disponible) _cantidadCaptura = articulo.Disponible;
    }

    private void AgregarArticulo()
    {
        if (_productoSeleccionado is null) return;

        if (_precioCaptura <= 0)
        {
            _snackbar.Add("El precio cobrado debe ser mayor a cero.", Severity.Warning);
            return;
        }

        if (_cantidadCaptura < 1)
        {
            _snackbar.Add("La cantidad debe ser al menos 1.", Severity.Warning);
            return;
        }

        // Validar existencia acumulada contra lo disponible en la zona.
        var yaCapturada = _detallesCapturados
            .Where(d => d.IdProducto == _productoSeleccionado.IdProducto)
            .Sum(d => d.Cantidad);

        if (yaCapturada + _cantidadCaptura > _productoSeleccionado.Disponible)
        {
            _snackbar.Add(
                $"No hay existencia suficiente en la zona. " +
                $"Disponible: {_productoSeleccionado.Disponible}, ya en la venta: {yaCapturada}.",
                Severity.Warning);
            return;
        }

        _detallesCapturados.Add(new DetalleVentaDto(
            IdDetalle: 0,
            IdVenta: 0,
            IdProducto: _productoSeleccionado.IdProducto,
            NombreProducto: _productoSeleccionado.Descripcion,
            Cantidad: _cantidadCaptura,
            PrecioCobrado: _precioCaptura,
            Importe: _cantidadCaptura * _precioCaptura));

        // Limpiar captura.
        _productoSeleccionado = null;
        _cantidadCaptura = 1;
        _precioCaptura = 0;
    }

    private void EliminarArticulo(DetalleVentaDto detalle)
    {
        _detallesCapturados.Remove(detalle);
    }


    // ================================================================
    // CONDICIONES DE LIQUIDACIÓN (PLANES PROMOCIONALES)
    // ================================================================

    private void AgregarCondicion()
    {
        if (_mesSeleccionado is null)
        {
            _snackbar.Add("Seleccione un plazo del catálogo.", Severity.Warning);
            return;
        }

        if (_montoLiquidacionCaptura <= 0)
        {
            _snackbar.Add("El monto de liquidación debe ser mayor a cero.", Severity.Warning);
            return;
        }

        // No permitir dos condiciones con el mismo plazo.
        if (_planesCapturados.Any(p => p.NumeroMeses == _mesSeleccionado.NumMeses))
        {
            _snackbar.Add($"Ya existe una condición para el plazo '{_mesSeleccionado.Descripcion}'.", Severity.Warning);
            return;
        }

        _planesCapturados.Add(new CrearVentaPlanRequest(
            NumeroMeses: _mesSeleccionado.NumMeses,
            MontoLiquidacion: _montoLiquidacionCaptura));

        _planesCapturados = _planesCapturados.OrderBy(p => p.NumeroMeses).ToList();

        // Limpiar captura.
        _mesSeleccionado = null;
        _montoLiquidacionCaptura = 0;
    }

    private void EliminarCondicion(CrearVentaPlanRequest plan)
    {
        _planesCapturados.Remove(plan);
    }


    // ================================================================
    // PROCESAR VENTA
    // ================================================================

    private void ProcesarEstructuraVenta()
    {
        if (!_detallesCapturados.Any()) return;
        if (ModoRenovacion && (CargoRenovacion <= 0 || VentaExistente is not null))
        {
            _snackbar.Add("La renovación requiere una cuenta con saldo pendiente.", Severity.Warning);
            return;
        }
        if (_descuentoGlobal < 0 || _descuentoGlobal > _subtotal || _enganche < 0 || _enganche > TotalBase)
        {
            _snackbar.Add("Revisa el descuento y el enganche de los productos nuevos.", Severity.Warning);
            return;
        }
        if (ModoRenovacion && (FinanciadoBase <= 0 || _cuotaFijaExigida > FinanciadoBase))
        {
            _snackbar.Add("La renovación necesita financiar los productos nuevos; la cuota base no puede superar ese importe.", Severity.Warning);
            return;
        }


        if (_montoFinanciado > 0 && _frecuenciaSeleccionada is null)
        {
            _snackbar.Add("Debe seleccionar una frecuencia de pago para ventas a crédito.", Severity.Warning);
            return;
        }

        if (_montoFinanciado > 0 && _cuotaFijaExigida <= 0)
        {
            _snackbar.Add("Debe fijar la cuota que el cliente entregará periódicamente.", Severity.Warning);
            return;
        }

        if (_vendedorSeleccionado is null)
        {
            _snackbar.Add("Debe seleccionar el vendedor que realiza la venta.", Severity.Warning);
            return;
        }

        var request = new CrearVentaRequest(
            IdCliente: Cliente.IdCliente,
            IdVendedor: _vendedorSeleccionado.IdVendedor,
            CodigoVenta: CodigoVenta,
            // Tipo de venta elegido por el usuario (CRÉDITO / CONTADO). Fallback a crédito (1) si no hay selección.
            IdCondicion: _condicionSeleccionada?.IdCondicion ?? 1,
            Subtotal: _subtotal,
            DescuentoGlobal: _descuentoGlobal,
            // El procedimiento de renovación agrega el arrastre una sola vez en el servidor.
            TotalFinal: TotalBase,
            Enganche: _enganche,
            IdFrecuenciaPago: _montoFinanciado > 0 ? _frecuenciaSeleccionada?.Id : null,
            NumeroCuotas: _montoFinanciado > 0 ? _cuotasProyectadas : 1,
            MontoCuotaFija: _montoFinanciado > 0 ? _cuotaFijaExigida : 0.00m,
            TasaInteres: 0.00m,
            FechaPrimerVence: _montoFinanciado > 0
                ? DateTimeOffset.UtcNow.AddDays(_frecuenciaSeleccionada!.DiasPeriodo)
                : null,
            Observaciones: null,
            Detalles: _detallesCapturados
                .Select(d => new CrearDetalleVentaRequest(d.IdProducto, d.Cantidad, d.PrecioCobrado))
                .ToList(),
            // Condiciones de liquidación negociadas (null cuando no se capturó ninguna).
            PlanesPromocionales: _planesCapturados.Any() ? _planesCapturados.ToList() : null);

        var resultado = new ResultadoDialogoVenta(
            Request: request,
            EsEdicion: VentaExistente is not null,
            IdVenta: VentaExistente?.IdVenta ?? 0);

        MudDialog.Close(DialogResult.Ok(resultado));
    }

    private void Cancelar()
    {
        MudDialog.Cancel();
    }


    // ================================================================
    // MODELO LOCAL
    // ================================================================

    private sealed record ArticuloInventario(
        long IdProducto,
        string Descripcion,
        string Categoria,
        int Disponible,
        decimal PrecioSugerido);
}
