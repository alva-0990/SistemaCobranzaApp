@using MudBlazor

@* Modal informativo de riesgo del cliente según su clasificación.
   Se usa al abrir el detalle del cliente:
   - Precaución (REGULAR): ícono/colores en amarillo.
   - Bloqueado (MALO/MOROSO): ícono/colores en rojo.
   Es solo informativo: un único botón "Entendido" que cierra el modal. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight: 600;">
            <MudIcon Icon="@Icono" Class="mr-2" Style="vertical-align: middle;" Color="@ColorIcono" />
            @Titulo
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudText Typo="Typo.body1" Style="white-space: pre-line;">@Mensaje</MudText>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cerrar" Variant="Variant.Filled" Color="@ColorIcono">
            Entendido
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string Titulo { get; set; } = "Advertencia";
    [Parameter] public string Mensaje { get; set; } = "";

    /// <summary>Cuando es true, se usa la presentación roja (bloqueo); si no, amarilla (precaución).</summary>
    [Parameter] public bool Bloqueado { get; set; }

    private string Icono => Bloqueado ? Icons.Material.Filled.Block : Icons.Material.Filled.WarningAmber;
    private Color ColorIcono => Bloqueado ? Color.Error : Color.Warning;

    private void Cerrar() => MudDialog.Close(DialogResult.Ok(true));
}
