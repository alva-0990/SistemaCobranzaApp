@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">@Etiqueta</MudText>
        <MudTextField T="string" @bind-Value="Valor" Variant="Variant.Outlined"
                      Immediate="true" AutoFocus="true" Lines="@Lineas" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Aceptar">Aceptar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Titulo { get; set; } = "";
    [Parameter] public string Etiqueta { get; set; } = "";
    [Parameter] public string Valor { get; set; } = "";
    [Parameter] public int Lineas { get; set; } = 1;

    private void Aceptar() => MudDialog.Close(DialogResult.Ok(Valor));
    private void Cancelar() => MudDialog.Cancel();
}
