@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6"><b>@(EsEdicion ? "Editar categoría" : "Nueva categoría de gasto")</b></MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField T="string" @bind-Value="Nombre" Label="Nombre" Variant="Variant.Outlined"
                      Immediate="true" MaxLength="100" Class="mb-3" />

        <MudTextField T="string" @bind-Value="Descripcion" Label="Descripción (opcional)"
                      Variant="Variant.Outlined" Lines="2" MaxLength="250" Class="mb-3" />

        <MudSwitch T="bool" @bind-Value="RequiereComprobante" Color="Color.Primary"
                   Label="Requiere comprobante" Class="mb-2" />

        @if (EsEdicion)
        {
            <MudSwitch T="bool" @bind-Value="Activo" Color="Color.Primary" Label="Activa" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Aceptar">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public bool EsEdicion { get; set; }
    [Parameter] public string Nombre { get; set; } = "";
    [Parameter] public string? Descripcion { get; set; }
    [Parameter] public bool RequiereComprobante { get; set; }
    [Parameter] public bool Activo { get; set; } = true;

    public record Resultado(string Nombre, string? Descripcion, bool RequiereComprobante, bool Activo);

    private void Aceptar()
    {
        if (string.IsNullOrWhiteSpace(Nombre)) return;
        MudDialog.Close(DialogResult.Ok(new Resultado(
            Nombre.Trim(),
            string.IsNullOrWhiteSpace(Descripcion) ? null : Descripcion!.Trim(),
            RequiereComprobante,
            Activo)));
    }

    private void Cancelar() => MudDialog.Cancel();
}
