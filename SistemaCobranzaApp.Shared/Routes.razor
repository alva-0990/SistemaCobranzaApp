@using SistemaCobranzaApp.Shared.Services
@inject ApiCliente Api
@inject NavigationManager Navigation

<Router AppAssembly="@typeof(Routes).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)" />
        <!-- CORREGIDO: Se agregó el parámetro obligatorio RouteData -->
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(Layout.MainLayout)">
            <p role="alert">Lo sentimos, no hay nada en esta dirección.</p>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private bool _inicializado;

    protected override async Task OnInitializedAsync()
    {
        // 1. Intentamos cargar el token guardado (ya sea de Android o Web)
        await Api.CargarSesionDesdeAlmacenamientoAsync();

        _inicializado = true;

        // 2. Si no está autenticado y no está ya en la página de login, redirigir
        var urlActual = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (!Api.Autenticado && !urlActual.StartsWith("login", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/login");
        }
    }
}