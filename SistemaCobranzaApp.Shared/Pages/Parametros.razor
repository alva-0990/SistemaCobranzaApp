@page "/parametros"

@using MudBlazor
@using SistemaCobranzaApp.Shared.Dtos
@using SistemaCobranzaApp.Shared.Components
@using SistemaCobranzaApp.Shared.Utilerias

<MudTabs Elevation="2" Rounded="true" Color="Color.Primary" ApplyEffectsToContainer="true"
         PanelClass="pa-0" SliderColor="Color.Warning" Class="ma-2 tabs-remarcados">
    <MudTabPanel Text="Parámetros" Icon="@Icons.Material.Filled.Tune">
    <MudPaper Elevation="0" Class="pa-4">
    <div class="barra-acciones" style="margin-top:16px;">
        <CampoFiltrado Modo="ModoCampo.AlfanumericoGuiones"
                       @bind-Value="Busqueda"
                       Immediate="true"
                       Placeholder="Buscar parámetro por clave, descripción o valor..."
                       Variant="Variant.Outlined"
                       Adornment="Adornment.Start"
                       AdornmentIcon="@Icons.Material.Filled.Search"
                       AdornmentColor="Color.Primary"
                       Clearable="true"
                      Class="buscador-remarcado" />
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AbrirNuevo"
                   Class="boton-nuevo">
            Nuevo parámetro
        </MudButton>
    </div>
    </MudPaper>
    </MudTabPanel>
</MudTabs>

<MudPaper Elevation="2" Rounded="true" Class="ma-2 pa-4">
    @if (Cargando)
    {
        <div class="d-flex justify-center pa-8">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </div>
    }
    else
    {
        <MudTable Items="Filtrados" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm"
                  Elevation="0" RowsPerPage="15" T="ParametroSistemaDto">
            <HeaderContent>
                <MudTh>Clave</MudTh>
                <MudTh>Descripción</MudTh>
                <MudTh Style="width:14%; text-align:right;">Valor numérico</MudTh>
                <MudTh Style="width:14%;">Valor texto</MudTh>
                <MudTh Style="width:14%;">Modificado</MudTh>
                <MudTh Style="width:12%; text-align:right;">Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Clave"><b>@context.Clave</b></MudTd>
                <MudTd DataLabel="Descripción">
                    <MudTooltip Text="@context.Descripcion">
                        <span class="valor-texto-truncado">@context.Descripcion</span>
                    </MudTooltip>
                </MudTd>
                <MudTd DataLabel="Valor numérico" Style="text-align:right;">
                    @(context.ValorNumerico is null ? "—" : context.ValorNumerico.Value.ToString("0.####"))
                </MudTd>
                <MudTd DataLabel="Valor texto">
                    @if (string.IsNullOrWhiteSpace(context.ValorTexto))
                    {
                        <text>—</text>
                    }
                    else
                    {
                        <MudTooltip Text="@context.ValorTexto">
                            <span class="valor-texto-truncado">@context.ValorTexto</span>
                        </MudTooltip>
                    }
                </MudTd>
                <MudTd DataLabel="Modificado">@context.FechaModificacion.EnZonaProyecto().DateTime.ToString("dd/MM/yyyy HH:mm")</MudTd>
                <MudTd DataLabel="Acciones" Style="text-align:right;">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Primary"
                                   Title="Vista previa" OnClick="@(() => AbrirVistaPrevia(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Info"
                                   Title="Editar" OnClick="@(() => AbrirEditar(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   Title="Eliminar" OnClick="@(() => Eliminar(context))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="pa-8 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Large" Color="Color.Secondary" />
                    <MudText Color="Color.Secondary" Class="mt-2">No hay parámetros que coincidan.</MudText>
                </div>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Filas:" />
            </PagerContent>
        </MudTable>
    }
</MudPaper>

<style>
    .tabs-remarcados .mud-tab { opacity: 0.65; font-weight: 500; transition: opacity 0.15s ease, background-color 0.15s ease; }
    .tabs-remarcados .mud-tab.mud-tab-active { opacity: 1; font-weight: 800; background-color: rgba(255,255,255,0.18); border-radius: 8px 8px 0 0; }
    .tabs-remarcados .mud-tab-slider { height: 4px; }

    .barra-acciones {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
    }

    .barra-acciones .buscador-remarcado { flex: 1 1 auto; min-width: 0; }
    .boton-nuevo { white-space: nowrap; flex: 0 0 auto; }
    .buscador-remarcado .mud-input-outlined-border { border-width: 2px; }

    /* En pantallas chicas: apilar en columna y colocar el botón "Nuevo parámetro" debajo del buscador */
    @@media (max-width: 599.98px) {
        .barra-acciones {
            flex-direction: column;
            align-items: stretch;
        }

        .barra-acciones .boton-nuevo {
            width: 100%;
        }
    }

    /* Valor texto: truncado con ellipsis para que la tabla no se expanda. */
    .valor-texto-truncado {
        display: inline-block;
        max-width: 180px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        vertical-align: middle;
    }
</style>
