                                <div class="d-flex justify-center pa-8">
                                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                                </div>
                            }
                            else
                            {
                                <MudTable Items="_historial" Hover="true" Dense="true"
                                          Breakpoint="Breakpoint.Sm" Elevation="0" RowsPerPage="25"
                                          T="MovimientoHistorialDto" Height="56vh" FixedHeader="true">
                                    <HeaderContent>
                                        <MudTh>Fecha</MudTh>
                                        <MudTh>Tipo</MudTh>
                                        <MudTh Style="width:12%;">Clave</MudTh>
                                        <MudTh>Producto</MudTh>
                                        <MudTh Style="width:8%; text-align:right;">Cant.</MudTh>
                                        <MudTh Style="width:8%; text-align:right;">Antes</MudTh>
                                        <MudTh Style="width:8%; text-align:right;">Después</MudTh>
                                        <MudTh>Zona</MudTh>
                                        <MudTh>Usuario</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Fecha">@context.FechaMovimiento.EnZonaProyecto().DateTime.ToString("dd/MM/yyyy HH:mm")</MudTd>
                                        <MudTd DataLabel="Tipo">@ChipTipoMovimiento(context.TipoMovimiento)</MudTd>
                                        <MudTd DataLabel="Clave"><b>@context.CodigoClave</b></MudTd>
                                        <MudTd DataLabel="Producto">
                                            <div>@context.Descripcion</div>
                                            @MetaProducto(context.Marca, context.Categoria, null, null)
                                        </MudTd>
                                        <MudTd DataLabel="Cant." Style="text-align:right;">@context.Cantidad</MudTd>
                                        <MudTd DataLabel="Antes" Style="text-align:right;">@context.ExistenciaAnterior</MudTd>
                                        <MudTd DataLabel="Después" Style="text-align:right;"><b>@context.ExistenciaNueva</b></MudTd>
                                        <MudTd DataLabel="Zona">@(context.Zona ?? "—")</MudTd>
                                        <MudTd DataLabel="Usuario">@(context.Usuario ?? "—")</MudTd>
                                    </RowTemplate>
                                    <NoRecordsContent>@EstadoVacio("No hay movimientos con los filtros seleccionados.")</NoRecordsContent>
                                    <PagerContent>
                                        <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}"
                                                       RowsPerPageString="Filas:"
                                                       PageSizeOptions="new[] { 25, 50, 100 }" />
                                    </PagerContent>
                                </MudTable>
                            }
                        </MudTabPanel>
                    </MudTabs>
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@{
    RenderFragment ChipStock(int cantidad, int minimo) => __builder =>
    {
        var bajo = cantidad <= minimo;
        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                 Color="@(bajo ? Color.Error : Color.Success)">
            @(bajo ? "Bajo mínimo" : "Disponible")
        </MudChip>
    };

    RenderFragment ChipEstatus(string estatus) => __builder =>
    {
        var color = estatus?.ToUpperInvariant() switch
        {
            "CONFIRMADA" => Color.Success,
            "RECHAZADA" => Color.Error,
            "PENDIENTE" => Color.Warning,
            _ => Color.Default
        };
        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@color">
            @(string.IsNullOrWhiteSpace(estatus) ? "—" : estatus)
        </MudChip>
    };

    RenderFragment EstadoVacio(string mensaje) => __builder =>
    {
        <div class="pa-8 text-center">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary" />
            <MudText Color="Color.Secondary" Class="mt-2">@mensaje</MudText>
        </div>
    };

    // Chip de color por tipo de movimiento del historial de inventario.
    RenderFragment ChipTipoMovimiento(string tipo) => __builder =>
    {
        var (color, etiqueta) = tipo switch
        {
            "ENTRADA_CENTRAL" => (Color.Success, "Entrada central"),
            "AJUSTE_CENTRAL" => (Color.Warning, "Ajuste central"),
            "SALIDA_ZONA" => (Color.Info, "Salida a zona"),
            "ENTRADA_ZONA" => (Color.Primary, "Entrada a zona"),
            "AJUSTE_ZONA" => (Color.Warning, "Ajuste zona"),
            "VENTA" => (Color.Error, "Venta"),
            _ => (Color.Default, tipo)
        };
        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@color">@etiqueta</MudChip>
    };

    // Línea secundaria con la clasificación del producto (marca · categoría · color · talla).
    RenderFragment MetaProducto(string? marca, string? categoria, string? color, string? talla) => __builder =>
    {
        var partes = new[] { marca, categoria, color, talla }
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .ToArray();
        if (partes.Length == 0) return;
        <div class="meta-producto">@string.Join(" · ", partes)</div>
    };
}

<style>
    .barra-acciones {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .barra-acciones .buscador-remarcado { flex: 1 1 260px; min-width: 0; }
    .boton-nuevo { white-space: nowrap; flex: 0 0 auto; }
    .buscador-remarcado .mud-input-outlined-border { border-width: 2px; }

    /* ===== Filtros del historial de inventario: compactos para que quepan en una línea ===== */
    .barra-filtros-hist {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    /* Selectores (Tipo / Zona) toman el espacio sobrante pero sin crecer de más. */
    .barra-filtros-hist .filtro-hist { flex: 1 1 130px; min-width: 110px; max-width: 200px; }
    /* Las fechas son más angostas que los selectores. */
    .barra-filtros-hist .filtro-hist-fecha { flex: 0 1 150px; min-width: 120px; max-width: 170px; }
    /* Botones sin que el texto se parta y sin crecer. */
    .barra-filtros-hist .boton-hist { white-space: nowrap; flex: 0 0 auto; }

    /* ===== Filtros de propuestas: todos en una sola fila; se apilan en pantallas pequeñas ===== */
    .barra-filtros-prop {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .barra-filtros-prop .filtro-prop { flex: 1 1 140px; min-width: 120px; max-width: 220px; }
    .barra-filtros-prop .filtro-prop-fecha { flex: 0 1 150px; min-width: 120px; max-width: 170px; }
    .barra-filtros-prop .boton-prop { white-space: nowrap; flex: 0 0 auto; }

    /* En pantallas pequeñas cada filtro/botón ocupa su propia fila (uno debajo del otro). */
    @@media (max-width: 600px) {
        .barra-filtros-prop { flex-direction: column; align-items: stretch; }
        .barra-filtros-prop .filtro-prop,
        .barra-filtros-prop .filtro-prop-fecha,
        .barra-filtros-prop .boton-prop { max-width: none; width: 100%; }
    }

    .encabezado-seccion { display: flex; align-items: center; gap: 12px; }
    .titulo-seccion { font-weight: 800; }

    .panel-accion { position: sticky; top: 16px; }

    /* Línea secundaria (marca · categoría · color · talla) bajo la descripción del producto. */
    .meta-producto {
        font-size: 0.72rem;
        color: var(--mud-palette-text-secondary);
        margin-top: 2px;
        line-height: 1.1;
    }

    .tabs-remarcados .mud-tab { opacity: 0.65; font-weight: 500; transition: opacity 0.15s ease, background-color 0.15s ease; }
    .tabs-remarcados .mud-tab.mud-tab-active { opacity: 1; font-weight: 800; background-color: rgba(255,255,255,0.18); border-radius: 8px 8px 0 0; }
    .tabs-remarcados .mud-tab-slider { height: 4px; }

    /* Resalta la fila seleccionada en las tablas de existencias. */
    .fila-seleccionada { background-color: var(--mud-palette-primary-hover) !important; }
</style>

@code {
    // ===================== INVENTARIO CENTRAL =====================
    private List<ExistenciaCentralDto> _central = new();
    private bool _cargandoCentral;
    private string _busquedaCentral = "";
    private ExistenciaCentralDto? _centralSeleccion;
    private bool _centralEsAjuste;
    private int _centralCantidad;
    private string _centralObservaciones = "";
    private bool _guardandoCentral;

    private IEnumerable<ExistenciaCentralDto> CentralFiltrado => FiltrarCentral(_central, _busquedaCentral);

    // ===================== EXISTENCIAS POR ZONA =====================
    private List<ZonaDto> _zonas = new();
    private long? _zonaSeleccionada;
    private List<ExistenciaZonaDto> _existenciasZona = new();
    private bool _cargandoZona;
    private string _busquedaZona = "";
    private ExistenciaZonaDto? _zonaSeleccion;
    private int _zonaCantidad;
    private string _zonaObservaciones = "";
    private bool _guardandoZona;

    private IEnumerable<ExistenciaZonaDto> ZonaFiltrado
    {
        get
        {
            var q = _busquedaZona?.Trim() ?? "";
            if (string.IsNullOrEmpty(q)) return _existenciasZona;
            return _existenciasZona.Where(x =>
                (x.CodigoClave ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
                || (x.Descripcion ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
                || x.IdProducto.ToString().Contains(q, StringComparison.OrdinalIgnoreCase));
        }
    }

    // ===================== ENVÍO A ZONAS (PROPUESTAS) =====================
    private long? _propZonaDestino;
    private string _propObservaciones = "";
    private ExistenciaCentralDto? _propProductoSel;
    private int _propCantidad = 1;
    private readonly List<ArticuloPropuesta> _articulosPropuesta = new();
    private bool _guardandoPropuesta;

    private List<PropuestaDto> _propuestas = new();
    private bool _cargandoPropuestas;
    private string? _filtroEstatus;
    private long? _propFiltroZona;
    private DateTime? _propFiltroDesde;
    private DateTime? _propFiltroHasta;
    private PropuestaDto? _propuestaDetalle;
    private bool _cargandoDetalle;
    private bool _resolviendoPropuesta;

    // Indicador compartido mientras se genera/descarga un archivo de Excel.
    private bool _exportando;

    // Propuestas filtradas en memoria por zona y rango de fechas (el estatus se filtra en el servidor).
    private IEnumerable<PropuestaDto> PropuestasFiltradas
    {
        get
        {
            IEnumerable<PropuestaDto> q = _propuestas;
            if (_propFiltroZona is { } zona)
                q = q.Where(p => p.IdZonaDestino == zona);
            if (_propFiltroDesde is { } desde)
                q = q.Where(p => p.FechaCreacion.EnZonaProyecto().Date >= desde.Date);
            if (_propFiltroHasta is { } hasta)
                q = q.Where(p => p.FechaCreacion.EnZonaProyecto().Date <= hasta.Date);
            return q;
        }
    }

    // Historial de inventario (vista global con filtros).
    private List<MovimientoHistorialDto> _historial = new();
    private bool _cargandoHistorial;
    private string? _histTipo;
    private long? _histZona;
    private DateTime? _histDesde;
    private DateTime? _histHasta;

    // Catálogo de tipos de movimiento para el filtro (clave backend -> etiqueta UI).
    private static readonly Dictionary<string, string> _tiposMovimiento = new()
    {
        ["ENTRADA_CENTRAL"] = "Entradas a central",
        ["AJUSTE_CENTRAL"] = "Ajustes de central",
        ["SALIDA_ZONA"] = "Salidas a zona",
        ["ENTRADA_ZONA"] = "Entradas a zona",
        ["AJUSTE_ZONA"] = "Ajustes de zona",
        ["VENTA"] = "Solo ventas"
    };

    // Línea de la propuesta en construcción (en memoria).
    private sealed class ArticuloPropuesta
    {
        public long IdProducto { get; init; }
        public string CodigoClave { get; init; } = "";
        public string Descripcion { get; init; } = "";
        public int Cantidad { get; set; }
        public int ExistenciaCentral { get; init; }
        public string? Marca { get; init; }
        public string? Categoria { get; init; }
        public string? Color { get; init; }
        public string? Talla { get; init; }
    }

    private long? IdUsuarioActual => Api.Sesion?.IdUsuario;

    protected override async Task OnInitializedAsync()
    {
        await CargarCentral();
        await CargarZonas();
        await CargarPropuestas();
        await CargarHistorial();
    }

    // ===================== Carga de datos =====================

    private async Task CargarCentral()
    {
        _cargandoCentral = true;
        var (datos, error) = await Api.ObtenerExistenciasCentralAsync();
        if (error is not null) _snackbar.Add(error, Severity.Error);
        _central = datos ?? new();
        _cargandoCentral = false;
    }

    private async Task CargarZonas()
    {
        var (datos, error) = await Api.ListarZonasOperativasAsync();
        if (error is not null) _snackbar.Add(error, Severity.Error);
        _zonas = datos ?? new();
    }

    private async Task CargarExistenciasZona()
    {
        if (_zonaSeleccionada is null) return;
        _cargandoZona = true;
        LimpiarSeleccionZona();
        var (datos, error) = await Api.ObtenerExistenciasZonaAsync(_zonaSeleccionada.Value);
        if (error is not null) _snackbar.Add(error, Severity.Error);
        _existenciasZona = datos ?? new();
        _cargandoZona = false;
    }

    // Al cambiar la zona en el selector, carga automáticamente sus existencias.
    private async Task OnZonaSeleccionadaChanged(long? idZona)
    {
        _zonaSeleccionada = idZona;
        if (idZona is null)
        {
            _existenciasZona = new();
            LimpiarSeleccionZona();
            return;
        }
        await CargarExistenciasZona();
    }

    private async Task CargarPropuestas()
    {
        _cargandoPropuestas = true;
        var (datos, error) = await Api.ListarPropuestasAsync(
            estatus: string.IsNullOrWhiteSpace(_filtroEstatus) ? null : _filtroEstatus,
            idZona: null);
        if (error is not null) _snackbar.Add(error, Severity.Error);
        _propuestas = datos ?? new();
        _cargandoPropuestas = false;
    }

    private async Task LimpiarFiltrosPropuestas()
    {
        _filtroEstatus = null;
        _propFiltroZona = null;
        _propFiltroDesde = null;
        _propFiltroHasta = null;
        await CargarPropuestas();
    }

    private async Task CargarHistorial()
    {
        _cargandoHistorial = true;
        var tipos = string.IsNullOrWhiteSpace(_histTipo) ? null : new[] { _histTipo! };
        DateTimeOffset? desde = _histDesde.HasValue ? FechaProyecto.DesdeFechaLocal(_histDesde.Value.Date) : null;
        DateTimeOffset? hasta = _histHasta.HasValue ? FechaProyecto.DesdeFechaLocal(_histHasta.Value.Date) : null;
        var (datos, error) = await Api.ObtenerHistorialGlobalAsync(tipos, _histZona, desde, hasta, max: 500);
        if (error is not null) _snackbar.Add(error, Severity.Error);
        _historial = datos ?? new();
        _cargandoHistorial = false;
    }

    private async Task LimpiarFiltrosHistorial()
    {
        _histTipo = null;
        _histZona = null;
        _histDesde = null;
        _histHasta = null;
        await CargarHistorial();
    }

    // ===================== Inventario Central: acciones =====================

    private void SeleccionarCentral(ExistenciaCentralDto? item)
    {
        if (item is null) return;
        _centralSeleccion = item;
        _centralCantidad = 0;
        _centralObservaciones = "";
        _centralEsAjuste = false;
    }

    private void LimpiarSeleccionCentral()
    {
        _centralSeleccion = null;
        _centralCantidad = 0;
        _centralObservaciones = "";
        _centralEsAjuste = false;
    }

    private async Task AplicarMovimientoCentral()
    {
        if (_centralSeleccion is null) return;
        if (!_centralEsAjuste && _centralCantidad <= 0)
        {
            _snackbar.Add("La cantidad a ingresar debe ser mayor a cero.", Severity.Warning);
            return;
        }

        _guardandoCentral = true;
        var req = new MovimientoCentralRequest(
            _centralSeleccion.IdProducto, _centralCantidad, _centralEsAjuste,
            string.IsNullOrWhiteSpace(_centralObservaciones) ? null : _centralObservaciones.Trim(),
            IdUsuarioActual);

        var (_, error) = await Api.RegistrarMovimientoCentralAsync(req);
        _guardandoCentral = false;

        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        _snackbar.Add($"Movimiento aplicado a '{_centralSeleccion.CodigoClave}'.", Severity.Success);
        LimpiarSeleccionCentral();
        await CargarCentral();
    }

    private string FilaCentralClass(ExistenciaCentralDto item, int _)
        => _centralSeleccion is not null && _centralSeleccion.IdProducto == item.IdProducto ? "fila-seleccionada" : "";

    // ===================== Existencias por Zona: acciones =====================

    private void SeleccionarZona(ExistenciaZonaDto? item)
    {
        if (item is null) return;
        _zonaSeleccion = item;
        _zonaCantidad = item.Cantidad;
        _zonaObservaciones = "";
    }

    private void LimpiarSeleccionZona()
    {
        _zonaSeleccion = null;
        _zonaCantidad = 0;
        _zonaObservaciones = "";
    }

    private async Task AplicarAjusteZona()
    {
        if (_zonaSeleccion is null || _zonaSeleccionada is null) return;

        _guardandoZona = true;
        // El ajuste de zona fija la cantidad exacta (EsAjuste = true).
        var req = new MovimientoZonaRequest(
            _zonaSeleccionada.Value, _zonaSeleccion.IdProducto, _zonaCantidad, true,
            string.IsNullOrWhiteSpace(_zonaObservaciones) ? null : _zonaObservaciones.Trim(),
            IdUsuarioActual);

        var (_, error) = await Api.RegistrarMovimientoZonaAsync(req);
        _guardandoZona = false;

        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        _snackbar.Add($"Existencia de '{_zonaSeleccion.CodigoClave}' ajustada.", Severity.Success);
        await CargarExistenciasZona();
    }

    private string FilaZonaClass(ExistenciaZonaDto item, int _)
        => _zonaSeleccion is not null && _zonaSeleccion.IdProducto == item.IdProducto ? "fila-seleccionada" : "";

    // ===================== Envío a Zonas: acciones =====================

    private Task<IEnumerable<ExistenciaCentralDto>> BuscarProductoCentral(string? valor, CancellationToken ct)
    {
        IEnumerable<ExistenciaCentralDto> resultado = string.IsNullOrWhiteSpace(valor)
            ? _central.Take(50)
            : FiltrarCentral(_central, valor).Take(50);
        return Task.FromResult(resultado);
    }

    private void AgregarArticuloPropuesta()
    {
        if (_propProductoSel is null) return;
        if (_propCantidad <= 0)
        {
            _snackbar.Add("La cantidad a enviar debe ser mayor a cero.", Severity.Warning);
            return;
        }

        var existente = _articulosPropuesta.FirstOrDefault(a => a.IdProducto == _propProductoSel.IdProducto);
        if (existente is not null)
        {
            existente.Cantidad += _propCantidad;
        }
        else
        {
            _articulosPropuesta.Add(new ArticuloPropuesta
            {
                IdProducto = _propProductoSel.IdProducto,
                CodigoClave = _propProductoSel.CodigoClave,
                Descripcion = _propProductoSel.Descripcion,
                Cantidad = _propCantidad,
                ExistenciaCentral = _propProductoSel.Cantidad,
                Marca = _propProductoSel.Marca,
                Categoria = _propProductoSel.Categoria,
                Color = _propProductoSel.Color,
                Talla = _propProductoSel.Talla
            });
        }

        _propProductoSel = null;
        _propCantidad = 1;
    }

    private void QuitarArticulo(ArticuloPropuesta a) => _articulosPropuesta.Remove(a);

    private void LimpiarPropuesta()
    {
        _articulosPropuesta.Clear();
        _propObservaciones = "";
        _propProductoSel = null;
        _propCantidad = 1;
    }

    private async Task GuardarPropuesta()
    {
        if (_articulosPropuesta.Count == 0 || _propZonaDestino is null) return;

        _guardandoPropuesta = true;
        var detalles = _articulosPropuesta
            .Select(a => new CrearPropuestaDetalleRequest(a.IdProducto, a.Cantidad))
            .ToList();
        var req = new CrearPropuestaRequest(_propZonaDestino.Value,
            string.IsNullOrWhiteSpace(_propObservaciones) ? null : _propObservaciones.Trim(),
            IdUsuarioActual, detalles);

        var (datos, error) = await Api.CrearPropuestaAsync(req);
        _guardandoPropuesta = false;

        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        _snackbar.Add($"Propuesta #{datos?.IdPropuesta} creada correctamente.", Severity.Success);
        LimpiarPropuesta();
        _propZonaDestino = null;
        await CargarPropuestas();
    }

    // Al seleccionar una propuesta carga su detalle completo (con artículos) en el panel lateral.
    private async Task SeleccionarPropuesta(PropuestaDto? p)
    {
        if (p is null) return;
        _propuestaDetalle = p;        // muestra lo que ya tenemos mientras llega el detalle
        _cargandoDetalle = true;
        var (datos, error) = await Api.ObtenerPropuestaAsync(p.IdPropuesta);
        _cargandoDetalle = false;
        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        if (datos is not null) _propuestaDetalle = datos;
    }

    private string FilaPropuestaClass(PropuestaDto item, int _)
        => _propuestaDetalle is not null && _propuestaDetalle.IdPropuesta == item.IdPropuesta ? "fila-seleccionada" : "";

    private async Task ConfirmarPropuestaSeleccionada()
    {
        if (_propuestaDetalle is null) return;
        var p = _propuestaDetalle;
        var ok = await ConfirmarDialogo(
            "Confirmar y enviar",
            $"¿Confirmar la propuesta #{p.IdPropuesta} hacia '{p.ZonaDestino}'? Esto descontará del central y cargará el inventario a la zona.",
            "Confirmar y enviar", Color.Success);
        if (!ok) return;

        _resolviendoPropuesta = true;
        var (datos, error) = await Api.ConfirmarPropuestaAsync(p.IdPropuesta, new ResolverPropuestaRequest(IdUsuarioActual));
        _resolviendoPropuesta = false;
        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        _snackbar.Add($"Propuesta #{p.IdPropuesta} confirmada y enviada.", Severity.Success);
        _propuestaDetalle = datos;
        await CargarPropuestas();
        await CargarCentral();
    }

    private async Task RechazarPropuestaSeleccionada()
    {
        if (_propuestaDetalle is null) return;
        var p = _propuestaDetalle;
        var ok = await ConfirmarDialogo(
            "Rechazar propuesta",
            $"¿Rechazar la propuesta #{p.IdPropuesta} hacia '{p.ZonaDestino}'? No se moverá ningún inventario.",
            "Rechazar", Color.Error);
        if (!ok) return;

        _resolviendoPropuesta = true;
        var (datos, error) = await Api.RechazarPropuestaAdminAsync(p.IdPropuesta, new ResolverPropuestaRequest(IdUsuarioActual));
        _resolviendoPropuesta = false;
        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        _snackbar.Add($"Propuesta #{p.IdPropuesta} rechazada.", Severity.Success);
        _propuestaDetalle = datos;
        await CargarPropuestas();
    }

    // ===================== Helpers =====================

    private static bool EsPendiente(string? estatus)
        => string.Equals(estatus?.Trim(), "PENDIENTE", StringComparison.OrdinalIgnoreCase);

    private static bool EsConfirmada(string? estatus)
        => string.Equals(estatus?.Trim(), "CONFIRMADA", StringComparison.OrdinalIgnoreCase);

    private static IEnumerable<ExistenciaCentralDto> FiltrarCentral(List<ExistenciaCentralDto> fuente, string? busqueda)
    {
        var q = busqueda?.Trim() ?? "";
        if (string.IsNullOrEmpty(q)) return fuente;
        return fuente.Where(x =>
            (x.CodigoClave ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
            || (x.Descripcion ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
            || (x.Marca ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
            || (x.Categoria ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
            || x.IdProducto.ToString().Contains(q, StringComparison.OrdinalIgnoreCase));
    }

    private async Task<bool> ConfirmarDialogo(string titulo, string mensaje, string textoAceptar, Color color)
    {
        var opciones = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var parametros = new DialogParameters<DialogoConfirmacion>
        {
            { x => x.Titulo, titulo },
            { x => x.Mensaje, mensaje },
            { x => x.TextoAceptar, textoAceptar },
            { x => x.ColorAceptar, color },
            { x => x.Icono, Icons.Material.Filled.CheckCircle },
            { x => x.ColorIcono, color }
        };
        var dialogo = await _dialogo.ShowAsync<DialogoConfirmacion>(titulo, parametros, opciones);
        var resultado = await dialogo.Result;
        return resultado is { Canceled: false, Data: true };
    }

    // ===================== Exportación a Excel =====================

    // Genera el libro XLSX y dispara la descarga. 'titulo' es el nombre de la hoja de Excel.
    // 'titulos' (opcional) son líneas de encabezado que se escriben arriba de la tabla.
    private async Task ExportarAsync(string titulo, string[] columnas, IEnumerable<object?[]> filas,
        IEnumerable<string>? titulos = null)
    {
        if (_exportando) return;
        _exportando = true;
        try
        {
            var archivo = ExportadorExcel.Crear(columnas, filas, titulo, titulos);
            await _descarga.GuardarAsync($"{titulo}-{FechaProyecto.Ahora:yyyyMMdd-HHmmssfff}.xlsx", archivo);
        }
        catch (Exception ex)
        {
            _snackbar.Add($"No se pudo exportar: {ex.Message}", Severity.Error);
        }
        finally { _exportando = false; }
    }

    private Task ExportarCentral() => ExportarAsync(
        "Inventario Central",
        ["ID", "Clave", "Descripción", "Marca", "Categoría", "Color", "Talla", "Existencia", "Stock mínimo"],
        CentralFiltrado.Select(x => new object?[]
        {
            x.IdProducto, x.CodigoClave, x.Descripcion, x.Marca, x.Categoria, x.Color, x.Talla, x.Cantidad, x.StockMini
        }));

    private Task ExportarZona()
    {
        if (_zonaSeleccionada is null) return Task.CompletedTask;
        var nombreZona = _zonas.FirstOrDefault(z => z.IdZona == _zonaSeleccionada.Value)?.Descripcion
                         ?? $"Zona {_zonaSeleccionada.Value}";
        return ExportarAsync(
            nombreZona,
            ["ID", "Clave", "Descripción", "Marca", "Categoría", "Color", "Talla", "Existencia"],
            ZonaFiltrado.Select(x => new object?[]
            {
                x.IdProducto, x.CodigoClave, x.Descripcion, x.Marca, x.Categoria, x.Color, x.Talla, x.Cantidad
            }));
    }

    // Exporta el detalle (artículos) de la propuesta seleccionada en el panel lateral.
    // El título de la hoja es la zona destino de la propuesta.
    private Task ExportarDetallePropuesta()
    {
        if (_propuestaDetalle is null) return Task.CompletedTask;
        var p = _propuestaDetalle;
        var zona = string.IsNullOrWhiteSpace(p.ZonaDestino) ? $"Zona #{p.IdZonaDestino}" : p.ZonaDestino!;
        // Bloque de títulos arriba de la tabla (zona, estatus y fechas de cabecera).
        // La fecha de confirmación solo aparece si la propuesta está confirmada.
        var titulos = new List<string>
        {
            $"Zona: {zona}",
            $"Estatus: {p.Estatus}",
            $"Fecha de la propuesta: {p.FechaCreacion.EnZonaProyecto().DateTime:dd/MM/yyyy HH:mm}"
        };
        if (EsConfirmada(p.Estatus) && p.FechaResolucion is { } fr)
            titulos.Add($"Fecha de confirmación: {fr.EnZonaProyecto().DateTime:dd/MM/yyyy HH:mm}");

        return ExportarAsync(
            zona,
            ["Clave", "Producto", "Marca", "Categoría", "Cantidad"],
            p.Detalles.Select(d => new object?[]
            {
                d.CodigoClave,
                d.Producto ?? $"Producto #{d.IdProducto}",
                d.Marca,
                d.Categoria,
                d.Cantidad
            }),
            titulos);
    }

    // ===================== Búsqueda en filtros de selección =====================

    // Estatus de propuesta: valores fijos. El valor almacenado es la clave en mayúsculas.
    private static readonly string[] _estatusPropuesta = { "PENDIENTE", "CONFIRMADA", "RECHAZADA" };

    private static string EtiquetaEstatus(string? estatus) => estatus?.ToUpperInvariant() switch
    {
        "PENDIENTE" => "Pendiente",
        "CONFIRMADA" => "Confirmada",
        "RECHAZADA" => "Rechazada",
        _ => estatus ?? string.Empty
    };

    private Task<IEnumerable<string>> BuscarEstatusPropuesta(string? valor, CancellationToken ct)
    {
        IEnumerable<string> origen = _estatusPropuesta;
        if (!string.IsNullOrWhiteSpace(valor))
            origen = origen.Where(e => EtiquetaEstatus(e).Contains(valor, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(origen);
    }

    // Tipo de movimiento del historial: la clave backend se guarda; se muestra su etiqueta.
    private string EtiquetaTipoMovimiento(string? clave)
        => clave is not null && _tiposMovimiento.TryGetValue(clave, out var etiqueta) ? etiqueta : (clave ?? string.Empty);

    private Task<IEnumerable<string>> BuscarTipoMovimiento(string? valor, CancellationToken ct)
    {
        IEnumerable<string> claves = _tiposMovimiento.Keys;
        if (!string.IsNullOrWhiteSpace(valor))
            claves = claves.Where(k => _tiposMovimiento[k].Contains(valor, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(claves);
    }
    }
