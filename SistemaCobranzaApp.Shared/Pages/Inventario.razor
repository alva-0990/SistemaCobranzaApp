@page "/inventario"

@using MudBlazor
@using SistemaCobranzaApp.Shared.Components
@using SistemaCobranzaApp.Shared.Dtos
@using SistemaCobranzaApp.Shared.Services
@inject ApiCliente Api
@inject IDialogService _dialogo
@inject ISnackbar _snackbar
@inject IDescargaArchivo _descarga

<MudTabs Elevation="2" Rounded="true" Color="Color.Primary" ApplyEffectsToContainer="true"
         PanelClass="pa-0 pt-4" SliderColor="Color.Warning" Class="ma-2 tabs-remarcados">

    <!-- ============================================================= -->
    <!-- ===================== INVENTARIO CENTRAL ==================== -->
    <!-- ============================================================= -->
    <MudTabPanel Text="Inventario Central" Icon="@Icons.Material.Filled.Warehouse">
        <MudPaper Elevation="0" Class="pa-4">

            <div class="encabezado-seccion mb-4">
                <MudIcon Icon="@Icons.Material.Filled.Warehouse" Color="Color.Primary" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.h6" Class="titulo-seccion">Inventario Central</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Registre entradas de mercancía y ajuste las existencias del almacén principal.
                    </MudText>
                </div>
            </div>

            <MudGrid Spacing="3">
                <!-- Panel izquierdo: entrada / ajuste -->
                <MudItem xs="12" md="4" lg="3">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 panel-accion">
                        <div class="d-flex align-center gap-2 mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory" Color="Color.Primary" />
                            <MudText Typo="Typo.subtitle1"><b>Entrada / Ajuste de existencias</b></MudText>
                        </div>

                        <MudText Typo="Typo.caption" Color="Color.Secondary">Producto seleccionado:</MudText>
                        @if (_centralSeleccion is null)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Info" Class="mb-2">
                                Seleccione un producto de la tabla
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body1" Class="mb-1">
                                <b>@_centralSeleccion.CodigoClave</b> — @_centralSeleccion.Descripcion
                            </MudText>
                            @MetaProducto(_centralSeleccion.Marca, _centralSeleccion.Categoria, _centralSeleccion.Color, _centralSeleccion.Talla)
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Existencia actual:
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">
                                    @_centralSeleccion.Cantidad
                                </MudChip>
                            </MudText>
                        }

                        <MudSelect T="bool" Label="Tipo de operación" @bind-Value="_centralEsAjuste"
                                   Variant="Variant.Outlined" Dense="true" Class="mb-3"
                                   Disabled="@(_centralSeleccion is null)">
                            <MudSelectItem T="bool" Value="false">Entrada (suma al stock)</MudSelectItem>
                            <MudSelectItem T="bool" Value="true">Ajuste (fija cantidad exacta)</MudSelectItem>
                        </MudSelect>

                        <MudNumericField T="int" @bind-Value="_centralCantidad"
                                         Label="@(_centralEsAjuste ? "Nueva cantidad exacta" : "Cantidad a ingresar")"
                                         Variant="Variant.Outlined" Dense="true" Min="0" Class="mb-3"
                                         Disabled="@(_centralSeleccion is null)" />

                        <MudTextField T="string" @bind-Value="_centralObservaciones"
                                      Label="Observaciones (opcional)" Variant="Variant.Outlined"
                                      Lines="3" Dense="true" Class="mb-3"
                                      Disabled="@(_centralSeleccion is null)" />

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.Save" Class="mb-2"
                                   Disabled="@(_centralSeleccion is null || _guardandoCentral)"
                                   OnClick="AplicarMovimientoCentral">
                            @(_guardandoCentral ? "Aplicando..." : "Aplicar movimiento")
                        </MudButton>

                        <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.Clear"
                                   Disabled="@(_centralSeleccion is null)"
                                   OnClick="LimpiarSeleccionCentral">
                            Limpiar selección
                        </MudButton>
                    </MudPaper>
                </MudItem>

                <!-- Tabla derecha: existencias centrales -->
                <MudItem xs="12" md="8" lg="9">
                    <div class="barra-acciones">
                        <MudTextField T="string"
                                      @bind-Value="_busquedaCentral"
                                      Immediate="true"
                                      Placeholder="Filtrar por nombre o clave..."
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      AdornmentColor="Color.Primary"
                                      Clearable="true"
                                      Class="buscador-remarcado" />
                        <MudButton Variant="Variant.Filled" Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.FileDownload"
                                   OnClick="ExportarCentral" Class="boton-nuevo"
                                   Disabled="@(_exportando || CentralFiltrado.Any() == false)">
                            Exportar a Excel
                        </MudButton>
                    </div>

                    @if (_cargandoCentral)
                    {
                        <div class="d-flex justify-center pa-8">
                            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                        </div>
                    }
                    else
                    {
                        <MudTable Items="CentralFiltrado" Hover="true" Dense="true" FixedHeader="true"
                                  Height="60vh" Breakpoint="Breakpoint.Sm" Elevation="0" RowsPerPage="25"
                                  T="ExistenciaCentralDto"
                                  OnRowClick="@((TableRowClickEventArgs<ExistenciaCentralDto> e) => SeleccionarCentral(e.Item))"
                                  RowClassFunc="@FilaCentralClass">
                            <HeaderContent>
                                <MudTh Style="width:8%;">ID</MudTh>
                                <MudTh Style="width:14%;">Clave</MudTh>
                                <MudTh>Descripción / Artículo</MudTh>
                                <MudTh Style="width:10%; text-align:right;">Existencia</MudTh>
                                <MudTh Style="width:8%; text-align:right;">Mín.</MudTh>
                                <MudTh Style="width:13%; text-align:center;">Estado Stock</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="ID">@context.IdProducto</MudTd>
                                <MudTd DataLabel="Clave"><b>@context.CodigoClave</b></MudTd>
                                <MudTd DataLabel="Descripción">
                                    <div>@context.Descripcion</div>
                                    @MetaProducto(context.Marca, context.Categoria, context.Color, context.Talla)
                                </MudTd>
                                <MudTd DataLabel="Existencia" Style="text-align:right;">@context.Cantidad</MudTd>
                                <MudTd DataLabel="Mín." Style="text-align:right;">@context.StockMini</MudTd>
                                <MudTd DataLabel="Estado Stock" Style="text-align:center;">
                                    @ChipStock(context.Cantidad, context.StockMini)
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>@EstadoVacio("No hay productos que coincidan.")</NoRecordsContent>
                            <PagerContent>
                                <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}"
                                               RowsPerPageString="Filas:"
                                               PageSizeOptions="new[] { 25, 50, 100 }" />
                            </PagerContent>
                        </MudTable>
                    }
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudTabPanel>

    <!-- ============================================================= -->
    <!-- ===================== EXISTENCIAS POR ZONA ================== -->
    <!-- ============================================================= -->
    <MudTabPanel Text="Existencias por Zona" Icon="@Icons.Material.Filled.Map">
        <MudPaper Elevation="0" Class="pa-4">

            <div class="encabezado-seccion mb-4">
                <MudIcon Icon="@Icons.Material.Filled.Map" Color="Color.Primary" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.h6" Class="titulo-seccion">Existencias por Zona</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Consulte las existencias del almacén de cada zona y ajuste cantidades (conteo físico, mermas, correcciones).
                    </MudText>
                </div>
            </div>

            <MudGrid Spacing="3">
                <!-- Panel izquierdo: ajuste de zona -->
                <MudItem xs="12" md="4" lg="3">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 panel-accion">
                        <div class="d-flex align-center gap-2 mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.EditNote" Color="Color.Primary" />
                            <MudText Typo="Typo.subtitle1"><b>Ajuste de existencia en zona</b></MudText>
                        </div>

                        <AutocompletarCatalogo TItem="ZonaDto" Label="Zona" Class="mb-3"
                                               Placeholder="Busque y seleccione una zona"
                                               Value="_zonaSeleccionada"
                                               ValueChanged="OnZonaSeleccionadaChanged"
                                               Items="_zonas"
                                               ObtenerId="@(z => z.IdZona)"
                                               ObtenerTexto="@(z => z.Descripcion)" />

                        <MudText Typo="Typo.caption" Color="Color.Secondary">Producto seleccionado:</MudText>
                        @if (_zonaSeleccion is null)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Info" Class="mb-2">
                                Seleccione un producto de la tabla
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body1" Class="mb-1">
                                <b>@_zonaSeleccion.CodigoClave</b> — @_zonaSeleccion.Descripcion
                            </MudText>
                            @MetaProducto(_zonaSeleccion.Marca, _zonaSeleccion.Categoria, _zonaSeleccion.Color, _zonaSeleccion.Talla)
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Existencia actual:
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">
                                    @_zonaSeleccion.Cantidad
                                </MudChip>
                            </MudText>
                        }

                        <MudNumericField T="int" @bind-Value="_zonaCantidad"
                                         Label="Nueva cantidad exacta" Variant="Variant.Outlined"
                                         Dense="true" Min="0" Class="mb-3"
                                         Disabled="@(_zonaSeleccion is null)" />

                        <MudTextField T="string" @bind-Value="_zonaObservaciones"
                                      Label="Motivo / Observaciones (opcional)" Variant="Variant.Outlined"
                                      Lines="3" Dense="true" Class="mb-3"
                                      Disabled="@(_zonaSeleccion is null)" />

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.Save" Class="mb-2"
                                   Disabled="@(_zonaSeleccion is null || _guardandoZona)"
                                   OnClick="AplicarAjusteZona">
                            @(_guardandoZona ? "Aplicando..." : "Aplicar ajuste")
                        </MudButton>

                        <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.Clear"
                                   Disabled="@(_zonaSeleccion is null)"
                                   OnClick="LimpiarSeleccionZona">
                            Limpiar selección
                        </MudButton>
                    </MudPaper>
                </MudItem>

                <!-- Tabla derecha: existencias por zona -->
                <MudItem xs="12" md="8" lg="9">
                    <div class="barra-acciones">
                        <MudTextField T="string"
                                      @bind-Value="_busquedaZona"
                                      Immediate="true"
                                      Placeholder="Filtrar por nombre o clave..."
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      AdornmentColor="Color.Primary"
                                      Clearable="true"
                                      Class="buscador-remarcado" />
                        <MudButton Variant="Variant.Filled" Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.FileDownload"
                                   OnClick="ExportarZona" Class="boton-nuevo"
                                   Disabled="@(_exportando || _zonaSeleccionada is null || ZonaFiltrado.Any() == false)">
                            Exportar a Excel
                        </MudButton>
                    </div>

                    @if (_zonaSeleccionada is null)
                    {
                        @EstadoVacio("Seleccione una zona para ver sus existencias.")
                    }
                    else if (_cargandoZona)
                    {
                        <div class="d-flex justify-center pa-8">
                            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                        </div>
                    }
                    else
                    {
                        <MudTable Items="ZonaFiltrado" Hover="true" Dense="true" FixedHeader="true"
                                  Height="60vh" Breakpoint="Breakpoint.Sm" Elevation="0" RowsPerPage="25"
                                  T="ExistenciaZonaDto"
                                  OnRowClick="@((TableRowClickEventArgs<ExistenciaZonaDto> e) => SeleccionarZona(e.Item))"
                                  RowClassFunc="@FilaZonaClass">
                            <HeaderContent>
                                <MudTh Style="width:8%;">ID</MudTh>
                                <MudTh Style="width:16%;">Clave</MudTh>
                                <MudTh>Descripción / Artículo</MudTh>
                                <MudTh Style="width:12%; text-align:right;">Existencia</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="ID">@context.IdProducto</MudTd>
                                <MudTd DataLabel="Clave"><b>@context.CodigoClave</b></MudTd>
                                <MudTd DataLabel="Descripción">
                                    <div>@context.Descripcion</div>
                                    @MetaProducto(context.Marca, context.Categoria, context.Color, context.Talla)
                                </MudTd>
                                <MudTd DataLabel="Existencia" Style="text-align:right;">
                                    <b>@context.Cantidad</b>
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>@EstadoVacio("Esta zona no tiene existencias registradas.")</NoRecordsContent>
                            <PagerContent>
                                <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}"
                                               RowsPerPageString="Filas:"
                                               PageSizeOptions="new[] { 25, 50, 100 }" />
                            </PagerContent>
                        </MudTable>
                    }
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudTabPanel>

    <!-- ============================================================= -->
    <!-- ===================== ENVÍO A ZONAS ======================== -->
    <!-- ============================================================= -->
    <MudTabPanel Text="Envío a Zonas" Icon="@Icons.Material.Filled.LocalShipping">
        <MudPaper Elevation="0" Class="pa-4">

            <div class="encabezado-seccion mb-4">
                <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Color="Color.Primary" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.h6" Class="titulo-seccion">Envío a Zonas</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Genere propuestas de envío del central a las zonas, confírmelas o recházalas y consulte el historial.
                    </MudText>
                </div>
            </div>

            <MudTabs Elevation="0" Rounded="true" Color="Color.Info" Border="true"
                     PanelClass="pa-3" ApplyEffectsToContainer="true">

                <!-- Nueva propuesta: panel de datos (izquierda) + lista de artículos (derecha) -->
                <MudTabPanel Text="Nueva propuesta" Icon="@Icons.Material.Filled.PlaylistAdd">
                    <MudGrid Spacing="3">
                        <!-- Panel izquierdo: datos de la propuesta + agregar producto -->
                        <MudItem xs="12" md="4" lg="3">
                            <MudPaper Elevation="0" Outlined="true" Class="pa-4 panel-accion">
                                <div class="d-flex align-center gap-2 mb-3">
                                    <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Primary" />
                                    <MudText Typo="Typo.subtitle1"><b>Datos de la propuesta</b></MudText>
                                </div>

                                <AutocompletarCatalogo TItem="ZonaDto" Label="Zona destino" Class="mb-3"
                                                       Placeholder="Busque y seleccione una zona"
                                                       @bind-Value="_propZonaDestino"
                                                       Items="_zonas"
                                                       ObtenerId="@(z => z.IdZona)"
                                                       ObtenerTexto="@(z => z.Descripcion)" />

                                <MudTextField T="string" @bind-Value="_propObservaciones"
                                              Label="Observaciones (opcional)" Variant="Variant.Outlined"
                                              Lines="2" Dense="true" Class="mb-4" />

                                <MudDivider Class="mb-3" />

                                <div class="d-flex align-center gap-2 mb-3">
                                    <MudIcon Icon="@Icons.Material.Filled.AddShoppingCart" Color="Color.Primary" />
                                    <MudText Typo="Typo.subtitle1"><b>Agregar producto</b></MudText>
                                </div>

                                <MudAutocomplete T="ExistenciaCentralDto" Label="Producto"
                                                 @bind-Value="_propProductoSel"
                                                 SearchFunc="BuscarProductoCentral"
                                                 ToStringFunc="@(p => p is null ? "" : $"{p.CodigoClave} — {p.Descripcion}")"
                                                 Variant="Variant.Outlined" Dense="true" Class="mb-1"
                                                 ResetValueOnEmptyText="true" CoerceText="true" Clearable="true">
                                    <ItemTemplate Context="prod">
                                        <div>
                                            <b>@prod.CodigoClave</b> — @prod.Descripcion
                                        </div>
                                        @MetaProducto(prod.Marca, prod.Categoria, prod.Color, prod.Talla)
                                    </ItemTemplate>
                                </MudAutocomplete>

                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">
                                    Existencia central:
                                    <b>@(_propProductoSel is null ? "—" : _propProductoSel.Cantidad.ToString())</b>
                                </MudText>

                                <MudNumericField T="int" @bind-Value="_propCantidad"
                                                 Label="Cantidad a enviar" Variant="Variant.Outlined"
                                                 Dense="true" Min="1" Class="mb-3"
                                                 Disabled="@(_propProductoSel is null)" />

                                <MudButton Variant="Variant.Filled" Color="Color.Info" FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           Disabled="@(_propProductoSel is null)"
                                           OnClick="AgregarArticuloPropuesta">
                                    Agregar a la lista
                                </MudButton>
                            </MudPaper>
                        </MudItem>

                        <!-- Lista de artículos de la propuesta -->
                        <MudItem xs="12" md="8" lg="9">
                            <MudTable Items="_articulosPropuesta" Hover="true" Dense="true"
                                      Breakpoint="Breakpoint.Sm" Elevation="0" T="ArticuloPropuesta"
                                      Height="48vh" FixedHeader="true">
                                <HeaderContent>
                                    <MudTh Style="width:16%;">Clave</MudTh>
                                    <MudTh>Producto</MudTh>
                                    <MudTh Style="width:12%; text-align:right;">Cantidad</MudTh>
                                    <MudTh Style="width:12%; text-align:right;">Exist. Central</MudTh>
                                    <MudTh Style="width:8%; text-align:center;"></MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Clave"><b>@context.CodigoClave</b></MudTd>
                                    <MudTd DataLabel="Producto">
                                        <div>@context.Descripcion</div>
                                        @MetaProducto(context.Marca, context.Categoria, context.Color, context.Talla)
                                    </MudTd>
                                    <MudTd DataLabel="Cantidad" Style="text-align:right;">@context.Cantidad</MudTd>
                                    <MudTd DataLabel="Exist. Central" Style="text-align:right;">@context.ExistenciaCentral</MudTd>
                                    <MudTd Style="text-align:center;">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                       Color="Color.Error" Title="Quitar"
                                                       OnClick="@(() => QuitarArticulo(context))" />
                                    </MudTd>
                                </RowTemplate>
                                <NoRecordsContent>@EstadoVacio("Agregue productos a la propuesta desde el panel izquierdo.")</NoRecordsContent>
                            </MudTable>

                            <div class="d-flex justify-end gap-2 mt-3 flex-wrap">
                                <MudButton Variant="Variant.Outlined" Color="Color.Default"
                                           StartIcon="@Icons.Material.Filled.CleaningServices"
                                           Disabled="@(_articulosPropuesta.Count == 0)"
                                           OnClick="LimpiarPropuesta">
                                    Limpiar todo
                                </MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Success"
                                           StartIcon="@Icons.Material.Filled.Save"
                                           Disabled="@(_articulosPropuesta.Count == 0 || _propZonaDestino is null || _guardandoPropuesta)"
                                           OnClick="GuardarPropuesta">
                                    @(_guardandoPropuesta ? "Guardando..." : "Guardar propuesta")
                                </MudButton>
                            </div>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                        <!-- Propuestas existentes: tabla + panel de detalle lateral -->
                        <MudTabPanel Text="Propuestas" Icon="@Icons.Material.Filled.Inventory2">
                            <div class="barra-filtros-prop">
                                <MudAutocomplete T="string" @bind-Value="_filtroEstatus" Label="Estatus"
                                                 SearchFunc="BuscarEstatusPropuesta"
                                                 Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                                                 Clearable="true" ResetValueOnEmptyText="true" CoerceText="true"
                                                 Class="filtro-prop" Placeholder="Todos">
                                    <ItemTemplate Context="e">@EtiquetaEstatus(e)</ItemTemplate>
                                </MudAutocomplete>
                                <AutocompletarCatalogo TItem="ZonaDto" Label="Zona" Placeholder="Todas"
                                                       Margin="Margin.Dense" Class="filtro-prop"
                                                       @bind-Value="_propFiltroZona"
                                                       Items="_zonas"
                                                       ObtenerId="@(z => z.IdZona)"
                                                       ObtenerTexto="@(z => z.Descripcion)" />
                                <MudDatePicker Label="Desde" @bind-Date="_propFiltroDesde" Variant="Variant.Outlined"
                                               Margin="Margin.Dense" Clearable="true" Class="filtro-prop filtro-prop-fecha" />
                                <MudDatePicker Label="Hasta" @bind-Date="_propFiltroHasta" Variant="Variant.Outlined"
                                               Margin="Margin.Dense" Clearable="true" Class="filtro-prop filtro-prop-fecha" />
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Search"
                                           OnClick="CargarPropuestas" Class="boton-prop">
                                    Actualizar
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.FilterAltOff"
                                           OnClick="LimpiarFiltrosPropuestas" Class="boton-prop">
                                    Limpiar
                                </MudButton>
                            </div>

                            <MudGrid Spacing="3">
                                <!-- Lista de propuestas -->
                                <MudItem xs="12" md="7" lg="8">
                                    @if (_cargandoPropuestas)
                                    {
                                        <div class="d-flex justify-center pa-8">
                                            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                                        </div>
                                    }
                                    else
                                    {
                                        <MudTable Items="PropuestasFiltradas" Hover="true" Dense="true"
                                                  Breakpoint="Breakpoint.Sm" Elevation="0" RowsPerPage="15"
                                                  T="PropuestaDto" Height="56vh" FixedHeader="true"
                                                  OnRowClick="@((TableRowClickEventArgs<PropuestaDto> e) => SeleccionarPropuesta(e.Item))"
                                                  RowClassFunc="@FilaPropuestaClass">
                                            <HeaderContent>
                                                <MudTh Style="width:7%;">#</MudTh>
                                                <MudTh>Zona</MudTh>
                                                <MudTh Style="width:11%; text-align:center;">Líneas</MudTh>
                                                <MudTh Style="width:11%; text-align:center;">Piezas</MudTh>
                                                <MudTh>Fecha</MudTh>
                                                <MudTh Style="width:16%; text-align:center;">Estatus</MudTh>
                                            </HeaderContent>
                                            <RowTemplate>
                                                <MudTd DataLabel="#">@context.IdPropuesta</MudTd>
                                                <MudTd DataLabel="Zona">
                                                    <b>@(string.IsNullOrWhiteSpace(context.ZonaDestino) ? $"Zona #{context.IdZonaDestino}" : context.ZonaDestino)</b>
                                                </MudTd>
                                                <MudTd DataLabel="Líneas" Style="text-align:center;">@context.Detalles.Count</MudTd>
                                                <MudTd DataLabel="Piezas" Style="text-align:center;">@context.Detalles.Sum(d => d.Cantidad)</MudTd>
                                                <MudTd DataLabel="Fecha">@context.FechaCreacion.EnZonaProyecto().DateTime.ToString("dd/MM/yyyy HH:mm")</MudTd>
                                                <MudTd DataLabel="Estatus" Style="text-align:center;">@ChipEstatus(context.Estatus)</MudTd>
                                            </RowTemplate>
                                            <NoRecordsContent>@EstadoVacio("No hay propuestas con los filtros seleccionados.")</NoRecordsContent>
                                            <PagerContent>
                                                <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Filas:" />
                                            </PagerContent>
                                        </MudTable>
                                    }
                                </MudItem>

                                <!-- Panel de detalle de la propuesta seleccionada -->
                                <MudItem xs="12" md="5" lg="4">
                                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 panel-accion">
                                        <MudText Typo="Typo.subtitle1" Class="mb-1"><b>Detalle de la propuesta</b></MudText>

                                        @if (_propuestaDetalle is null)
                                        {
                                            <div class="pa-6 text-center">
                                                <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Large" Color="Color.Secondary" />
                                                <MudText Color="Color.Secondary" Class="mt-2">
                                                    Seleccione una propuesta de la lista para ver su detalle.
                                                </MudText>
                                            </div>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                                                Propuesta #@_propuestaDetalle.IdPropuesta →
                                                <b>@(_propuestaDetalle.ZonaDestino ?? $"Zona #{_propuestaDetalle.IdZonaDestino}")</b>
                                                (@_propuestaDetalle.Estatus)
                                            </MudText>

                                            @if (_cargandoDetalle)
                                            {
                                                <div class="d-flex justify-center pa-4">
                                                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
                                                </div>
                                            }
                                            else
                                            {
                                                <MudTable Items="_propuestaDetalle.Detalles" Dense="true" Hover="true" Elevation="0"
                                                          Breakpoint="Breakpoint.None" T="PropuestaDetalleDto" Height="38vh" FixedHeader="true">
                                                    <HeaderContent>
                                                        <MudTh>Producto</MudTh>
                                                        <MudTh Style="width:22%; text-align:right;">Cant.</MudTh>
                                                    </HeaderContent>
                                                    <RowTemplate>
                                                        <MudTd DataLabel="Producto">
                                                            <div>
                                                                @if (!string.IsNullOrWhiteSpace(context.CodigoClave))
                                                                {
                                                                    <b>@context.CodigoClave</b> <text>— </text>
                                                                }
                                                                @(context.Producto ?? $"Producto #{context.IdProducto}")
                                                            </div>
                                                            @MetaProducto(context.Marca, context.Categoria, null, null)
                                                        </MudTd>
                                                        <MudTd DataLabel="Cant." Style="text-align:right;"><b>@context.Cantidad</b></MudTd>
                                                    </RowTemplate>
                                                    <NoRecordsContent>
                                                        <MudText Color="Color.Secondary" Class="pa-3 text-center">Sin artículos.</MudText>
                                                    </NoRecordsContent>
                                                </MudTable>

                                                <MudButton Variant="Variant.Outlined" Color="Color.Success" FullWidth="true"
                                                           StartIcon="@Icons.Material.Filled.FileDownload" Class="mt-2"
                                                           OnClick="ExportarDetallePropuesta"
                                                           Disabled="@(_exportando || _propuestaDetalle.Detalles.Count == 0)">
                                                    Exportar a Excel
                                                </MudButton>

                                                @if (!string.IsNullOrWhiteSpace(_propuestaDetalle.Observaciones))
                                                {
                                                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2" Variant="Variant.Outlined">
                                                        @_propuestaDetalle.Observaciones
                                                    </MudAlert>
                                                }

                                                @if (EsPendiente(_propuestaDetalle.Estatus))
                                                {
                                                    <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                                                               StartIcon="@Icons.Material.Filled.CheckCircle" Class="mt-3 mb-2"
                                                               Disabled="@_resolviendoPropuesta"
                                                               OnClick="ConfirmarPropuestaSeleccionada">
                                                        Confirmar y enviar
                                                    </MudButton>
                                                    <MudButton Variant="Variant.Filled" Color="Color.Error" FullWidth="true"
                                                               StartIcon="@Icons.Material.Filled.Cancel"
                                                               Disabled="@_resolviendoPropuesta"
                                                               OnClick="RechazarPropuestaSeleccionada">
                                                        Rechazar propuesta
                                                    </MudButton>
                                                }
                                                else
                                                {
                                                    <MudAlert Severity="@(EsConfirmada(_propuestaDetalle.Estatus) ? Severity.Success : Severity.Error)"
                                                              Dense="true" Class="mt-3" Variant="Variant.Outlined">
                                                        Esta propuesta ya fue @(_propuestaDetalle.Estatus?.ToLowerInvariant()).
                                                        @if (_propuestaDetalle.FechaResolucion is not null)
                                                        {
                                                            <text> (@_propuestaDetalle.FechaResolucion.Value.EnZonaProyecto().DateTime.ToString("dd/MM/yyyy HH:mm"))</text>
                                                        }
                                                    </MudAlert>
                                                }
                                            }
                                        }
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>
                        </MudTabPanel>

                        <!-- Historial de inventario: vista global con filtros -->
                        <MudTabPanel Text="Historial de inventario" Icon="@Icons.Material.Filled.History">
                            <div class="barra-filtros-hist">
                                <MudAutocomplete T="string" @bind-Value="_histTipo" Label="Tipo"
                                                 SearchFunc="BuscarTipoMovimiento"
                                                 ToStringFunc="EtiquetaTipoMovimiento"
                                                 Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                                                 Clearable="true" ResetValueOnEmptyText="true" CoerceText="true"
                                                 Class="filtro-hist" Placeholder="Todos">
                                    <ItemTemplate Context="t">@EtiquetaTipoMovimiento(t)</ItemTemplate>
                                </MudAutocomplete>
                                <AutocompletarCatalogo TItem="ZonaDto" Label="Zona" Placeholder="Todas"
                                                       Margin="Margin.Dense" Class="filtro-hist"
                                                       @bind-Value="_histZona"
                                                       Items="_zonas"
                                                       ObtenerId="@(z => z.IdZona)"
                                                       ObtenerTexto="@(z => z.Descripcion)" />
                                <MudDatePicker Label="Desde" @bind-Date="_histDesde" Variant="Variant.Outlined"
                                               Margin="Margin.Dense" Clearable="true" Class="filtro-hist filtro-hist-fecha" />
                                <MudDatePicker Label="Hasta" @bind-Date="_histHasta" Variant="Variant.Outlined"
                                               Margin="Margin.Dense" Clearable="true" Class="filtro-hist filtro-hist-fecha" />
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Search"
                                           OnClick="CargarHistorial" Class="boton-hist">
                                    Actualizar
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.FilterAltOff"
                                           OnClick="LimpiarFiltrosHistorial" Class="boton-hist">
                                    Limpiar
                                </MudButton>
