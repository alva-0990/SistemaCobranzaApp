@page "/"
@using MudBlazor
@using SistemaCobranzaApp.Shared.Services
@using SistemaCobranzaApp.Shared.Dtos
@inject ApiCliente ApiClienteService
@inject NavigationManager NavigationManagerService
@inject ISnackbar Snackbar

@* ============================================================================
   PANEL DE CONTROL ADMINISTRATIVO
   ----------------------------------------------------------------------------
   KPIs, gráficas y resumen por zona alimentados con datos reales del backend
   (GET /api/reportes/dashboard). Mantiene el diseño visual aprobado.
   ============================================================================ *@

<div class="dashboard">

    <!-- Encabezado -->
    <div class="dash-header mb-3">
        <div>
            <MudText Typo="Typo.h5" Class="dash-titulo">Panel de control</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Resumen general de ventas y cobranza
            </MudText>
        </div>
        @if (_cargando)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
        }
    </div>

    <!-- ===================== Filtros (colapsables) ===================== -->
    <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-3">
        <div class="seccion-titulo filtros-header" @onclick="@(() => _filtrosAbiertos = !_filtrosAbiertos)">
            <div class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="Size.Small" Class="mr-1" />
                Filtros
            </div>
            <MudIconButton Icon="@(_filtrosAbiertos ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           Size="Size.Small"
                           OnClick="@(() => _filtrosAbiertos = !_filtrosAbiertos)" />
        </div>

        <MudCollapse Expanded="_filtrosAbiertos">
            <MudGrid Spacing="2" Class="mt-1">
                <MudItem xs="12" sm="6" md="3">
                    <MudDatePicker Label="Desde" @bind-Date="_desde" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudDatePicker Label="Hasta" @bind-Date="_hasta" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="long?" Label="Zona" @bind-Value="_idZona" Variant="Variant.Outlined" Clearable="true">
                        <MudSelectItem T="long?" Value="@((long?)null)">Todas las zonas</MudSelectItem>
                        @foreach (var z in _zonas)
                        {
                            <MudSelectItem T="long?" Value="@((long?)z.IdZona)">@z.Descripcion</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Search" Class="boton-aplicar"
                               OnClick="GenerarAsync" Disabled="_cargando">
                        Aplicar
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudCollapse>
    </MudPaper>

    <!-- ===================== Indicadores (KPIs) ===================== -->
    <MudGrid Spacing="3" Class="mb-1">
        @Kpi("Ventas totales", _kpis.VentasTotales.ToString("C2"), Icons.Material.Filled.PointOfSale, "kpi-azul",
             $"{_kpis.PorcentajeRecuperacionGlobal.ToString("0.#")}% de recuperación")
        @Kpi("Total cobrado", _kpis.TotalCobrado.ToString("C2"), Icons.Material.Filled.Payments, "kpi-verde",
             "Cobranza en el periodo")
        @Kpi("Saldo por cobrar", _kpis.SaldoPorCobrar.ToString("C2"), Icons.Material.Filled.AccountBalanceWallet, "kpi-ambar",
             $"{_kpis.CuentasConSaldo} cuentas con saldo")
        @Kpi("Cobrado hoy", _kpis.CobradoHoy.ToString("C2"), Icons.Material.Filled.Today, "kpi-morado",
             $"{_kpis.PagosHoy} pagos registrados")
    </MudGrid>

    <!-- ===================== Indicadores ejecutivos (riesgo de cartera) ===================== -->
    @if (_ejecutivo is not null)
    {
        <MudGrid Spacing="3" Class="mb-1">
            @Kpi("Clientes con atraso", _ejecutivo.ClientesConAtraso.ToString("N0"), Icons.Material.Filled.Warning, "kpi-ambar",
                 $"{_ejecutivo.ClientesActivos:N0} clientes activos")
            @Kpi("Clientes críticos", _ejecutivo.ClientesCriticos.ToString("N0"), Icons.Material.Filled.ReportProblem, "kpi-rojo",
                 "Fuera del período de gracia")
            @Kpi("Saldo crítico (+30 días)", (_antiguedad?.SaldoCritico ?? 0m).ToString("C2"), Icons.Material.Filled.HourglassBottom, "kpi-morado",
                 _antiguedad is { SaldoTotal: > 0 } ant
                     ? $"{(ant.SaldoCritico / ant.SaldoTotal * 100m):0.#}% de la cartera · máx. {ant.MaximoAtraso} días"
                     : "Sin saldo pendiente")
            @Kpi("Zona con mayor riesgo", string.IsNullOrWhiteSpace(_ejecutivo.ZonaMayorRiesgo) ? "—" : _ejecutivo.ZonaMayorRiesgo!, Icons.Material.Filled.Place, "kpi-rojo",
                 _ejecutivo.ZonaMayorRiesgoSaldo.ToString("C2"))
        </MudGrid>
    }

    <!-- ===================== Gráficas ===================== -->
    <MudGrid Spacing="3" Class="mt-1 mb-1">
        <!-- Ventas por zona -->
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Outlined="true" Class="pa-3 h-100">
                <div class="seccion-titulo mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Small" Class="mr-1" />
                    Ventas totales por zona
                </div>
                <MudChart T="double" ChartType="ChartType.Bar" ChartSeries="_serieVentasZona" XAxisLabels="_zonasArray"
                          Width="100%" Height="260px" ChartOptions="_opcionesBarras" />
                @LeyendaZonas(_datos?.VentasPorZona)
            </MudPaper>
        </MudItem>

        <!-- Cobranza por zona -->
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Outlined="true" Class="pa-3 h-100">
                <div class="seccion-titulo mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.StackedBarChart" Size="Size.Small" Class="mr-1" />
                    Cobranza por zona
                </div>
                <MudChart T="double" ChartType="ChartType.Bar" ChartSeries="_serieCobranzaZona" XAxisLabels="_zonasCobranzaArray"
                          Width="100%" Height="260px" ChartOptions="_opcionesBarras" />
                @LeyendaZonas(_datos?.CobranzaPorZona)
            </MudPaper>
        </MudItem>

        <!-- Cobranza por día -->
        <MudItem xs="12">
            <MudPaper Elevation="0" Outlined="true" Class="pa-3 h-100">
                <div class="seccion-titulo mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.ShowChart" Size="Size.Small" Class="mr-1" />
                    Cobranza por día
                </div>
                <MudChart T="double" ChartType="ChartType.Line" ChartSeries="_serieCobranzaDia" XAxisLabels="_diasArray"
                          Width="100%" Height="280px" ChartOptions="_opcionesLinea" />
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- ===================== Antigüedad de saldos y Top 10 deudores ===================== -->
    @if (_antiguedad is not null || _ranking is not null)
    {
        <MudGrid Spacing="3" Class="mt-1 mb-1">
            @if (_antiguedad is not null)
            {
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 h-100">
                        <div class="seccion-titulo mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.HourglassBottom" Size="Size.Small" Class="mr-1" />
                            Antigüedad de saldos
                        </div>
                        <MudChart T="double" ChartType="ChartType.Bar" ChartSeries="_serieAntiguedad" XAxisLabels="_rangosArray"
                                  Width="100%" Height="260px" ChartOptions="_opcionesAntiguedad" />
                        @LeyendaZonas(_antiguedad.Rangos.Select(r => new DashboardSerieZona(r.Rango, r.SaldoPendiente)).ToList(), _paletaAntiguedad)
                    </MudPaper>
                </MudItem>
            }
            @if (_ranking is not null)
            {
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 h-100">
                        <div class="d-flex justify-space-between align-center mb-2">
                            <div class="seccion-titulo">
                                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Size="Size.Small" Class="mr-1" />
                                Top 10 deudores
                            </div>
                            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => NavigationManagerService.NavigateTo("estadisticas"))">
                                Ver estadísticas
                            </MudButton>
                        </div>
                        <MudTable Items="_ranking.Filas.Take(10)" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Elevation="0"
                                  T="ReporteRankingDeudoresFila">
                            <HeaderContent>
                                <MudTh>#</MudTh>
                                <MudTh>Cliente</MudTh>
                                <MudTh>Zona</MudTh>
                                <MudTh Style="text-align:right;">Días</MudTh>
                                <MudTh Style="text-align:right;">Saldo</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="#"><b>@context.Posicion</b></MudTd>
                                <MudTd DataLabel="Cliente">@context.Cliente</MudTd>
                                <MudTd DataLabel="Zona">@(string.IsNullOrWhiteSpace(context.Zona) ? "—" : context.Zona)</MudTd>
                                <MudTd DataLabel="Días" Style="text-align:right;">@context.DiasTranscurridos</MudTd>
                                <MudTd DataLabel="Saldo" Style="text-align:right;"><b class="txt-rojo">@context.SaldoPendiente.ToString("C2")</b></MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <div class="pa-3 text-center">Sin deudores para los filtros seleccionados.</div>
                            </NoRecordsContent>
                        </MudTable>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }

    <!-- ===================== Tabla de resumen ===================== -->
    <MudPaper Elevation="0" Outlined="true" Class="pa-3 mt-1">
        <div class="seccion-titulo mb-2">
            <MudIcon Icon="@Icons.Material.Filled.TableChart" Size="Size.Small" Class="mr-1" />
            Resumen por zona, vendedor y cobrador
        </div>
        <MudTable Items="_resumen" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Elevation="0" T="FilaResumen">
            <HeaderContent>
                <MudTh>Zona</MudTh>
                <MudTh>Vendedor</MudTh>
                <MudTh>Cobrador</MudTh>
                <MudTh Style="text-align:right;">Total vendido</MudTh>
                <MudTh Style="text-align:right;">Total cobrado</MudTh>
                <MudTh Style="text-align:right;">Saldo pendiente</MudTh>
                <MudTh Style="text-align:center;">% recuperación</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Zona"><b>@context.Zona</b></MudTd>
                <MudTd DataLabel="Vendedor">@context.Vendedor</MudTd>
                <MudTd DataLabel="Cobrador">@context.Cobrador</MudTd>
                <MudTd DataLabel="Total vendido" Style="text-align:right;">@context.TotalVendido.ToString("C2")</MudTd>
                <MudTd DataLabel="Total cobrado" Style="text-align:right;">@context.TotalCobrado.ToString("C2")</MudTd>
                <MudTd DataLabel="Saldo pendiente" Style="text-align:right;">
                    <b class="@(context.Saldo > 0 ? "txt-rojo" : "txt-verde")">@context.Saldo.ToString("C2")</b>
                </MudTd>
                <MudTd DataLabel="% recuperación" Style="text-align:center;">
                    <div class="recuperacion-celda">
                        <MudProgressLinear Value="@((double)context.Recuperacion)" Color="@ColorRecuperacion(context.Recuperacion)"
                                           Rounded="true" Class="recuperacion-barra" />
                        <span class="recuperacion-texto">@context.Recuperacion.ToString("0.#")%</span>
                    </div>
                </MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTFootRow>
                    <MudTd colspan="3"><b>Totales</b></MudTd>
                    <MudTd Style="text-align:right;"><b>@_resumen.Sum(r => r.TotalVendido).ToString("C2")</b></MudTd>
                    <MudTd Style="text-align:right;"><b>@_resumen.Sum(r => r.TotalCobrado).ToString("C2")</b></MudTd>
                    <MudTd Style="text-align:right;"><b class="txt-rojo">@_resumen.Sum(r => r.Saldo).ToString("C2")</b></MudTd>
                    <MudTd Style="text-align:center;"><b>@PromedioRecuperacion.ToString("0.#")%</b></MudTd>
                </MudTFootRow>
            </FooterContent>
        </MudTable>
    </MudPaper>

</div>

@{
    // Tarjeta KPI reutilizable (icono + valor + subtítulo), con clase de color.
    RenderFragment Kpi(string titulo, string valor, string icono, string clase, string subtitulo) => __builder =>
    {
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="@($"kpi-card {clase}")">
                <div class="kpi-icono"><MudIcon Icon="@icono" Size="Size.Large" /></div>
                <div class="kpi-cuerpo">
                    <div class="kpi-titulo">@titulo</div>
                    <div class="kpi-valor">@valor</div>
                    <div class="kpi-sub">@subtitulo</div>
                </div>
            </MudPaper>
        </MudItem>
    };

    // Leyenda de zonas bajo cada gráfica de barras: muestra el color (igual al de la barra),
    // el nombre de la zona y su monto, para que cada barra quede identificada aunque el eje
    // recorte las etiquetas largas.
    RenderFragment LeyendaZonas(IReadOnlyList<DashboardSerieZona>? series, string[]? paleta = null) => __builder =>
    {
        if (series is null || series.Count == 0) return;

        <div class="leyenda-zonas">
            @for (var i = 0; i < series.Count; i++)
            {
                var s = series[i];
                var colores = paleta ?? _paletaZonas;
                var color = colores[i % colores.Length];
                <div class="leyenda-item">
                    <span class="leyenda-color" style="@($"background:{color};")"></span>
                    <span class="leyenda-nombre">@s.Zona</span>
                    <span class="leyenda-monto">@s.Monto.ToString("C2")</span>
                </div>
            }
        </div>
    };
}

<style>
    .dashboard { padding: 4px; }

    .dash-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }
    .dash-titulo { font-weight: 800; }

    .seccion-titulo {
        font-weight: 700;
        display: flex;
        align-items: center;
        font-size: 0.95rem;
        color: var(--mud-palette-primary);
    }

    /* Cabecera de filtros: clicable para colapsar/expandir. */
    .filtros-header {
        justify-content: space-between;
        cursor: pointer;
        user-select: none;
    }

    /* El botón "Aplicar" toma el mismo alto que los inputs outlined (56px). */
    .boton-aplicar {
        height: 56px;
    }

    .h-100 { height: 100%; }

    /* ---------- Tarjetas KPI ---------- */
    .kpi-card {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px;
        border-radius: 14px;
        color: #fff;
        min-height: 104px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.12);
    }
    .kpi-icono {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 52px; height: 52px;
        border-radius: 12px;
        background: rgba(255,255,255,0.18);
    }
    .kpi-cuerpo { display: flex; flex-direction: column; line-height: 1.15; }
    .kpi-titulo { font-size: 0.8rem; opacity: 0.92; }
    .kpi-valor { font-size: 1.5rem; font-weight: 800; }
    .kpi-sub { font-size: 0.72rem; opacity: 0.85; margin-top: 2px; }

    /* Degradados tomados de la paleta del tema: si cambia el color del sistema, las tarjetas lo siguen. */
    .kpi-azul   { background: linear-gradient(135deg, var(--mud-palette-primary) 0%, var(--mud-palette-primary-darken) 100%); }
    .kpi-verde  { background: linear-gradient(135deg, var(--mud-palette-success) 0%, var(--mud-palette-success-darken) 100%); }
    .kpi-ambar  { background: linear-gradient(135deg, var(--mud-palette-secondary) 0%, var(--mud-palette-secondary-darken) 100%); }
    .kpi-rojo   { background: linear-gradient(135deg, var(--mud-palette-error) 0%, var(--mud-palette-error-darken) 100%); }
    .kpi-morado { background: linear-gradient(135deg, #5B6ABF 0%, #434F97 100%); }

    /* ---------- Tabla ---------- */
    .txt-rojo { color: var(--mud-palette-error); }
    .txt-verde { color: var(--mud-palette-success); }

    .recuperacion-celda {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 140px;
    }
    .recuperacion-barra { flex: 1; height: 8px; }
    .recuperacion-texto { font-size: 0.78rem; font-weight: 700; min-width: 42px; text-align: right; }

    /* ---------- Leyenda de zonas bajo las gráficas de barras ---------- */
    .leyenda-zonas {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 16px;
        margin-top: 10px;
        padding-top: 10px;
        border-top: 1px solid var(--mud-palette-divider);
    }
    .leyenda-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.8rem;
    }
    .leyenda-color {
        width: 12px;
        height: 12px;
        border-radius: 3px;
        flex-shrink: 0;
    }
    .leyenda-nombre { color: var(--mud-palette-text-primary); }
    .leyenda-monto { font-weight: 700; color: var(--mud-palette-text-secondary); }
</style>

@code {
    // ===================== Estado de filtros =====================
    private DateTime? _desde = FechaProyecto.Hoy.AddDays(-30);
    private DateTime? _hasta = FechaProyecto.Hoy;
    private long? _idZona;
    private bool _filtrosAbiertos = false;

    private bool _cargando;

    // Catálogo de zonas (combo de filtro).
    private List<ZonaDto> _zonas = new();

    // ===================== Datos del dashboard =====================
    private DashboardResponse? _datos;

    // KPIs presentables (con fallback a ceros mientras carga).
    private KpisVista _kpis = KpisVista.Vacio;

    // Gráfica: ventas por zona (barras).
    private List<ChartSeries<double>> _serieVentasZona = new()
    {
        new ChartSeries<double> { Name = "Ventas", Data = Array.Empty<double>() }
    };

    // Gráfica: cobranza por zona (barras).
    private List<ChartSeries<double>> _serieCobranzaZona = new()
    {
        new ChartSeries<double> { Name = "Cobrado", Data = Array.Empty<double>() }
    };

    // Gráfica: cobranza por día (línea).
    private List<ChartSeries<double>> _serieCobranzaDia = new()
    {
        new ChartSeries<double> { Name = "Cobrado", Data = Array.Empty<double>() }
    };

    private string[] _zonasArray = Array.Empty<string>();         // etiquetas de la gráfica de ventas por zona
    private string[] _zonasCobranzaArray = Array.Empty<string>(); // etiquetas de la gráfica de cobranza por zona
    private string[] _diasArray = Array.Empty<string>();

    // Paleta compartida entre las barras y la leyenda de zonas (mismos colores).
    private static readonly string[] _paletaZonas =
        { "#2F7D5C", "#C99A3E", "#5B6ABF", "#3BA776", "#B5862F" };

    private readonly ChartOptions _opcionesBarras = new()
    {
        ShowLegend = false,
        ShowToolTips = true,
        ChartPalette = _paletaZonas
    };

    private readonly ChartOptions _opcionesLinea = new()
    {
        ShowLegend = false,
        ShowToolTips = true,
        ChartPalette = new[] { "#2F7D5C", "#C99A3E" }
    };

    // ===================== Indicadores ejecutivos (derivados de seguimiento) =====================
    private ReporteDashboardEjecutivoResponse? _ejecutivo;
    private ReporteAntiguedadResponse? _antiguedad;
    private ReporteRankingDeudoresResponse? _ranking;
    private int _diasGraciaAlerta = 3;
    private const string ClaveGraciaAlerta = "SEGUIMIENTO_DIAS_GRACIA_ALERTA";

    private List<ChartSeries<double>> _serieAntiguedad = new()
    {
        new ChartSeries<double> { Name = "Saldo", Data = Array.Empty<double>() }
    };
    private string[] _rangosArray = Array.Empty<string>();

    // De verde (al corriente) a rojo (más de 60 días); se comparte entre las barras y la leyenda.
    private static readonly string[] _paletaAntiguedad =
        { "#3BA776", "#5B6ABF", "#C99A3E", "#D9534F", "#A52A2A" };

    private readonly ChartOptions _opcionesAntiguedad = new()
    {
        ShowLegend = false,
        ShowToolTips = true,
        ChartPalette = _paletaAntiguedad
    };

    // Tabla resumen (proyección de DashboardResumenFila para la vista).
    private sealed record FilaResumen(string Zona, string Vendedor, string Cobrador,
        decimal TotalVendido, decimal TotalCobrado, decimal Saldo, decimal Recuperacion);

    private List<FilaResumen> _resumen = new();

    private decimal PromedioRecuperacion =>
        _resumen.Count == 0 ? 0 : Math.Round(_resumen.Average(r => r.Recuperacion), 1);

    private static Color ColorRecuperacion(decimal pct) =>
        pct >= 80 ? Color.Success : pct >= 70 ? Color.Warning : Color.Error;

    // ===================== Ciclo de vida =====================

    protected override async Task OnInitializedAsync()
    {
        await ApiClienteService.CargarSesionDesdeAlmacenamientoAsync();
        if (!ApiClienteService.Autenticado)
        {
            NavigationManagerService.NavigateTo("/login");
            return;
        }

        await CargarZonasAsync();
        await CargarDiasGraciaAsync();
        await GenerarAsync();
    }

    // Carga suave del combo de zonas; si falla, el combo queda vacío (se puede filtrar igual por "Todas").
    private async Task CargarZonasAsync()
    {
        var (datos, _) = await ApiClienteService.ListarZonasOperativasAsync();
        _zonas = datos ?? new();
    }

    // Lee los días de gracia del semáforo de seguimiento (Parámetros del Sistema) para definir clientes críticos.
    private async Task CargarDiasGraciaAsync()
    {
        var (lista, error) = await ApiClienteService.ListarParametrosAsync();
        if (error is not null || lista is null) return;
        var p = lista.FirstOrDefault(x => string.Equals(x.Clave, ClaveGraciaAlerta, StringComparison.OrdinalIgnoreCase));
        if (p?.ValorNumerico is { } n) _diasGraciaAlerta = (int)Math.Max(0, Math.Round(n));
        else if (int.TryParse(p?.ValorTexto?.Trim(), out var v)) _diasGraciaAlerta = Math.Max(0, v);
    }

    // ===================== Generación =====================

    private async Task GenerarAsync()
    {
        if (_cargando) return;
        _cargando = true;
        try
        {
            // Los reportes ejecutivos se piden en paralelo; si alguno falla, solo se oculta su sección.
            var tEjecutivo = ApiClienteService.ReporteDashboardEjecutivoAsync(ADesde(_desde), AHasta(_hasta), _idZona, _diasGraciaAlerta);
            var tAntiguedad = ApiClienteService.ReporteAntiguedadSaldosAsync(_idZona);
            var tRanking = ApiClienteService.ReporteRankingDeudoresAsync(_idZona);

            var (datos, error) = await ApiClienteService.DashboardAsync(ADesde(_desde), AHasta(_hasta), _idZona);
            if (error is not null)
            {
                Snackbar.Add(error, Severity.Error);
                return;
            }

            _datos = datos;
            Mapear();

            await Task.WhenAll(tEjecutivo, tAntiguedad, tRanking);
            _ejecutivo = (await tEjecutivo).datos;
            _antiguedad = (await tAntiguedad).datos;
            _ranking = (await tRanking).datos;
            MapearEjecutivos();
        }
        finally
        {
            _cargando = false;
        }
    }

    // Traduce la respuesta del backend a las estructuras que consumen las gráficas y la tabla.
    private void Mapear()
    {
        if (_datos is null) return;

        // KPIs
        var recuperacionGlobal = _datos.Kpis.VentasTotales > 0
            ? _datos.Kpis.TotalCobrado / _datos.Kpis.VentasTotales * 100m
            : 0m;
        _kpis = new KpisVista(
            _datos.Kpis.VentasTotales,
            _datos.Kpis.TotalCobrado,
            _datos.Kpis.SaldoPorCobrar,
            _datos.Kpis.CobradoHoy,
            _datos.Kpis.CuentasConSaldo,
            _datos.Kpis.PagosHoy,
            recuperacionGlobal < 0 ? 0m : recuperacionGlobal);

        // Ventas por zona
        _zonasArray = _datos.VentasPorZona.Select(z => z.Zona).ToArray();
        _serieVentasZona = new()
        {
            new ChartSeries<double>
            {
                Name = "Ventas",
                Data = _datos.VentasPorZona.Select(z => (double)z.Monto).ToArray()
            }
        };

        // Cobranza por zona
        _zonasCobranzaArray = _datos.CobranzaPorZona.Select(z => z.Zona).ToArray();
        _serieCobranzaZona = new()
        {
            new ChartSeries<double>
            {
                Name = "Cobrado",
                Data = _datos.CobranzaPorZona.Select(z => (double)z.Monto).ToArray()
            }
        };

        // Cobranza por día
        _diasArray = _datos.CobranzaPorDia
            .Select(d => d.Dia.EnZonaProyecto().DateTime.ToString("dd/MM"))
            .ToArray();
        _serieCobranzaDia = new()
        {
            new ChartSeries<double>
            {
                Name = "Cobrado",
                Data = _datos.CobranzaPorDia.Select(d => (double)d.Monto).ToArray()
            }
        };

        // Tabla resumen
        _resumen = _datos.Resumen.Select(r => new FilaResumen(
            r.Zona,
            string.IsNullOrWhiteSpace(r.Vendedor) ? "—" : r.Vendedor!,
            string.IsNullOrWhiteSpace(r.Cobrador) ? "—" : r.Cobrador!,
            r.TotalVendido,
            r.TotalCobrado,
            r.SaldoPendiente,
            r.PorcentajeRecuperacion)).ToList();
    }

    // Gráfica de antigüedad de saldos (saldo por rango de días).
    private void MapearEjecutivos()
    {
        if (_antiguedad is null) return;
        _rangosArray = _antiguedad.Rangos.Select(r => r.Rango).ToArray();
        _serieAntiguedad = new()
        {
            new ChartSeries<double>
            {
                Name = "Saldo",
                Data = _antiguedad.Rangos.Select(r => (double)r.SaldoPendiente).ToArray()
            }
        };
    }

    // ===================== Helpers =====================

    // Convierte la fecha del date picker a un DateTimeOffset en la zona del proyecto.
    private static DateTimeOffset? ADesde(DateTime? d) => d is { } v ? FechaProyecto.DesdeFechaLocal(v.Date) : null;
    private static DateTimeOffset? AHasta(DateTime? d) => d is { } v ? FechaProyecto.DesdeFechaLocal(v.Date) : null;

    private sealed record KpisVista(
        decimal VentasTotales,
        decimal TotalCobrado,
        decimal SaldoPorCobrar,
        decimal CobradoHoy,
        int CuentasConSaldo,
        int PagosHoy,
        decimal PorcentajeRecuperacionGlobal)
    {
        public static readonly KpisVista Vacio = new(0, 0, 0, 0, 0, 0, 0);
    }
}
