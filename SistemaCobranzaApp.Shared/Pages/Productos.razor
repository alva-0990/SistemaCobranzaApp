    // ===================== Helpers de diálogo =====================

    private async Task<DialogoProducto.FormModel?> MostrarDialogoProducto(
        string titulo, string icono, bool esNuevo, DialogoProducto.FormModel modelo)
    {
        var (comisiones, error) = await Api.ListarComisionesOperativasAsync();
        if (error is not null)
        {
            _snackbar.Add(error, Severity.Error);
            return null;
        }
        _comisionesCombo = comisiones?.Where(c => c.Activo).ToList() ?? new();
        if (_comisionesCombo.Count == 0 && (esNuevo || modelo.IdCatalogoComision is null))
        {
            _snackbar.Add("Registra un esquema de comisión activo en Operaciones de ventas antes de guardar el producto.", Severity.Warning);
            return null;
        }

        // En móvil el alta/edición de producto ocupa toda la pantalla; en web es un modal normal.
        var opciones = EsEntornoMovil
            ? new DialogOptions { FullScreen = true, CloseButton = true }
            : new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var parametros = new DialogParameters<DialogoProducto>
        {
            { x => x.Titulo, titulo },
            { x => x.Icono, icono },
            { x => x.EsNuevo, esNuevo },
            { x => x.Modelo, modelo },
            { x => x.ClaseDialogo, EsEntornoMovil ? "dialogo-producto-fullscreen" : null },
            { x => x.Categorias, _categoriasCombo },
            { x => x.Marcas, _marcasCombo },
            { x => x.Colores, _coloresCombo },
            { x => x.Tallas, _tallasCombo },
            { x => x.Comisiones, _comisionesCombo }
        };
        var dialogo = await _dialogo.ShowAsync<DialogoProducto>(titulo, parametros, opciones);
        var resultado = await dialogo.Result;
        return resultado is { Canceled: false, Data: DialogoProducto.FormModel datos } ? datos : null;
    }

    private async Task<DialogoGenerico.FormModel?> MostrarDialogoGenerico(
        string titulo, string icono, string labelNombre, DialogoGenerico.FormModel modelo)
