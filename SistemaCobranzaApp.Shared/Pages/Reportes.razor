    // ===================== Helpers =====================

    // Convierte la fecha del date picker a un DateTimeOffset (inicio del día local).
    private static DateTimeOffset? ADesde(DateTime? d) => d is { } v ? FechaProyecto.DesdeFechaLocal(v.Date) : null;

    // Fin del día: el servidor normaliza el rango, así que basta con la fecha seleccionada.
    private static DateTimeOffset? AHasta(DateTime? d) => d is { } v ? FechaProyecto.DesdeFechaLocal(v.Date) : null;

    private static string Mostrar(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v!;

    private static string FechaCorta(DateTimeOffset? d)
        => d is { } v ? v.EnZonaProyecto().DateTime.ToString("dd/MM/yyyy") : "—";

    private static string FechaHora(DateTimeOffset d)
        => d.EnZonaProyecto().DateTime.ToString("dd/MM/yyyy HH:mm");

