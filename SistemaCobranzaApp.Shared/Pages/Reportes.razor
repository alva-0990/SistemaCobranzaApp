            ["Movimiento"] = _movimientos.FirstOrDefault(x => x.Id == _pagMovimiento)?.Descripcion ?? "Todos"
        },
        [
            Kpi("Pagos", p.Total.ToString()),
            Kpi("Monto total", p.MontoTotal.ToString("C2")),
            Kpi("Pago promedio", p.Total > 0 ? (p.MontoTotal / p.Total).ToString("C2") : "$0.00")
        ],
        ["Pago", "Folio", "Venta", "Cliente", "Producto", "Cobrador", "Movimiento", "Total de venta", "Abono", "Saldo actual", "Fecha"],
        p.Filas.Select(f => new object?[] { f.IdPago, f.FolioPago, f.IdVenta, f.Cliente, f.Productos, f.Cobrador,
            f.Movimiento, f.TotalVenta, f.MontoAbona, f.SaldoActual, FechaHora(f.FechaPago) }),
        [9]); // Solo se suma el abono; sumar totales/saldos de venta por pago no tiene sentido.

