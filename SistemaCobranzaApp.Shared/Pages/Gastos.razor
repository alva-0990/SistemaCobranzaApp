    protected override async Task OnInitializedAsync()
    {
        await CargarCatalogos();
        await CargarGastos();
        await CargarCuentas();
        await CargarCategorias();
    }

    private async Task CargarCatalogos()
    {
        var (zonas, _) = await Api.ListarZonasOperativasAsync();
        _zonas = zonas ?? new();
        var (cob, _) = await Api.ListarCobradoresOperativosAsync();
        _cobradores = cob ?? new();
        var (ven, _) = await Api.ListarVendedoresOperativosAsync();
        _vendedores = ven ?? new();
        var (cats, _) = await Api.ListarCategoriasGastoAsync(incluirInactivas: false);
        _categoriasActivas = cats ?? new();
    }

    // ===================== GASTOS =====================

    private async Task CargarGastos()
    {
        _cargandoGastos = true;
        DateTimeOffset? desde = _fDesde is { } d ? FechaProyecto.DesdeFechaLocal(d) : null;
        DateTimeOffset? hasta = _fHasta is { } h ? FechaProyecto.DesdeFechaLocal(h.Date.AddDays(1)).AddTicks(-1) : null;
        var (datos, error) = await Api.ListarGastosAsync(
            desde: desde, hasta: hasta,
            estatus: _fEstatus, idZona: _fZona,
            folio: string.IsNullOrWhiteSpace(_fFolio) ? null : _fFolio);
        _cargandoGastos = false;
        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        _gastos = datos ?? new();
    }

    // Handlers de filtros: cada cambio recarga la lista automáticamente.
    private async Task OnFolioChanged(string? v) { _fFolio = v; await CargarGastos(); }
    private async Task OnEstatusChanged(string? v) { _fEstatus = v; await CargarGastos(); }
    private async Task OnZonaChanged(long? v) { _fZona = v; await CargarGastos(); }
    private async Task OnDesdeChanged(DateTime? v) { _fDesde = v; await CargarGastos(); }
    private async Task OnHastaChanged(DateTime? v) { _fHasta = v; await CargarGastos(); }

    private async Task CrearGasto()
    {
        if (_nvCategoria is null) { _snackbar.Add("Selecciona una categoría.", Severity.Warning); return; }
        if (string.IsNullOrWhiteSpace(_nvConcepto)) { _snackbar.Add("El concepto es obligatorio.", Severity.Warning); return; }
        if (_nvImporte <= 0) { _snackbar.Add("El importe debe ser mayor que cero.", Severity.Warning); return; }

        _guardandoGasto = true;
        var req = new CrearGastoRequest(
            _nvCategoria.Value,
            FechaProyecto.DesdeFechaLocal(_nvFecha ?? FechaProyecto.Hoy),
            _nvConcepto.Trim(),
            _nvImporte,
            null,
            string.IsNullOrWhiteSpace(_nvProveedor) ? null : _nvProveedor.Trim(),
            null,
            null,
            _nvZona,
            _nvCobrador,
            _nvVendedor,
            _nvCuenta,
            string.IsNullOrWhiteSpace(_nvObservaciones) ? null : _nvObservaciones.Trim());

        var (datos, error) = await Api.CrearGastoAsync(req);
        _guardandoGasto = false;
        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }

        _snackbar.Add($"Gasto {datos?.FolioGasto} registrado.", Severity.Success);
        LimpiarNuevoGasto();
        await CargarGastos();
    }

    private void LimpiarNuevoGasto()
    {
        _nvCategoria = null;
        _nvFecha = FechaProyecto.Hoy;
        _nvConcepto = "";
        _nvImporte = 0;
        _nvProveedor = null;
        _nvZona = _nvCobrador = _nvVendedor = null;
        _nvCuenta = null;
        _nvObservaciones = null;
    }

    private async Task AutorizarGasto(GastoDto g)
    {
        var ok = await ConfirmarDialogo("Autorizar gasto",
            $"¿Autorizar el gasto {g.FolioGasto} por {g.Importe:C2}?", "Autorizar", Color.Success);
        if (!ok) return;

        var (_, error) = await Api.AutorizarGastoAsync(g.IdGasto);
        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        _snackbar.Add("Gasto autorizado.", Severity.Success);
        await CargarGastos();
    }

    private async Task CancelarGasto(GastoDto g)
    {
        var motivo = await PedirTexto("Cancelar gasto",
            $"Motivo de cancelación del gasto {g.FolioGasto}:");
        if (string.IsNullOrWhiteSpace(motivo)) return;

        var (_, error) = await Api.CancelarGastoAsync(g.IdGasto,
            new CancelarGastoRequest(IdUsuarioActual ?? 0, motivo.Trim()));
        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        _snackbar.Add("Gasto cancelado.", Severity.Success);
        await CargarGastos();
    }

    private static bool PuedePagar(GastoDto g)
        => g.Estatus is "AUTORIZADO" or "PARCIAL" && g.SaldoPendiente > 0;

    private decimal? SaldoCuentaPrevista()
        => _nvCuenta is { } id
            ? _cuentas.FirstOrDefault(c => c.IdCuentaGasto == id)?.SaldoActual
            : null;

    private bool CuentaPrevistaInsuficiente()
        => _nvCuenta is not null && _nvImporte > 0
           && SaldoCuentaPrevista() is { } saldo && saldo < _nvImporte;

    private async Task AbrirPago(GastoDto g)
    {
        if (_cuentas.Count == 0) await CargarCuentas();
        var activas = _cuentas.Where(c => c.Activo).ToList();
        if (activas.Count == 0) { _snackbar.Add("No hay cuentas activas para pagar.", Severity.Warning); return; }

        var dialogo = await _dialogo.ShowAsync<DialogoPagoGasto>("Registrar pago",
            new DialogParameters<DialogoPagoGasto>
            {
                { x => x.Folio, g.FolioGasto },
                { x => x.SaldoPendiente, g.SaldoPendiente },
                { x => x.Cuentas, activas }
            },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var r = await dialogo.Result;
        if (r is not { Canceled: false, Data: DialogoPagoGasto.Resultado d }) return;

        var req = new RegistrarGastoPagoRequest(d.IdCuenta, d.Importe, d.FormaPago,
            null, d.Referencia, d.Observaciones);
        var (_, error) = await Api.RegistrarPagoGastoAsync(g.IdGasto, req);
        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        _snackbar.Add("Pago aplicado correctamente.", Severity.Success);
        await CargarGastos();
        await CargarCuentas();
    }

    private static string Clasificacion(GastoDto g)
    {
        if (!string.IsNullOrWhiteSpace(g.NombreZona)
            || !string.IsNullOrWhiteSpace(g.NombreCobrador)
            || !string.IsNullOrWhiteSpace(g.NombreVendedor))
        {
            var partes = new List<string>();
            if (!string.IsNullOrWhiteSpace(g.NombreZona)) partes.Add($"Zona: {g.NombreZona}");
            if (!string.IsNullOrWhiteSpace(g.NombreCobrador)) partes.Add($"Cob: {g.NombreCobrador}");
            if (!string.IsNullOrWhiteSpace(g.NombreVendedor)) partes.Add($"Vend: {g.NombreVendedor}");
            return string.Join(" · ", partes);
        }
        return "Central";
    }

    private static Color ColorEstatus(string estatus) => estatus switch
    {
        "PENDIENTE" => Color.Warning,
        "AUTORIZADO" => Color.Info,
        "PARCIAL" => Color.Primary,
        "PAGADO" => Color.Success,
        "CANCELADO" => Color.Error,
        _ => Color.Default
    };

