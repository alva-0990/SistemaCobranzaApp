    // ===================== REPORTES =====================

    private async Task GenerarReporte()
    {
        _cargandoReporte = true;
        _repDetalle = null;
        _repAgrupado = null;

        DateTimeOffset? desde = _repDesde is { } d ? FechaProyecto.DesdeFechaLocal(d) : null;
        DateTimeOffset? hasta = _repHasta is { } h ? FechaProyecto.DesdeFechaLocal(h.Date.AddDays(1)).AddTicks(-1) : null;

        string? error;
        switch (_repAgrupacion)
        {
            case "categoria":
                (_repAgrupado, error) = await Api.ReporteGastosPorCategoriaAsync(desde, hasta);
                break;
            case "zona":
                (_repAgrupado, error) = await Api.ReporteGastosPorZonaAsync(desde, hasta);
                break;
            case "cobrador":
                (_repAgrupado, error) = await Api.ReporteGastosPorCobradorAsync(desde, hasta);
                break;
            case "vendedor":
                (_repAgrupado, error) = await Api.ReporteGastosPorVendedorAsync(desde, hasta);
                break;
            case "estatus":
                (_repAgrupado, error) = await Api.ReporteGastosPorEstatusAsync(desde, hasta);
                break;
            default:
                (_repDetalle, error) = await Api.ReporteGastosDetalleAsync(desde, hasta);
                break;
        }

        _cargandoReporte = false;
        if (error is not null) _snackbar.Add(error, Severity.Error);
    }

    // ===================== Helpers de diálogo =====================

    // ---- Búsqueda para los campos editables (estatus y cuenta prevista) ----
    private Task<IEnumerable<string>> BuscarEstatusGasto(string? valor, CancellationToken ct)
    {
        IEnumerable<string> origen = _estatusGasto;
        if (!string.IsNullOrWhiteSpace(valor))
            origen = origen.Where(e => e.Contains(valor, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(origen);
    }

    // Texto visible de una cuenta (nombre + saldo). Solo cuentas activas.
    private string TextoCuenta(long? id)
    {
        if (id is null) return string.Empty;
        var cuenta = _cuentas.FirstOrDefault(c => c.IdCuentaGasto == id.Value);
        return cuenta is null ? string.Empty : $"{cuenta.Nombre} ({cuenta.SaldoActual:C2})";
    }

    private Task<IEnumerable<long?>> BuscarCuentas(string? valor, CancellationToken ct)
    {
        IEnumerable<CuentaGastoDto> activas = _cuentas.Where(c => c.Activo);
        if (!string.IsNullOrWhiteSpace(valor))
            activas = activas.Where(c => (c.Nombre ?? string.Empty).Contains(valor, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult<IEnumerable<long?>>(activas.Select(c => (long?)c.IdCuentaGasto).ToList());
    }

    private async Task<bool> ConfirmarDialogo(string titulo, string mensaje, string textoAceptar, Color color)
    {
        var opciones = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var parametros = new DialogParameters<DialogoConfirmacion>
        {
            { x => x.Titulo, titulo },
            { x => x.Mensaje, mensaje },
            { x => x.TextoAceptar, textoAceptar },
            { x => x.ColorAceptar, color },
            { x => x.Icono, Icons.Material.Filled.CheckCircle },
            { x => x.ColorIcono, color }
        };
        var dialogo = await _dialogo.ShowAsync<DialogoConfirmacion>(titulo, parametros, opciones);
        var resultado = await dialogo.Result;
        return resultado is { Canceled: false, Data: true };
    }

    // Prompt de texto simple usando MudBlazor (MessageBox con input no existe,
    // por lo que usamos un diálogo genérico de confirmación con campo editable).
    private async Task<string?> PedirTexto(string titulo, string etiqueta, string? valorInicial = null)
    {
        var resultado = await _dialogo.ShowAsync<DialogoPromptTexto>(titulo,
            new DialogParameters<DialogoPromptTexto>
            {
                { x => x.Titulo, titulo },
                { x => x.Etiqueta, etiqueta },
                { x => x.Valor, valorInicial ?? "" }
            },
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });

        var r = await resultado.Result;
        return r is { Canceled: false, Data: string s } ? s : null;
    }
