        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "pa-3 text-center");
        builder.OpenComponent<MudText>(2);
        builder.AddAttribute(3, "Color", Color.Secondary);
        builder.AddAttribute(4, "Typo", Typo.body2);
        builder.AddAttribute(5, "ChildContent", (RenderFragment)(b => b.AddContent(0, "No hay datos para los filtros seleccionados.")));
