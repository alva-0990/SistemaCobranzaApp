@page "/gastos"

@using MudBlazor
@using SistemaCobranzaApp.Shared.Components
@using SistemaCobranzaApp.Shared.Dtos
@using SistemaCobranzaApp.Shared.Services
@inject ApiCliente Api
@inject IDescargaArchivo Descarga
@inject EstadoEmpresaGlobal EmpresaGlobal
@inject IFormFactor _formFactor
@inject IDialogService _dialogo
@inject ISnackbar _snackbar

<MudTabs Elevation="2" Rounded="true" Color="Color.Primary" ApplyEffectsToContainer="true"
         PanelClass="pa-0 pt-4" SliderColor="Color.Warning" Class="ma-2 tabs-remarcados">

    <!-- ============================================================= -->
    <!-- ========================== GASTOS =========================== -->
    <!-- ============================================================= -->
    <MudTabPanel Text="Gastos" Icon="@Icons.Material.Filled.ReceiptLong">
        <MudPaper Elevation="0" Class="pa-4">

            <div class="encabezado-seccion mb-4">
                <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Primary" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.h6" Class="titulo-seccion">Registro y administración de gastos</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Registre gastos, autorícelos, cancélelos y aplique pagos. Clasifique por zona,
                        cobrador, vendedor o déjelos como gasto central (sin responsable operativo).
                    </MudText>
                </div>
            </div>

            <MudGrid Spacing="3">
                <!-- Panel izquierdo: alta de gasto -->
                <MudItem xs="12" md="4" lg="3">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 panel-accion">
                        <div class="d-flex align-center gap-2 mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.AddCircle" Color="Color.Primary" />
                            <MudText Typo="Typo.subtitle1"><b>Nuevo gasto</b></MudText>
                        </div>

                        <AutocompletarCatalogo TItem="CatalogoCategoriaGastoDto" Label="Categoría" Class="mb-3"
                                               Placeholder="Busca una categoría..."
                                               @bind-Value="_nvCategoria"
                                               Items="_categoriasActivas"
                                               ObtenerId="@(c => c.IdCategoriaGasto)"
                                               ObtenerTexto="@(c => c.Nombre)" />

                        <MudDatePicker Label="Fecha del gasto" @bind-Date="_nvFecha"
                                       Variant="Variant.Outlined" Class="mb-3" />

                        <MudTextField T="string" @bind-Value="_nvConcepto" Label="Concepto"
                                      Variant="Variant.Outlined" Dense="true" Class="mb-3" MaxLength="250" />

                        <MudNumericField T="decimal" @bind-Value="_nvImporte" Label="Importe"
                                         Variant="Variant.Outlined" Dense="true" Min="0" Class="mb-3"
                                         Format="N2" Culture="@System.Globalization.CultureInfo.CurrentCulture" />

                        <MudTextField T="string" @bind-Value="_nvProveedor" Label="Proveedor (opcional)"
                                      Variant="Variant.Outlined" Dense="true" Class="mb-3" MaxLength="200" />

                        <AutocompletarCatalogo TItem="ZonaDto" Label="Zona (vacío = central)" Class="mb-3"
                                               Placeholder="Busca una zona..."
                                               @bind-Value="_nvZona"
                                               Items="_zonas"
                                               ObtenerId="@(z => z.IdZona)"
                                               ObtenerTexto="@(z => z.Descripcion)" />

                        <AutocompletarCatalogo TItem="CobradorDto" Label="Cobrador (opcional)" Class="mb-3"
                                               Placeholder="Busca un cobrador..."
                                               @bind-Value="_nvCobrador"
                                               Items="_cobradores"
                                               ObtenerId="@(p => p.IdCobrador)"
                                               ObtenerTexto="@(p => p.Nombre)" />

                        <AutocompletarCatalogo TItem="VendedorDto" Label="Vendedor (opcional)" Class="mb-3"
                                               Placeholder="Busca un vendedor..."
                                               @bind-Value="_nvVendedor"
                                               Items="_vendedores"
                                               ObtenerId="@(p => p.IdVendedor)"
                                               ObtenerTexto="@(p => p.Nombre)" />

                        <MudAutocomplete T="long?" Label="Cuenta prevista (de dónde saldrá)" @bind-Value="_nvCuenta"
                                         SearchFunc="BuscarCuentas" ToStringFunc="TextoCuenta"
                                         Variant="Variant.Outlined" Dense="true" Clearable="true" Class="mb-3"
                                         ResetValueOnEmptyText="true" CoerceText="true"
                                         Placeholder="Busca una cuenta...">
                            <ItemTemplate Context="id">@TextoCuenta(id)</ItemTemplate>
                            <NoItemsTemplate>
                                <MudText Align="Align.Center" Class="px-4 py-1">Sin coincidencias.</MudText>
                            </NoItemsTemplate>
                        </MudAutocomplete>

                        @if (CuentaPrevistaInsuficiente())
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                                El saldo de la cuenta prevista (@(SaldoCuentaPrevista()?.ToString("C2")))
                                es menor al importe del gasto. Podrás registrarlo, pero el pago no podrá
                                exceder el saldo disponible al momento de pagar.
                            </MudAlert>
                        }

                        <MudTextField T="string" @bind-Value="_nvObservaciones" Label="Observaciones (opcional)"
                                      Variant="Variant.Outlined" Lines="2" Dense="true" Class="mb-3" />

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.Save" Class="mb-2"
                                   Disabled="@_guardandoGasto" OnClick="CrearGasto">
                            @(_guardandoGasto ? "Guardando..." : "Registrar gasto")
                        </MudButton>
                    </MudPaper>
                </MudItem>

                <!-- Tabla derecha: listado de gastos con filtros -->
                <MudItem xs="12" md="8" lg="9">
                    <div class="filtros-gastos mb-3">
                        <MudTextField T="string" Value="_fFolio" ValueChanged="OnFolioChanged"
                                      DebounceInterval="400" Immediate="true"
                                      Placeholder="Folio..." Label="Folio" Variant="Variant.Outlined"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                      Clearable="true" Class="f-item" />
                        <MudAutocomplete T="string" Value="_fEstatus" ValueChanged="OnEstatusChanged" Label="Estatus"
                                         SearchFunc="BuscarEstatusGasto"
                                         Variant="Variant.Outlined" Clearable="true" Class="f-item"
                                         ResetValueOnEmptyText="true" CoerceText="true" Placeholder="Todos">
                            <ItemTemplate Context="e">@e</ItemTemplate>
                        </MudAutocomplete>
                        <AutocompletarCatalogo TItem="ZonaDto" Label="Zona" Placeholder="Todas" Class="f-item"
                                               Value="_fZona" ValueChanged="OnZonaChanged"
                                               Items="_zonas"
                                               ObtenerId="@(z => z.IdZona)"
                                               ObtenerTexto="@(z => z.Descripcion)" />
                        <MudDatePicker Date="_fDesde" DateChanged="OnDesdeChanged" Label="Desde"
                                       Variant="Variant.Outlined" Clearable="true" Class="f-item" />
                        <MudDatePicker Date="_fHasta" DateChanged="OnHastaChanged" Label="Hasta"
                                       Variant="Variant.Outlined" Clearable="true" Class="f-item" />
                    </div>

                    @if (_cargandoGastos)
                    {
                        <div class="d-flex justify-center pa-8"><MudProgressCircular Indeterminate="true" /></div>
                    }
                    else
                    {
                        <MudTextField T="string" @bind-Value="_busquedaGastos" Immediate="true"
                                      Placeholder="Buscar por folio, categoría, concepto, clasificación o estatus…"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Class="mb-3" />
                        <MudTable Items="_gastos" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm"
                                  Elevation="0" RowsPerPage="20" T="GastoDto" Class="tabla-seguimiento"
                                  Filter="new Func<GastoDto, bool>(FiltrarGastos)">
                            <HeaderContent>
                                <MudTh><MudTableSortLabel SortBy="new Func<GastoDto, object>(x => x.FolioGasto ?? string.Empty)">Folio</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<GastoDto, object>(x => x.FechaGasto)">Fecha</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<GastoDto, object>(x => x.NombreCategoria ?? string.Empty)">Categoría</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<GastoDto, object>(x => x.Concepto ?? string.Empty)">Concepto</MudTableSortLabel></MudTh>
                                <MudTh Style="text-align:right;"><MudTableSortLabel SortBy="new Func<GastoDto, object>(x => x.Importe)">Importe</MudTableSortLabel></MudTh>
                                <MudTh Style="text-align:right;"><MudTableSortLabel SortBy="new Func<GastoDto, object>(x => x.TotalPagado)">Pagado</MudTableSortLabel></MudTh>
                                <MudTh Style="text-align:right;"><MudTableSortLabel SortBy="new Func<GastoDto, object>(x => x.SaldoPendiente)">Saldo</MudTableSortLabel></MudTh>
                                <MudTh>Clasificación</MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<GastoDto, object>(x => x.NombreCuentaPrevista ?? string.Empty)">Cuenta prevista</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<GastoDto, object>(x => x.Estatus ?? string.Empty)">Estatus</MudTableSortLabel></MudTh>
                                <MudTh>Acciones</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Folio"><b>@Mostrar(context.FolioGasto)</b></MudTd>
                                <MudTd DataLabel="Fecha">@context.FechaGasto.EnZonaProyecto().DateTime.ToString("dd/MM/yyyy")</MudTd>
                                <MudTd DataLabel="Categoría">@Mostrar(context.NombreCategoria)</MudTd>
                                <MudTd DataLabel="Concepto">@Mostrar(context.Concepto)</MudTd>
                                <MudTd DataLabel="Importe" Style="text-align:right;">@context.Importe.ToString("C2")</MudTd>
                                <MudTd DataLabel="Pagado" Style="text-align:right;">@context.TotalPagado.ToString("C2")</MudTd>
                                <MudTd DataLabel="Saldo" Style="text-align:right;"><b class="saldo-pendiente">@context.SaldoPendiente.ToString("C2")</b></MudTd>
                                <MudTd DataLabel="Clasificación">@Clasificacion(context)</MudTd>
                                <MudTd DataLabel="Cuenta prevista">@Mostrar(context.NombreCuentaPrevista)</MudTd>
                                <MudTd DataLabel="Estatus">
                                    <MudChip T="string" Size="Size.Small" Color="@ColorEstatus(context.Estatus)" Variant="Variant.Text">
                                        @context.Estatus
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="Acciones">
                                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success"
                                                   Size="Size.Small" title="Autorizar"
                                                   Disabled="@(context.Estatus != "PENDIENTE")"
                                                   OnClick="@(() => AutorizarGasto(context))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Payments" Color="Color.Primary"
                                                   Size="Size.Small" title="Registrar pago"
                                                   Disabled="@(!PuedePagar(context))"
                                                   OnClick="@(() => AbrirPago(context))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Cancel" Color="Color.Error"
                                                   Size="Size.Small" title="Cancelar"
                                                   Disabled="@(context.Estatus is "PAGADO" or "PARCIAL" or "CANCELADO")"
                                                   OnClick="@(() => CancelarGasto(context))" />
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>@SinDatosFragment</NoRecordsContent>
                            <PagerContent>
                                <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Filas:" />
                            </PagerContent>
                        </MudTable>
                        <MudText Typo="Typo.body2" Class="mt-2">
                            <b>Total:</b> @_gastos.Sum(x => x.Importe).ToString("C2") &nbsp;•&nbsp;
                            <b>Pagado:</b> @_gastos.Sum(x => x.TotalPagado).ToString("C2") &nbsp;•&nbsp;
                            <b>Saldo:</b> @_gastos.Sum(x => x.SaldoPendiente).ToString("C2")
                        </MudText>
                    }
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudTabPanel>

    <!-- ============================================================= -->
    <!-- ========================= CUENTAS =========================== -->
    <!-- ============================================================= -->
    <MudTabPanel Text="Cuentas" Icon="@Icons.Material.Filled.AccountBalanceWallet">
        <MudPaper Elevation="0" Class="pa-4">
            <div class="encabezado-seccion mb-4">
                <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Color="Color.Primary" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.h6" Class="titulo-seccion">Cuentas de gastos</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Efectivo, caja chica, bancos y otras fuentes. Consulte saldo y movimientos.
                    </MudText>
                </div>
            </div>

            <div class="barra-gastos mb-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="NuevaCuenta" Class="b-item">
                    Nueva cuenta
                </MudButton>
            </div>

            @if (_cargandoCuentas)
            {
                <div class="d-flex justify-center pa-8"><MudProgressCircular Indeterminate="true" /></div>
            }
            else
            {
                <MudTextField T="string" @bind-Value="_busquedaCuentas" Immediate="true"
                              Placeholder="Buscar por nombre, tipo o moneda…"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Class="mb-3" />
                <MudTable Items="_cuentas" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm"
                          Elevation="0" RowsPerPage="20" T="CuentaGastoDto" Class="tabla-seguimiento"
                          Filter="new Func<CuentaGastoDto, bool>(FiltrarCuentas)">
                    <HeaderContent>
                        <MudTh><MudTableSortLabel SortBy="new Func<CuentaGastoDto, object>(x => x.Nombre ?? string.Empty)">Nombre</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<CuentaGastoDto, object>(x => x.TipoCuenta ?? string.Empty)">Tipo</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<CuentaGastoDto, object>(x => x.Moneda ?? string.Empty)">Moneda</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right;"><MudTableSortLabel SortBy="new Func<CuentaGastoDto, object>(x => x.SaldoInicial)">Saldo inicial</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right;"><MudTableSortLabel SortBy="new Func<CuentaGastoDto, object>(x => x.SaldoActual)">Saldo actual</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<CuentaGastoDto, object>(x => x.Activo)">Estatus</MudTableSortLabel></MudTh>
                        <MudTh>Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Nombre"><b>@Mostrar(context.Nombre)</b></MudTd>
                        <MudTd DataLabel="Tipo">@Mostrar(context.TipoCuenta)</MudTd>
                        <MudTd DataLabel="Moneda">@Mostrar(context.Moneda)</MudTd>
                        <MudTd DataLabel="Saldo inicial" Style="text-align:right;">@context.SaldoInicial.ToString("C2")</MudTd>
                        <MudTd DataLabel="Saldo actual" Style="text-align:right;"><b class="saldo-pendiente">@context.SaldoActual.ToString("C2")</b></MudTd>
                        <MudTd DataLabel="Estatus">
                            <MudChip T="string" Size="Size.Small" Color="@(context.Activo ? Color.Success : Color.Default)" Variant="Variant.Text">
                                @(context.Activo ? "Activa" : "Inactiva")
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Acciones">
                            <MudIconButton Icon="@Icons.Material.Filled.ListAlt" Color="Color.Primary" Size="Size.Small"
                                           title="Movimientos" OnClick="@(() => VerMovimientos(context))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                           title="Editar" OnClick="@(() => EditarCuenta(context))" />
                            <MudIconButton Icon="@Icons.Material.Filled.AddCard" Color="Color.Success" Size="Size.Small"
                                           title="Registrar entrada/salida" OnClick="@(() => NuevoMovimiento(context))" />
                            <MudIconButton Icon="@(context.Activo ? Icons.Material.Filled.ToggleOn : Icons.Material.Filled.ToggleOff)"
                                           Color="@(context.Activo ? Color.Success : Color.Default)" Size="Size.Small"
                                           title="Activar/Desactivar" OnClick="@(() => CambiarEstatusCuenta(context))" />
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>@SinDatosFragment</NoRecordsContent>
                    <PagerContent>
                        <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Filas:" />
                    </PagerContent>
                </MudTable>
            }

            @if (_cuentaMovimientos is not null)
            {
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 mt-4">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">
                        <b>Movimientos de @_cuentaMovimientos.Nombre</b>
                    </MudText>
                    <MudTable Items="_movimientos" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm"
                              Elevation="0" RowsPerPage="20" Class="tabla-seguimiento">
                        <HeaderContent>
                            <MudTh>Fecha</MudTh>
                            <MudTh>Tipo</MudTh>
                            <MudTh>Concepto</MudTh>
                            <MudTh Style="text-align:right">Importe</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Fecha">@context.FechaMovimiento.EnZonaProyecto().DateTime.ToString("dd/MM/yyyy HH:mm")</MudTd>
                            <MudTd DataLabel="Tipo">
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(context.TipoMovimiento == "ENTRADA" ? Color.Success : Color.Error)"
                                         Variant="Variant.Text">@context.TipoMovimiento</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Concepto">@context.Concepto</MudTd>
                            <MudTd DataLabel="Importe" Style="text-align:right">@context.Importe.ToString("C2")</MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Filas:" />
                        </PagerContent>
                    </MudTable>
                </MudPaper>
            }
        </MudPaper>
    </MudTabPanel>

    <!-- ============================================================= -->
    <!-- ======================== CATEGORÍAS ========================= -->
    <!-- ============================================================= -->
    <MudTabPanel Text="Categorías" Icon="@Icons.Material.Filled.Category">
        <MudPaper Elevation="0" Class="pa-4">
            <div class="encabezado-seccion mb-4">
                <MudIcon Icon="@Icons.Material.Filled.Category" Color="Color.Primary" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.h6" Class="titulo-seccion">Categorías de gasto</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Defina nombre, descripción y si requieren comprobante. No se pueden desactivar
                        categorías con gastos relacionados.
                    </MudText>
                </div>
            </div>

            <div class="barra-gastos mb-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="NuevaCategoria" Class="b-item">
                    Nueva categoría
                </MudButton>
                <MudSwitch T="bool" Value="_incluirCategoriasInactivas" ValueChanged="OnIncluirInactivasChanged"
                           Color="Color.Primary" Label="Incluir inactivas" Class="b-item" />
            </div>

            @if (_cargandoCategorias)
            {
                <div class="d-flex justify-center pa-8"><MudProgressCircular Indeterminate="true" /></div>
            }
            else
            {
                <MudTextField T="string" @bind-Value="_busquedaCategorias" Immediate="true"
                              Placeholder="Buscar por nombre o descripción…"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Class="mb-3" />
                <MudTable Items="_categorias" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm"
                          Elevation="0" RowsPerPage="20" T="CatalogoCategoriaGastoDto" Class="tabla-seguimiento"
                          Filter="new Func<CatalogoCategoriaGastoDto, bool>(FiltrarCategorias)">
                    <HeaderContent>
                        <MudTh><MudTableSortLabel SortBy="new Func<CatalogoCategoriaGastoDto, object>(x => x.Nombre ?? string.Empty)">Nombre</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<CatalogoCategoriaGastoDto, object>(x => x.Descripcion ?? string.Empty)">Descripción</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<CatalogoCategoriaGastoDto, object>(x => x.RequiereComprobante)">¿Comprobante?</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<CatalogoCategoriaGastoDto, object>(x => x.Activo)">Estatus</MudTableSortLabel></MudTh>
                        <MudTh>Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Nombre"><b>@Mostrar(context.Nombre)</b></MudTd>
                        <MudTd DataLabel="Descripción">@Mostrar(context.Descripcion)</MudTd>
                        <MudTd DataLabel="¿Comprobante?">@(context.RequiereComprobante ? "Sí" : "No")</MudTd>
                        <MudTd DataLabel="Estatus">
                            <MudChip T="string" Size="Size.Small" Color="@(context.Activo ? Color.Success : Color.Default)" Variant="Variant.Text">
                                @(context.Activo ? "Activa" : "Inactiva")
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Acciones">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                           title="Editar" OnClick="@(() => EditarCategoria(context))" />
                            <MudIconButton Icon="@(context.Activo ? Icons.Material.Filled.ToggleOn : Icons.Material.Filled.ToggleOff)"
                                           Color="@(context.Activo ? Color.Success : Color.Default)" Size="Size.Small"
                                           title="Activar/Desactivar" OnClick="@(() => CambiarEstatusCategoria(context))" />
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>@SinDatosFragment</NoRecordsContent>
                    <PagerContent>
                        <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Filas:" />
                    </PagerContent>
                </MudTable>
            }
        </MudPaper>
    </MudTabPanel>

    <!-- ============================================================= -->
    <!-- ========================= REPORTES ========================== -->
    <!-- ============================================================= -->
    <MudTabPanel Text="Reportes" Icon="@Icons.Material.Filled.Assessment">
        <MudPaper Elevation="0" Class="pa-4">
            <div class="encabezado-seccion mb-4">
                <MudIcon Icon="@Icons.Material.Filled.Assessment" Color="Color.Primary" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.h6" Class="titulo-seccion">Reportes de gastos</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Totales por rango de fechas y agrupaciones. Los importes no se duplican al
                        relacionar gastos con pagos.
                    </MudText>
                </div>
            </div>

            <div class="filtros-gastos mb-3">
                <MudDatePicker Label="Desde" @bind-Date="_repDesde" Variant="Variant.Outlined" Class="f-item" />
                <MudDatePicker Label="Hasta" @bind-Date="_repHasta" Variant="Variant.Outlined" Class="f-item" />
                <MudSelect T="string" @bind-Value="_repAgrupacion" Label="Agrupar por"
                           Variant="Variant.Outlined" Class="f-item">
                    <MudSelectItem T="string" Value="@("detalle")">Detalle</MudSelectItem>
                    <MudSelectItem T="string" Value="@("categoria")">Por categoría</MudSelectItem>
                    <MudSelectItem T="string" Value="@("zona")">Por zona</MudSelectItem>
                    <MudSelectItem T="string" Value="@("cobrador")">Por cobrador</MudSelectItem>
                    <MudSelectItem T="string" Value="@("vendedor")">Por vendedor</MudSelectItem>
                    <MudSelectItem T="string" Value="@("estatus")">Por estatus</MudSelectItem>
                </MudSelect>

                <AutocompletarCatalogo TItem="CatalogoCategoriaGastoDto" Label="Categoría" Class="f-item"
                                       Placeholder="Todas las categorías..."
                                       @bind-Value="_repCategoria"
                                       Items="_categoriasActivas"
                                       ObtenerId="@(c => c.IdCategoriaGasto)"
                                       ObtenerTexto="@(c => c.Nombre)" />

                <MudSelect T="string" @bind-Value="_repEstatus" Label="Estatus"
                           Variant="Variant.Outlined" Clearable="true" Class="f-item">
                    @foreach (var est in _estatusGasto)
                    {
                        <MudSelectItem T="string" Value="@est">@est</MudSelectItem>
                    }
                </MudSelect>

                <AutocompletarCatalogo TItem="ZonaDto" Label="Zona" Class="f-item"
                                       Placeholder="Todas las zonas..."
                                       @bind-Value="_repZona"
                                       Items="_zonas"
                                       Disabled="_repSoloCentrales"
                                       ObtenerId="@(z => z.IdZona)"
                                       ObtenerTexto="@(z => z.Descripcion)" />

                <AutocompletarCatalogo TItem="CobradorDto" Label="Cobrador" Class="f-item"
                                       Placeholder="Todos los cobradores..."
                                       @bind-Value="_repCobrador"
                                       Items="_cobradores"
                                       Disabled="_repSoloCentrales"
                                       ObtenerId="@(p => p.IdCobrador)"
                                       ObtenerTexto="@(p => p.Nombre)" />

                <AutocompletarCatalogo TItem="VendedorDto" Label="Vendedor" Class="f-item"
                                       Placeholder="Todos los vendedores..."
                                       @bind-Value="_repVendedor"
                                       Items="_vendedores"
                                       Disabled="_repSoloCentrales"
                                       ObtenerId="@(p => p.IdVendedor)"
                                       ObtenerTexto="@(p => p.Nombre)" />

                <MudCheckBox T="bool" @bind-Value="_repSoloCentrales" Label="Solo gastos centrales"
                             Dense="true" Class="f-item" />

                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="GenerarReporte" Class="f-item">
                    Generar
                </MudButton>
            </div>

            <div class="contenedor-exportar mb-3">
                <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.FileDownload"
                           OnClick="ExportarReporte"
                           Class="boton-exportar"
                           Disabled="@(_cargandoReporte || _exportando || !HayDatosReporte())">
                    Exportar a Excel
                </MudButton>
            </div>

            @if (_cargandoReporte)
            {
                <div class="d-flex justify-center pa-8"><MudProgressCircular Indeterminate="true" /></div>
            }
            else if (_repAgrupacion == "detalle" && _repDetalle is not null)
            {
                <MudTextField T="string" @bind-Value="_repBusquedaDetalle" Immediate="true"
                              Placeholder="Buscar por folio, categoría, concepto, proveedor, estatus, zona, cobrador o vendedor…"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Class="mb-3" />
                <MudTable Items="_repDetalle.Filas" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm"
                          Elevation="0" RowsPerPage="20" T="ReporteGastoFila" Class="tabla-seguimiento"
                          Filter="new Func<ReporteGastoFila, bool>(FiltrarDetalle)">
                    <HeaderContent>
                        <MudTh><MudTableSortLabel SortBy="new Func<ReporteGastoFila, object>(x => x.FolioGasto ?? string.Empty)">Folio</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<ReporteGastoFila, object>(x => x.FechaGasto)">Fecha</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ReporteGastoFila, object>(x => x.Categoria ?? string.Empty)">Categoría</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ReporteGastoFila, object>(x => x.Concepto ?? string.Empty)">Concepto</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ReporteGastoFila, object>(x => x.Proveedor ?? string.Empty)">Proveedor</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right;"><MudTableSortLabel SortBy="new Func<ReporteGastoFila, object>(x => x.Importe)">Importe</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right;"><MudTableSortLabel SortBy="new Func<ReporteGastoFila, object>(x => x.TotalPagado)">Pagado</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right;"><MudTableSortLabel SortBy="new Func<ReporteGastoFila, object>(x => x.SaldoPendiente)">Saldo</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ReporteGastoFila, object>(x => x.Estatus ?? string.Empty)">Estatus</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ReporteGastoFila, object>(x => x.Zona ?? string.Empty)">Zona</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ReporteGastoFila, object>(x => x.Cobrador ?? string.Empty)">Cobrador</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ReporteGastoFila, object>(x => x.Vendedor ?? string.Empty)">Vendedor</MudTableSortLabel></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Folio"><b>@Mostrar(context.FolioGasto)</b></MudTd>
                        <MudTd DataLabel="Fecha">@context.FechaGasto.EnZonaProyecto().DateTime.ToString("dd/MM/yyyy")</MudTd>
                        <MudTd DataLabel="Categoría">@Mostrar(context.Categoria)</MudTd>
                        <MudTd DataLabel="Concepto">@Mostrar(context.Concepto)</MudTd>
                        <MudTd DataLabel="Proveedor">@Mostrar(context.Proveedor)</MudTd>
                        <MudTd DataLabel="Importe" Style="text-align:right;">@context.Importe.ToString("C2")</MudTd>
                        <MudTd DataLabel="Pagado" Style="text-align:right;">@context.TotalPagado.ToString("C2")</MudTd>
                        <MudTd DataLabel="Saldo" Style="text-align:right;"><b class="saldo-pendiente">@context.SaldoPendiente.ToString("C2")</b></MudTd>
                        <MudTd DataLabel="Estatus">@Mostrar(context.Estatus)</MudTd>
                        <MudTd DataLabel="Zona">@Mostrar(context.Zona)</MudTd>
                        <MudTd DataLabel="Cobrador">@Mostrar(context.Cobrador)</MudTd>
                        <MudTd DataLabel="Vendedor">@Mostrar(context.Vendedor)</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>@SinDatosFragment</NoRecordsContent>
                    <PagerContent>
                        <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Filas:" />
                    </PagerContent>
                </MudTable>
                <MudText Typo="Typo.body2" Class="mt-2">
                    <b>Total:</b> @_repDetalle.ImporteTotal.ToString("C2") &nbsp;•&nbsp;
                    <b>Pagado:</b> @_repDetalle.TotalPagado.ToString("C2") &nbsp;•&nbsp;
                    <b>Saldo:</b> @_repDetalle.SaldoPendiente.ToString("C2")
                </MudText>
            }
            else if (_repAgrupado is not null)
            {
                <MudTextField T="string" @bind-Value="_repBusquedaAgrupado" Immediate="true"
                              Placeholder="Buscar por grupo…" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Clearable="true" Class="mb-3" />
                <MudTable Items="_repAgrupado.Filas" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm"
                          Elevation="0" RowsPerPage="20" T="ReporteGastosAgrupadoFila" Class="tabla-seguimiento"
                          Filter="new Func<ReporteGastosAgrupadoFila, bool>(FiltrarAgrupado)">
                    <HeaderContent>
                        <MudTh><MudTableSortLabel SortBy="new Func<ReporteGastosAgrupadoFila, object>(x => x.Etiqueta ?? string.Empty)">@EtiquetaAgrupacion()</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right;"><MudTableSortLabel SortBy="new Func<ReporteGastosAgrupadoFila, object>(x => x.NumeroGastos)">N° gastos</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right;"><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<ReporteGastosAgrupadoFila, object>(x => x.Importe)">Importe</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right;"><MudTableSortLabel SortBy="new Func<ReporteGastosAgrupadoFila, object>(x => x.TotalPagado)">Pagado</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right;"><MudTableSortLabel SortBy="new Func<ReporteGastosAgrupadoFila, object>(x => x.SaldoPendiente)">Saldo</MudTableSortLabel></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@EtiquetaAgrupacion()"><b>@Mostrar(context.Etiqueta)</b></MudTd>
                        <MudTd DataLabel="N° gastos" Style="text-align:right;">@context.NumeroGastos</MudTd>
                        <MudTd DataLabel="Importe" Style="text-align:right;">@context.Importe.ToString("C2")</MudTd>
                        <MudTd DataLabel="Pagado" Style="text-align:right;">@context.TotalPagado.ToString("C2")</MudTd>
                        <MudTd DataLabel="Saldo" Style="text-align:right;"><b class="saldo-pendiente">@context.SaldoPendiente.ToString("C2")</b></MudTd>
                    </RowTemplate>
                    <NoRecordsContent>@SinDatosFragment</NoRecordsContent>
                    <PagerContent>
                        <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Filas:" />
                    </PagerContent>
                </MudTable>
                <MudText Typo="Typo.body2" Class="mt-2">
                    <b>Total:</b> @_repAgrupado.ImporteTotal.ToString("C2") &nbsp;•&nbsp;
                    <b>Pagado:</b> @_repAgrupado.TotalPagado.ToString("C2") &nbsp;•&nbsp;
                    <b>Saldo:</b> @_repAgrupado.SaldoPendiente.ToString("C2")
                </MudText>
            }
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    private long? IdUsuarioActual => Api.Sesion?.IdUsuario;

    private static readonly string[] _estatusGasto =
        { "PENDIENTE", "AUTORIZADO", "PARCIAL", "PAGADO", "CANCELADO" };

    // Catálogos de apoyo
    private List<ZonaDto> _zonas = new();
    private List<CobradorDto> _cobradores = new();
    private List<VendedorDto> _vendedores = new();
    private List<CatalogoCategoriaGastoDto> _categoriasActivas = new();

    // ---- Gastos ----
    private List<GastoDto> _gastos = new();
    private bool _cargandoGastos;
    private bool _guardandoGasto;
    private string? _busquedaGastos;
    private string? _fFolio;
    private string? _fEstatus;
    private long? _fZona;
    private DateTime? _fDesde;
    private DateTime? _fHasta;

    private long? _nvCategoria;
    private DateTime? _nvFecha = FechaProyecto.Hoy;
    private string _nvConcepto = "";
    private decimal _nvImporte;
    private string? _nvProveedor;
    private long? _nvZona;
    private long? _nvCobrador;
    private long? _nvVendedor;
    private long? _nvCuenta;
    private string? _nvObservaciones;

    // ---- Cuentas ----
    private List<CuentaGastoDto> _cuentas = new();
    private bool _cargandoCuentas;
    private string? _busquedaCuentas;
    private CuentaGastoDto? _cuentaMovimientos;
    private List<MovimientoCuentaGastoDto> _movimientos = new();

    // ---- Categorías ----
    private List<CatalogoCategoriaGastoDto> _categorias = new();
    private bool _cargandoCategorias;
    private bool _incluirCategoriasInactivas;
    private string? _busquedaCategorias;

    // ---- Reportes ----
    private DateTime? _repDesde = FechaProyecto.Hoy.AddMonths(-1);
    private DateTime? _repHasta = FechaProyecto.Hoy;
    private string _repAgrupacion = "detalle";
    private long? _repCategoria;
    private string? _repEstatus;
    private long? _repZona;
    private long? _repCobrador;
    private long? _repVendedor;
    private bool _repSoloCentrales;
    private bool _cargandoReporte;
    private bool _exportando;
    private string? _repBusquedaDetalle;
    private string? _repBusquedaAgrupado;
    private ReporteGastosResponse? _repDetalle;
    private ReporteGastosAgrupadoResponse? _repAgrupado;

    protected override async Task OnInitializedAsync()
    {
        await CargarCatalogos();
        await CargarGastos();
        await CargarCuentas();
        await CargarCategorias();
    }

    private async Task CargarCatalogos()
    {
        var (zonas, _) = await Api.ListarZonasOperativasAsync();
        _zonas = zonas ?? new();
        var (cob, _) = await Api.ListarCobradoresOperativosAsync();
        _cobradores = cob ?? new();
        var (ven, _) = await Api.ListarVendedoresOperativosAsync();
        _vendedores = ven ?? new();
        var (cats, _) = await Api.ListarCategoriasGastoAsync(incluirInactivas: false);
        _categoriasActivas = cats ?? new();
    }

    // ===================== GASTOS =====================

    private async Task CargarGastos()
    {
        _cargandoGastos = true;
        DateTimeOffset? desde = _fDesde is { } d ? FechaProyecto.DesdeFechaLocal(d) : null;
        DateTimeOffset? hasta = _fHasta is { } h ? FechaProyecto.DesdeFechaLocal(h.Date.AddDays(1)).AddTicks(-1) : null;
        var (datos, error) = await Api.ListarGastosAsync(
            desde: desde, hasta: hasta,
            estatus: _fEstatus, idZona: _fZona,
            folio: string.IsNullOrWhiteSpace(_fFolio) ? null : _fFolio);
        _cargandoGastos = false;
        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        _gastos = datos ?? new();
    }

    // Handlers de filtros: cada cambio recarga la lista automáticamente.
    private async Task OnFolioChanged(string? v) { _fFolio = v; await CargarGastos(); }
    private async Task OnEstatusChanged(string? v) { _fEstatus = v; await CargarGastos(); }
    private async Task OnZonaChanged(long? v) { _fZona = v; await CargarGastos(); }
    private async Task OnDesdeChanged(DateTime? v) { _fDesde = v; await CargarGastos(); }
    private async Task OnHastaChanged(DateTime? v) { _fHasta = v; await CargarGastos(); }

    private async Task CrearGasto()
    {
        if (_nvCategoria is null) { _snackbar.Add("Selecciona una categoría.", Severity.Warning); return; }
        if (string.IsNullOrWhiteSpace(_nvConcepto)) { _snackbar.Add("El concepto es obligatorio.", Severity.Warning); return; }
        if (_nvImporte <= 0) { _snackbar.Add("El importe debe ser mayor que cero.", Severity.Warning); return; }

        _guardandoGasto = true;
        var req = new CrearGastoRequest(
            _nvCategoria.Value,
            FechaProyecto.DesdeFechaLocal(_nvFecha ?? FechaProyecto.Hoy),
            _nvConcepto.Trim(),
            _nvImporte,
            null,
            string.IsNullOrWhiteSpace(_nvProveedor) ? null : _nvProveedor.Trim(),
            null,
            null,
            _nvZona,
            _nvCobrador,
            _nvVendedor,
            _nvCuenta,
            string.IsNullOrWhiteSpace(_nvObservaciones) ? null : _nvObservaciones.Trim());

        var (datos, error) = await Api.CrearGastoAsync(req);
        _guardandoGasto = false;
        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }

        _snackbar.Add($"Gasto {datos?.FolioGasto} registrado.", Severity.Success);
        LimpiarNuevoGasto();
        await CargarGastos();
    }

    private void LimpiarNuevoGasto()
    {
        _nvCategoria = null;
        _nvFecha = FechaProyecto.Hoy;
        _nvConcepto = "";
        _nvImporte = 0;
        _nvProveedor = null;
        _nvZona = _nvCobrador = _nvVendedor = null;
        _nvCuenta = null;
        _nvObservaciones = null;
    }

    private async Task AutorizarGasto(GastoDto g)
    {
        var ok = await ConfirmarDialogo("Autorizar gasto",
            $"¿Autorizar el gasto {g.FolioGasto} por {g.Importe:C2}?", "Autorizar", Color.Success);
        if (!ok) return;

        var (_, error) = await Api.AutorizarGastoAsync(g.IdGasto);
        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        _snackbar.Add("Gasto autorizado.", Severity.Success);
        await CargarGastos();
    }

    private async Task CancelarGasto(GastoDto g)
    {
        var motivo = await PedirTexto("Cancelar gasto",
            $"Motivo de cancelación del gasto {g.FolioGasto}:");
        if (string.IsNullOrWhiteSpace(motivo)) return;

        var (_, error) = await Api.CancelarGastoAsync(g.IdGasto,
            new CancelarGastoRequest(IdUsuarioActual ?? 0, motivo.Trim()));
        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        _snackbar.Add("Gasto cancelado.", Severity.Success);
        await CargarGastos();
    }

    private static bool PuedePagar(GastoDto g)
        => g.Estatus is "AUTORIZADO" or "PARCIAL" && g.SaldoPendiente > 0;

    private decimal? SaldoCuentaPrevista()
        => _nvCuenta is { } id
            ? _cuentas.FirstOrDefault(c => c.IdCuentaGasto == id)?.SaldoActual
            : null;

    private bool CuentaPrevistaInsuficiente()
        => _nvCuenta is not null && _nvImporte > 0
           && SaldoCuentaPrevista() is { } saldo && saldo < _nvImporte;

    private async Task AbrirPago(GastoDto g)
    {
        if (_cuentas.Count == 0) await CargarCuentas();
        var activas = _cuentas.Where(c => c.Activo).ToList();
        if (activas.Count == 0) { _snackbar.Add("No hay cuentas activas para pagar.", Severity.Warning); return; }

        var dialogo = await _dialogo.ShowAsync<DialogoPagoGasto>("Registrar pago",
            new DialogParameters<DialogoPagoGasto>
            {
                { x => x.Folio, g.FolioGasto },
                { x => x.SaldoPendiente, g.SaldoPendiente },
                { x => x.Cuentas, activas }
            },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, FullScreen = EsEntornoMovil });
        var r = await dialogo.Result;
        if (r is not { Canceled: false, Data: DialogoPagoGasto.Resultado d }) return;

        var req = new RegistrarGastoPagoRequest(d.IdCuenta, d.Importe, d.FormaPago,
            null, d.Referencia, d.Observaciones);
        var (_, error) = await Api.RegistrarPagoGastoAsync(g.IdGasto, req);
        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        _snackbar.Add("Pago aplicado correctamente.", Severity.Success);
        await CargarGastos();
        await CargarCuentas();
    }

    private static string Clasificacion(GastoDto g)
    {
        if (!string.IsNullOrWhiteSpace(g.NombreZona)
            || !string.IsNullOrWhiteSpace(g.NombreCobrador)
            || !string.IsNullOrWhiteSpace(g.NombreVendedor))
        {
            var partes = new List<string>();
            if (!string.IsNullOrWhiteSpace(g.NombreZona)) partes.Add($"Zona: {g.NombreZona}");
            if (!string.IsNullOrWhiteSpace(g.NombreCobrador)) partes.Add($"Cob: {g.NombreCobrador}");
            if (!string.IsNullOrWhiteSpace(g.NombreVendedor)) partes.Add($"Vend: {g.NombreVendedor}");
            return string.Join(" · ", partes);
        }
        return "Central";
    }

    private static Color ColorEstatus(string estatus) => estatus switch
    {
        "PENDIENTE" => Color.Warning,
        "AUTORIZADO" => Color.Info,
        "PARCIAL" => Color.Primary,
        "PAGADO" => Color.Success,
        "CANCELADO" => Color.Error,
        _ => Color.Default
    };

    // ===================== CUENTAS =====================

    private async Task CargarCuentas()
    {
        _cargandoCuentas = true;
        var (datos, error) = await Api.ListarCuentasGastoAsync(incluirInactivas: true);
        _cargandoCuentas = false;
        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        _cuentas = datos ?? new();
    }

    private async Task NuevaCuenta()
    {
        var dialogo = await _dialogo.ShowAsync<DialogoCuentaGasto>("Nueva cuenta",
            new DialogParameters<DialogoCuentaGasto> { { x => x.EsEdicion, false } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, FullScreen = EsEntornoMovil });
        var r = await dialogo.Result;
        if (r is not { Canceled: false, Data: DialogoCuentaGasto.Resultado d }) return;

        var req = new CrearCuentaGastoRequest(d.Nombre, d.TipoCuenta, d.Moneda, d.SaldoInicial, d.Observaciones);
        var (_, error) = await Api.CrearCuentaGastoAsync(req);
        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        _snackbar.Add("Cuenta creada.", Severity.Success);
        await CargarCuentas();
    }

    private async Task EditarCuenta(CuentaGastoDto c)
    {
        var dialogo = await _dialogo.ShowAsync<DialogoCuentaGasto>("Editar cuenta",
            new DialogParameters<DialogoCuentaGasto>
            {
                { x => x.EsEdicion, true },
                { x => x.Nombre, c.Nombre },
                { x => x.TipoCuenta, c.TipoCuenta },
                { x => x.Moneda, c.Moneda },
                { x => x.Observaciones, c.Observaciones },
                { x => x.Activo, c.Activo }
            },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, FullScreen = EsEntornoMovil });
        var r = await dialogo.Result;
        if (r is not { Canceled: false, Data: DialogoCuentaGasto.Resultado d }) return;

        var req = new ActualizarCuentaGastoRequest(d.Nombre, d.TipoCuenta, d.Moneda, d.Observaciones, d.Activo);
        var (_, error) = await Api.ActualizarCuentaGastoAsync(c.IdCuentaGasto, req);
        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        _snackbar.Add("Cuenta actualizada.", Severity.Success);
        await CargarCuentas();
    }

    private async Task CambiarEstatusCuenta(CuentaGastoDto c)
    {
        var (_, error) = await Api.CambiarEstatusCuentaGastoAsync(c.IdCuentaGasto, !c.Activo);
        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        await CargarCuentas();
    }

    private async Task VerMovimientos(CuentaGastoDto c)
    {
        _cuentaMovimientos = c;
        var (datos, error) = await Api.ListarMovimientosCuentaGastoAsync(c.IdCuentaGasto);
        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        _movimientos = datos ?? new();
    }

    private async Task NuevoMovimiento(CuentaGastoDto c)
    {
        var importeTxt = await PedirTexto("Entrada de dinero",
            $"Importe de la entrada/reposición a '{c.Nombre}':");
        if (!decimal.TryParse(importeTxt, out var importe) || importe <= 0)
        {
            if (importeTxt is not null) _snackbar.Add("Importe inválido.", Severity.Warning);
            return;
        }

        var req = new CrearMovimientoCuentaGastoRequest("ENTRADA", importe, "Reposición de fondos");
        var (_, error) = await Api.RegistrarMovimientoCuentaGastoAsync(c.IdCuentaGasto, req);
        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        _snackbar.Add("Movimiento registrado.", Severity.Success);
        await CargarCuentas();
        if (_cuentaMovimientos?.IdCuentaGasto == c.IdCuentaGasto) await VerMovimientos(c);
    }

    // ===================== CATEGORÍAS =====================

    private async Task CargarCategorias()
    {
        _cargandoCategorias = true;
        var (datos, error) = await Api.ListarCategoriasGastoAsync(_incluirCategoriasInactivas);
        _cargandoCategorias = false;
        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        _categorias = datos ?? new();
    }

    private async Task OnIncluirInactivasChanged(bool v)
    {
        _incluirCategoriasInactivas = v;
        await CargarCategorias();
    }

    private async Task NuevaCategoria()
    {
        var dialogo = await _dialogo.ShowAsync<DialogoCategoriaGasto>("Nueva categoría",
            new DialogParameters<DialogoCategoriaGasto> { { x => x.EsEdicion, false } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, FullScreen = EsEntornoMovil });
        var r = await dialogo.Result;
        if (r is not { Canceled: false, Data: DialogoCategoriaGasto.Resultado d }) return;

        var req = new CrearCatalogoCategoriaGastoRequest(d.Nombre, d.Descripcion, d.RequiereComprobante);
        var (_, error) = await Api.CrearCategoriaGastoAsync(req);
        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        _snackbar.Add("Categoría creada.", Severity.Success);
        await CargarCategorias();
        await CargarCatalogos();
    }

    private async Task EditarCategoria(CatalogoCategoriaGastoDto cat)
    {
        var dialogo = await _dialogo.ShowAsync<DialogoCategoriaGasto>("Editar categoría",
            new DialogParameters<DialogoCategoriaGasto>
            {
                { x => x.EsEdicion, true },
                { x => x.Nombre, cat.Nombre },
                { x => x.Descripcion, cat.Descripcion },
                { x => x.RequiereComprobante, cat.RequiereComprobante },
                { x => x.Activo, cat.Activo }
            },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, FullScreen = EsEntornoMovil });
        var r = await dialogo.Result;
        if (r is not { Canceled: false, Data: DialogoCategoriaGasto.Resultado d }) return;

        var req = new ActualizarCatalogoCategoriaGastoRequest(d.Nombre, d.Descripcion, d.RequiereComprobante, d.Activo);
        var (_, error) = await Api.ActualizarCategoriaGastoAsync(cat.IdCategoriaGasto, req);
        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        _snackbar.Add("Categoría actualizada.", Severity.Success);
        await CargarCategorias();
        await CargarCatalogos();
    }

    private async Task CambiarEstatusCategoria(CatalogoCategoriaGastoDto cat)
    {
        var (_, error) = await Api.CambiarEstatusCategoriaGastoAsync(cat.IdCategoriaGasto, !cat.Activo);
        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        await CargarCategorias();
        await CargarCatalogos();
    }

    // ===================== REPORTES =====================

    private async Task GenerarReporte()
    {
        _cargandoReporte = true;
        _repDetalle = null;
        _repAgrupado = null;

        DateTimeOffset? desde = _repDesde is { } d ? FechaProyecto.DesdeFechaLocal(d) : null;
        DateTimeOffset? hasta = _repHasta is { } h ? FechaProyecto.DesdeFechaLocal(h.Date.AddDays(1)).AddTicks(-1) : null;

        // "Solo centrales" es excluyente con zona/cobrador/vendedor:
        // si está activo, esos filtros se ignoran para evitar combinaciones
        // contradictorias (p. ej. central + zona concreta = siempre vacío).
        long? zona = _repSoloCentrales ? null : _repZona;
        long? cobrador = _repSoloCentrales ? null : _repCobrador;
        long? vendedor = _repSoloCentrales ? null : _repVendedor;
        long? categoria = _repCategoria;
        string? estatus = string.IsNullOrWhiteSpace(_repEstatus) ? null : _repEstatus;
        bool? soloCentrales = _repSoloCentrales ? true : null;

        string? error;
        switch (_repAgrupacion)
        {
            case "categoria":
                (_repAgrupado, error) = await Api.ReporteGastosPorCategoriaAsync(
                    desde, hasta, categoria, estatus, zona, cobrador, vendedor, soloCentrales);
                break;
            case "zona":
                (_repAgrupado, error) = await Api.ReporteGastosPorZonaAsync(
                    desde, hasta, categoria, estatus, zona, cobrador, vendedor, soloCentrales);
                break;
            case "cobrador":
                (_repAgrupado, error) = await Api.ReporteGastosPorCobradorAsync(
                    desde, hasta, categoria, estatus, zona, cobrador, vendedor, soloCentrales);
                break;
            case "vendedor":
                (_repAgrupado, error) = await Api.ReporteGastosPorVendedorAsync(
                    desde, hasta, categoria, estatus, zona, cobrador, vendedor, soloCentrales);
                break;
            case "estatus":
                (_repAgrupado, error) = await Api.ReporteGastosPorEstatusAsync(
                    desde, hasta, categoria, estatus, zona, cobrador, vendedor, soloCentrales);
                break;
            default:
                (_repDetalle, error) = await Api.ReporteGastosDetalleAsync(
                    desde, hasta, categoria, estatus, zona, cobrador, vendedor, soloCentrales);
                break;
        }

        _cargandoReporte = false;
        if (error is not null) _snackbar.Add(error, Severity.Error);
    }

    // ---- Exportación a Excel (mismo estándar que Reportes) ----

    // Indica si hay datos para exportar en el modo activo (detalle o agrupado).
    private bool HayDatosReporte() => _repAgrupacion == "detalle"
        ? _repDetalle is { Filas.Count: > 0 }
        : _repAgrupado is { Filas.Count: > 0 };

    // Describe los filtros activos para el encabezado del Excel.
    private Dictionary<string, string> FiltrosReporteExcel() => new()
    {
        ["Desde"] = FechaRep(_repDesde),
        ["Hasta"] = FechaRep(_repHasta),
        ["Categoría"] = _categoriasActivas.FirstOrDefault(c => c.IdCategoriaGasto == _repCategoria)?.Nombre ?? "Todas",
        ["Estatus"] = string.IsNullOrWhiteSpace(_repEstatus) ? "Todos" : _repEstatus!,
        ["Zona"] = _repSoloCentrales ? "—" : (_zonas.FirstOrDefault(z => z.IdZona == _repZona)?.Descripcion ?? "Todas"),
        ["Cobrador"] = _repSoloCentrales ? "—" : (_cobradores.FirstOrDefault(c => c.IdCobrador == _repCobrador)?.Nombre ?? "Todos"),
        ["Vendedor"] = _repSoloCentrales ? "—" : (_vendedores.FirstOrDefault(v => v.IdVendedor == _repVendedor)?.Nombre ?? "Todos"),
        ["Solo centrales"] = _repSoloCentrales ? "Sí" : "No"
    };

    private Task ExportarReporte() => _repAgrupacion == "detalle"
        ? ExportarDetalle()
        : ExportarAgrupado();

    private Task ExportarDetalle() => _repDetalle is not { } d ? Task.CompletedTask : ExportarReporteAsync(
        "Gastos-Detalle", "REPORTE DE GASTOS (DETALLE)",
        FiltrosReporteExcel(),
        [
            Kpi("Gastos", d.Total.ToString()),
            Kpi("Importe total", d.ImporteTotal.ToString("C2")),
            Kpi("Pagado", d.TotalPagado.ToString("C2")),
            Kpi("Saldo pendiente", d.SaldoPendiente.ToString("C2"))
        ],
        ["Folio", "Fecha", "Categoría", "Concepto", "Proveedor", "Importe", "Pagado", "Saldo",
         "Estatus", "Zona", "Cobrador", "Vendedor"],
        d.Filas.Select(f => new object?[] { f.FolioGasto, FechaCortaRep(f.FechaGasto), f.Categoria, f.Concepto,
            f.Proveedor, f.Importe, f.TotalPagado, f.SaldoPendiente, f.Estatus,
            f.Zona, f.Cobrador, f.Vendedor }),
        [6, 7, 8]);

    private Task ExportarAgrupado() => _repAgrupado is not { } a ? Task.CompletedTask : ExportarReporteAsync(
        $"Gastos-{_repAgrupacion}", $"REPORTE DE GASTOS POR {_repAgrupacion.ToUpperInvariant()}",
        FiltrosReporteExcel(),
        [
            Kpi("Grupos", a.Total.ToString()),
            Kpi("Importe total", a.ImporteTotal.ToString("C2")),
            Kpi("Pagado", a.TotalPagado.ToString("C2")),
            Kpi("Saldo pendiente", a.SaldoPendiente.ToString("C2"))
        ],
        [EtiquetaAgrupacion(), "N° gastos", "Importe", "Pagado", "Saldo"],
        a.Filas.Select(f => new object?[] { f.Etiqueta, f.NumeroGastos, f.Importe, f.TotalPagado, f.SaldoPendiente }),
        [3, 4, 5]);

    private string EtiquetaAgrupacion() => _repAgrupacion switch
    {
        "categoria" => "Categoría",
        "zona" => "Zona",
        "cobrador" => "Cobrador",
        "vendedor" => "Vendedor",
        "estatus" => "Estatus",
        _ => "Grupo"
    };

    private async Task ExportarReporteAsync(string archivo, string titulo, Dictionary<string, string> filtros,
        List<ReporteExcelKpi> kpis, string[] columnas, IEnumerable<object?[]> filas, int[]? columnasMoneda = null)
    {
        if (_exportando) return;
        _exportando = true;
        try
        {
            var info = new ReporteExcelInfo
            {
                Empresa = EmpresaGlobal.Info?.NombreCorto
                          ?? EmpresaGlobal.Identidad?.NombreCorto
                          ?? "Sistema Cobranza",
                Titulo = titulo,
                FechaGeneracion = FechaProyecto.Ahora.DateTime,
                Filtros = filtros,
                Kpis = kpis
            };
            var bytes = ExportadorExcel.Crear(info, columnas, filas, columnasMoneda);
            await Descarga.GuardarAsync($"{archivo}-{FechaProyecto.Ahora:yyyyMMdd-HHmmssfff}.xlsx", bytes);
        }
        catch (Exception ex) { _snackbar.Add($"No se pudo exportar el reporte: {ex.Message}", Severity.Error); }
        finally { _exportando = false; }
    }

    private static ReporteExcelKpi Kpi(string nombre, string valor) => new() { Nombre = nombre, Valor = valor };

    private static string FechaRep(DateTime? d, string vacio = "Sin límite") => d is { } v ? v.ToString("dd/MM/yyyy") : vacio;

    private static string FechaCortaRep(DateTimeOffset d) => d.EnZonaProyecto().DateTime.ToString("dd/MM/yyyy");

    // ---- Búsqueda y presentación de las tablas del reporte ----

    private static string Mostrar(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v!;

    // Verdadero en plataformas táctiles (MAUI Android/iOS); los modales se muestran
    // a pantalla completa y ciertos controles ocupan todo el ancho.
    private bool EsEntornoMovil
    {
        get
        {
            var ff = _formFactor.GetFormFactor();
            return !ff.Equals("Web", StringComparison.OrdinalIgnoreCase)
                   && !ff.Equals("Desktop", StringComparison.OrdinalIgnoreCase);
        }
    }

    private bool FiltrarDetalle(ReporteGastoFila f)
    {
        var t = _repBusquedaDetalle;
        if (string.IsNullOrWhiteSpace(t)) return true;
        return Contiene(f.FolioGasto, t) || Contiene(f.Categoria, t) || Contiene(f.Concepto, t)
            || Contiene(f.Proveedor, t) || Contiene(f.Estatus, t) || Contiene(f.Zona, t)
            || Contiene(f.Cobrador, t) || Contiene(f.Vendedor, t);
    }

    private bool FiltrarAgrupado(ReporteGastosAgrupadoFila f)
    {
        var t = _repBusquedaAgrupado;
        return string.IsNullOrWhiteSpace(t) || Contiene(f.Etiqueta, t);
    }

    private static bool Contiene(string? valor, string termino)
        => (valor ?? string.Empty).Contains(termino, StringComparison.OrdinalIgnoreCase);

    private bool FiltrarGastos(GastoDto g)
    {
        var t = _busquedaGastos;
        if (string.IsNullOrWhiteSpace(t)) return true;
        return Contiene(g.FolioGasto, t) || Contiene(g.NombreCategoria, t) || Contiene(g.Concepto, t)
            || Contiene(Clasificacion(g), t) || Contiene(g.Estatus, t) || Contiene(g.NombreCuentaPrevista, t);
    }

    private bool FiltrarCuentas(CuentaGastoDto c)
    {
        var t = _busquedaCuentas;
        if (string.IsNullOrWhiteSpace(t)) return true;
        return Contiene(c.Nombre, t) || Contiene(c.TipoCuenta, t) || Contiene(c.Moneda, t);
    }

    private bool FiltrarCategorias(CatalogoCategoriaGastoDto c)
    {
        var t = _busquedaCategorias;
        if (string.IsNullOrWhiteSpace(t)) return true;
        return Contiene(c.Nombre, t) || Contiene(c.Descripcion, t);
    }

    private readonly RenderFragment SinDatosFragment = builder =>
