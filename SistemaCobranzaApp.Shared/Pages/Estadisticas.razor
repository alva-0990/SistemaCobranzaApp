    // Tarjeta de indicador (KPI) reutilizada por los reportes ejecutivos; usa los colores del tema del sistema.
    private RenderFragment Tarjeta(string titulo, string valor, string icono, Color color, int md = 3) => @<MudItem xs="12" sm="6" md="@md">
        <MudPaper Elevation="0" Outlined="true" Class="pa-3 d-flex align-center gap-3" Style="height:100%;">
            <MudIcon Icon="@icono" Color="@color" Size="Size.Large" />
            <div>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@titulo</MudText>
                <MudText Typo="Typo.h6"><b>@valor</b></MudText>
            </div>
        </MudPaper>
    </MudItem>;

    // Color del chip según el rango de antigüedad (verde → rojo).
    private static Color ColorRango(string rango) => rango switch
    {
        "0-7 días" => Color.Success,
        "8-15 días" => Color.Info,
        "16-30 días" => Color.Warning,
        _ => Color.Error
    };

    private static string RangoDias(int dias) => dias switch
    {
        <= 7 => "0-7 días",
        <= 15 => "8-15 días",
        <= 30 => "16-30 días",
        <= 60 => "31-60 días",
        _ => "+60 días"
    };

    private static string Mostrar(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v!;

    private static string FechaCorta(DateTimeOffset? d)
        => d is { } v ? v.EnZonaProyecto().DateTime.ToString("dd/MM/yyyy") : "—";

