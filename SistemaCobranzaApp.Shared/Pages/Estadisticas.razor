    protected override async Task OnInitializedAsync()
    {
        await Api.CargarSesionDesdeAlmacenamientoAsync();
        if (!Api.Autenticado)
        {
            Nav.NavigateTo("/login");
            return;
        }

        // Los errores de catálogo se ignoran de forma suave: el combo queda vacío y el reporte se genera sin filtro.
        var tZonas = Api.ListarZonasOperativasAsync();
        var tRutas = Api.ListarRutasOperativasAsync();
        var tClasificaciones = Api.ListarClasificacionesClienteOperativasAsync();
        var tParametros = Api.ListarParametrosAsync();
        await Task.WhenAll(tZonas, tRutas, tClasificaciones, tParametros);

        _zonas = (await tZonas).datos ?? new();
        _rutas = (await tRutas).datos ?? new();
        _clasificaciones = (await tClasificaciones).datos ?? new();

        var (parametros, errorParametros) = await tParametros;
        if (errorParametros is null && parametros is not null)
        {
            var p = parametros.FirstOrDefault(x => string.Equals(x.Clave, ClaveGraciaAlerta, StringComparison.OrdinalIgnoreCase));
            if (p?.ValorNumerico is { } n) _diasGraciaAlerta = (int)Math.Max(0, Math.Round(n));
            else if (int.TryParse(p?.ValorTexto?.Trim(), out var v)) _diasGraciaAlerta = Math.Max(0, v);
        }
    }

