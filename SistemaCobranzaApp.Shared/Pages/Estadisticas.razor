    // Búsqueda del detalle de cobertura.
    private bool FiltrarCobertura(ReporteCoberturaFila f)
    {
        var t = _cobBusqueda;
        if (string.IsNullOrWhiteSpace(t)) return true;
        bool Contiene(string? v) => (v ?? string.Empty).Contains(t, StringComparison.OrdinalIgnoreCase);
        return Contiene(f.Cliente) || Contiene(f.CodigoVenta) || Contiene(f.Productos)
            || Contiene(f.Zona) || Contiene(f.Ruta) || Contiene(EtiquetaEstadoCobertura(f.Estado));
    }

    private static bool Contiene(string? valor, string termino)
        => (valor ?? string.Empty).Contains(termino, StringComparison.OrdinalIgnoreCase);

    private bool FiltrarAntiguedad(ReporteAntiguedadFila f)
    {
        var t = _antBusqueda;
        if (string.IsNullOrWhiteSpace(t)) return true;
        return Contiene(f.Cliente, t) || Contiene(f.Direccion, t) || Contiene(f.TelefonoPrincipal, t)
            || Contiene(f.Zona, t) || Contiene(f.Ruta, t) || Contiene(f.Clasificacion, t) || Contiene(f.Rango, t);
    }

    private bool FiltrarSinPago(ReporteSinPagoFila f)
    {
        var t = _spBusqueda;
        if (string.IsNullOrWhiteSpace(t)) return true;
        return Contiene(f.IdCliente.ToString(), t) || Contiene(f.Cliente, t) || Contiene(f.Direccion, t)
            || Contiene(f.TelefonoPrincipal, t) || Contiene(f.Zona, t) || Contiene(f.Ruta, t) || Contiene(f.Clasificacion, t);
    }

    private bool FiltrarRanking(ReporteRankingDeudoresFila f)
    {
        var t = _rkBusqueda;
        if (string.IsNullOrWhiteSpace(t)) return true;
        return Contiene(f.Cliente, t) || Contiene(f.Direccion, t) || Contiene(f.TelefonoPrincipal, t)
            || Contiene(f.Zona, t) || Contiene(f.Ruta, t) || Contiene(f.Clasificacion, t);
    }

    private static string EtiquetaEstadoCobertura(string estado) => estado switch
    {
        EstadoCobertura.Pago => "Pagó",
        EstadoCobertura.Parcial => "Parcial",
        EstadoCobertura.NoPago => "No pagó",
        EstadoCobertura.SinFrecuencia => "Sin frecuencia",
        _ => estado
    };

    private static Color ColorEstadoCobertura(string estado) => estado switch
    {
        EstadoCobertura.Pago => Color.Success,
        EstadoCobertura.Parcial => Color.Warning,
        EstadoCobertura.NoPago => Color.Error,
        _ => Color.Default
    };

    // ---- Exportación a Excel con formato (empresa, filtros, KPIs, tabla y totales) ----

    private async Task ExportarReporteAsync(string archivo, string titulo, Dictionary<string, string> filtros,
        List<ReporteExcelKpi> kpis, string[] columnas, IEnumerable<object?[]> filas, int[]? columnasMoneda = null)
    {
        if (_exportando) return;
        _exportando = true;
        try
        {
            var info = new ReporteExcelInfo
            {
                Empresa = EmpresaGlobal.Info?.NombreCorto
                          ?? EmpresaGlobal.Identidad?.NombreCorto
                          ?? "Sistema Cobranza",
                Titulo = titulo,
                FechaGeneracion = FechaProyecto.Ahora.DateTime,
                Filtros = filtros,
                Kpis = kpis
            };
            var bytes = ExportadorExcel.Crear(info, columnas, filas, columnasMoneda);
            await Descarga.GuardarAsync($"{archivo}-{FechaProyecto.Ahora:yyyyMMdd-HHmmssfff}.xlsx", bytes);
        }
        catch (Exception ex) { Snackbar.Add($"No se pudo exportar el reporte: {ex.Message}", Severity.Error); }
        finally { _exportando = false; }
    }

    private static ReporteExcelKpi Kpi(string nombre, string valor) => new() { Nombre = nombre, Valor = valor };

