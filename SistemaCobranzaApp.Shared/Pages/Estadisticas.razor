@page "/estadisticas"

@using MudBlazor
@using SistemaCobranzaApp.Shared.Dtos
@using SistemaCobranzaApp.Shared.Services
@inject IDescargaArchivo Descarga
@inject ApiCliente Api
@inject EstadoEmpresaGlobal EmpresaGlobal
@inject ISnackbar Snackbar
@inject NavigationManager Nav

@* ============================================================================
   ESTADÍSTICAS EJECUTIVAS
   ----------------------------------------------------------------------------
   Dashboard ejecutivo, antigüedad de saldos, clientes sin pago, ranking de deudores,
   cartera por clasificación y concentración. Todos derivan de la consulta base de
   seguimiento (GET /api/reportes/...), sin consultas redundantes.
   ============================================================================ *@

<MudTabs Elevation="2" Rounded="true" Color="Color.Primary" ApplyEffectsToContainer="true"
         PanelClass="pa-0 pt-4" SliderColor="Color.Warning" Class="ma-2 tabs-remarcados">

    <!-- ===================== DASHBOARD EJECUTIVO ===================== -->
    <MudTabPanel Text="Dashboard ejecutivo" Icon="@Icons.Material.Filled.Dashboard">
        <MudPaper Elevation="0" Class="pa-4">
            <div class="seccion-titulo mb-3">
                <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="Size.Small" Class="mr-1" />
                Filtros del dashboard ejecutivo
            </div>
            <MudGrid Spacing="2" Class="align-end">
                <MudItem xs="12" sm="6" md="4">
                    <MudDatePicker Label="Desde" @bind-Date="_dashDesde" Variant="Variant.Outlined" Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudDatePicker Label="Hasta" @bind-Date="_dashHasta" Variant="Variant.Outlined" Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <AutocompletarCatalogo TItem="ZonaDto" Label="Zona" Placeholder="Todas"
                                           @bind-Value="_dashZona"
                                           Items="_zonas"
                                           ObtenerId="@(z => z.IdZona)"
                                           ObtenerTexto="@(z => z.Descripcion)" />
                </MudItem>
            </MudGrid>

            <div class="d-flex justify-end mt-3 contenedor-generar">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Assessment"
                           OnClick="GenerarDashboardEjecutivoAsync" Disabled="_cargando" Class="boton-generar">
                    Generar reporte
                </MudButton>
            </div>
        </MudPaper>

        @if (_cargando && _tabActivo == 0)
        {
            @CargandoFragment
        }
        else if (_dashboard is not null)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-3 ma-2">
                <div class="seccion-titulo mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Small" Class="mr-1" />
                    Indicadores ejecutivos
                </div>
                <div class="contenedor-exportar mb-3">
                    <MudButton Variant="Variant.Outlined" Color="Color.Success" Class="boton-exportar" StartIcon="@Icons.Material.Filled.FileDownload"
                               OnClick="ExportarDashboardEjecutivo" Disabled="@(_cargando || _exportando)">
                        Exportar a Excel
                    </MudButton>
                </div>
                <MudGrid Spacing="2" Class="mb-3">
                    @Tarjeta("💰 Cartera total pendiente", _dashboard.CarteraPendiente.ToString("C2"), Icons.Material.Filled.AccountBalanceWallet, Color.Error, 3)
                    @Tarjeta("💰 Total cobrado", _dashboard.TotalCobrado.ToString("C2"), Icons.Material.Filled.Paid, Color.Success, 3)
                    @Tarjeta("📈 Ventas del periodo", _dashboard.VentasPeriodo.ToString("C2"), Icons.Material.Filled.TrendingUp, Color.Info, 3)
                    @Tarjeta("👥 Clientes activos", _dashboard.ClientesActivos.ToString("N0"), Icons.Material.Filled.People, Color.Primary, 3)
                    @Tarjeta("⚠️ Clientes con atraso", _dashboard.ClientesConAtraso.ToString("N0"), Icons.Material.Filled.Warning, Color.Warning, 3)
                    @Tarjeta("🔴 Clientes críticos", _dashboard.ClientesCriticos.ToString("N0"), Icons.Material.Filled.ReportProblem, Color.Error, 3)
                    @Tarjeta("🏆 Mayor deudor", Mostrar(_dashboard.MayorDeudor), Icons.Material.Filled.EmojiEvents, Color.Secondary, 3)
                    @Tarjeta("📍 Zona con mayor riesgo", Mostrar(_dashboard.ZonaMayorRiesgo), Icons.Material.Filled.Place, Color.Error, 3)
                </MudGrid>
            </MudPaper>
        }
    </MudTabPanel>

    <!-- ===================== ANTIGÜEDAD DE SALDOS ===================== -->
    <MudTabPanel Text="Antigüedad de saldos" Icon="@Icons.Material.Filled.HourglassBottom">
        <MudPaper Elevation="0" Class="pa-4">
            <div class="seccion-titulo mb-3">
                <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="Size.Small" Class="mr-1" />
                Filtros de antigüedad de saldos
            </div>
            <MudGrid Spacing="2" Class="align-end">
                <MudItem xs="12" sm="6" md="4">
                    <AutocompletarCatalogo TItem="ZonaDto" Label="Zona" Placeholder="Todas"
                                           @bind-Value="_antZona"
                                           Items="_zonas"
                                           ObtenerId="@(z => z.IdZona)"
                                           ObtenerTexto="@(z => z.Descripcion)" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <AutocompletarCatalogo TItem="RutaAdminDto" Label="Ruta" Placeholder="Todas"
                                           @bind-Value="_antRuta"
                                           Items="_rutas"
                                           ObtenerId="@(r => r.IdRuta)"
                                           ObtenerTexto="@(r => r.Descripcion)" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <AutocompletarCatalogo TItem="ClasificaionClienteDto" Label="Clasificación" Placeholder="Todas"
                                           @bind-Value="_antClasificacion"
                                           Items="_clasificaciones"
                                           ObtenerId="@(c => c.IdClasificaionCliente)"
                                           ObtenerTexto="@(c => c.Descripcion)" />
                </MudItem>
            </MudGrid>

            <div class="d-flex justify-end mt-3 contenedor-generar">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Assessment"
                           OnClick="GenerarAntiguedadAsync" Disabled="_cargando" Class="boton-generar">
                    Generar reporte
                </MudButton>
            </div>
        </MudPaper>

        @if (_cargando && _tabActivo == 1)
        {
            @CargandoFragment
        }
        else if (_antiguedad is not null)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-3 ma-2">
                <div class="seccion-titulo mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.HourglassBottom" Size="Size.Small" Class="mr-1" />
                    Antigüedad de saldos (@_antiguedad.Filas.Count clientes)
                </div>
                <MudGrid Spacing="2" Class="mb-3">
                    @Tarjeta("Saldo total", _antiguedad.SaldoTotal.ToString("C2"), Icons.Material.Filled.AccountBalanceWallet, Color.Error, 3)
                    @Tarjeta("Clientes vencidos", _antiguedad.ClientesVencidos.ToString("N0"), Icons.Material.Filled.Warning, Color.Warning, 3)
                    @Tarjeta("Saldo crítico (+30 días)", _antiguedad.SaldoCritico.ToString("C2"), Icons.Material.Filled.ReportProblem, Color.Error, 3)
                    @Tarjeta("Máximo atraso", _antiguedad.MaximoAtraso + " días", Icons.Material.Filled.HourglassBottom, Color.Secondary, 3)
                </MudGrid>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @foreach (var rango in _antiguedad.Rangos)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@ColorRango(rango.Rango)">
                            @rango.Rango: @rango.Clientes cliente(s) · @rango.SaldoPendiente.ToString("C2") (@rango.Porcentaje.ToString("0.##")%)
                        </MudChip>
                    }
                </div>
                <div class="contenedor-exportar mb-3">
                    <MudButton Variant="Variant.Outlined" Color="Color.Success" Class="boton-exportar" StartIcon="@Icons.Material.Filled.FileDownload"
                               OnClick="ExportarAntiguedad" Disabled="@(_cargando || _exportando || _antiguedad.Filas.Count == 0)">
                        Exportar a Excel
                    </MudButton>
                </div>
                <MudTextField T="string" @bind-Value="_antBusqueda" Immediate="true"
                              Placeholder="Buscar por cliente, dirección, teléfono, zona, ruta, clasificación o rango…"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Class="mb-3" />
                <MudTable Items="_antiguedad.Filas" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm"
                          Elevation="0" RowsPerPage="15" T="ReporteAntiguedadFila" Class="tabla-seguimiento"
                          Filter="new Func<ReporteAntiguedadFila, bool>(FiltrarAntiguedad)">
                    <HeaderContent>
                        <MudTh><MudTableSortLabel SortBy="new Func<ReporteAntiguedadFila, object>(x => x.Cliente)">Cliente</MudTableSortLabel></MudTh>
                        <MudTh>Dirección</MudTh>
                        <MudTh>Teléfono</MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ReporteAntiguedadFila, object>(x => x.Zona ?? string.Empty)">Zona</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ReporteAntiguedadFila, object>(x => x.Ruta ?? string.Empty)">Ruta</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ReporteAntiguedadFila, object>(x => x.Clasificacion ?? string.Empty)">Clasificación</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ReporteAntiguedadFila, object>(x => (object?)x.FechaUltimoPago ?? DateTimeOffset.MinValue)">Último pago</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right;"><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<ReporteAntiguedadFila, object>(x => x.DiasTranscurridos)">Días transcurridos</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right;"><MudTableSortLabel SortBy="new Func<ReporteAntiguedadFila, object>(x => x.SaldoPendiente)">Saldo pendiente</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ReporteAntiguedadFila, object>(x => x.Rango)">Rango</MudTableSortLabel></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Cliente"><b>@context.Cliente</b></MudTd>
                        <MudTd DataLabel="Dirección">@Mostrar(context.Direccion)</MudTd>
                        <MudTd DataLabel="Teléfono">@Mostrar(context.TelefonoPrincipal)</MudTd>
                        <MudTd DataLabel="Zona">@Mostrar(context.Zona)</MudTd>
                        <MudTd DataLabel="Ruta">@Mostrar(context.Ruta)</MudTd>
                        <MudTd DataLabel="Clasificación">@Mostrar(context.Clasificacion)</MudTd>
                        <MudTd DataLabel="Último pago">@FechaCorta(context.FechaUltimoPago)</MudTd>
                        <MudTd DataLabel="Días transcurridos" Style="text-align:right;">@context.DiasTranscurridos</MudTd>
                        <MudTd DataLabel="Saldo pendiente" Style="text-align:right;"><b>@context.SaldoPendiente.ToString("C2")</b></MudTd>
                        <MudTd DataLabel="Rango"><MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@ColorRango(context.Rango)">@context.Rango</MudChip></MudTd>
                    </RowTemplate>
                    <NoRecordsContent>@SinDatosFragment</NoRecordsContent>
                    <PagerContent>
                        <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Filas:" />
                    </PagerContent>
                </MudTable>
            </MudPaper>
        }
    </MudTabPanel>

    <!-- ===================== SIN PAGO RECIENTE ===================== -->
    <MudTabPanel Text="Sin pago reciente" Icon="@Icons.Material.Filled.MoneyOff">
        <MudPaper Elevation="0" Class="pa-4">
            <div class="seccion-titulo mb-3">
                <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="Size.Small" Class="mr-1" />
                Filtros de clientes sin pago reciente
            </div>
            <MudGrid Spacing="2" Class="align-end">
                <MudItem xs="12" sm="6" md="3">
                    <AutocompletarCatalogo TItem="ZonaDto" Label="Zona" Placeholder="Todas"
                                           @bind-Value="_spZona"
                                           Items="_zonas"
                                           ObtenerId="@(z => z.IdZona)"
                                           ObtenerTexto="@(z => z.Descripcion)" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <AutocompletarCatalogo TItem="RutaAdminDto" Label="Ruta" Placeholder="Todas"
                                           @bind-Value="_spRuta"
                                           Items="_rutas"
                                           ObtenerId="@(r => r.IdRuta)"
                                           ObtenerTexto="@(r => r.Descripcion)" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <AutocompletarCatalogo TItem="ClasificaionClienteDto" Label="Clasificación" Placeholder="Todas"
                                           @bind-Value="_spClasificacion"
                                           Items="_clasificaciones"
                                           ObtenerId="@(c => c.IdClasificaionCliente)"
                                           ObtenerTexto="@(c => c.Descripcion)" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField T="int" Label="Días sin pago (mínimo)" @bind-Value="_spDias" Min="0" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>

            <div class="d-flex justify-end mt-3 contenedor-generar">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Assessment"
                           OnClick="GenerarSinPagoAsync" Disabled="_cargando" Class="boton-generar">
                    Generar reporte
                </MudButton>
            </div>
        </MudPaper>

        @if (_cargando && _tabActivo == 2)
        {
            @CargandoFragment
        }
        else if (_sinPago is not null)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-3 ma-2">
                <div class="seccion-titulo mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.MoneyOff" Size="Size.Small" Class="mr-1" />
                    Clientes sin pago reciente (@_sinPago.Total)
                </div>
                <MudGrid Spacing="2" Class="mb-3">
                    @Tarjeta("Clientes encontrados", _sinPago.Total.ToString("N0"), Icons.Material.Filled.People, Color.Primary, 3)
                    @Tarjeta("Saldo en riesgo", _sinPago.SaldoEnRiesgo.ToString("C2"), Icons.Material.Filled.AccountBalanceWallet, Color.Error, 3)
                    @Tarjeta("Promedio de días", _sinPago.PromedioDias.ToString("0.#"), Icons.Material.Filled.HourglassBottom, Color.Warning, 3)
                    @Tarjeta("Máximo atraso", _sinPago.MaximoAtraso + " días", Icons.Material.Filled.ReportProblem, Color.Secondary, 3)
                </MudGrid>
                <div class="contenedor-exportar mb-3">
                    <MudButton Variant="Variant.Outlined" Color="Color.Success" Class="boton-exportar" StartIcon="@Icons.Material.Filled.FileDownload"
                               OnClick="ExportarSinPago" Disabled="@(_cargando || _exportando || _sinPago.Filas.Count == 0)">
                        Exportar a Excel
                    </MudButton>
                </div>
                <MudTextField T="string" @bind-Value="_spBusqueda" Immediate="true"
                              Placeholder="Buscar por ID, cliente, dirección, teléfono, zona, ruta o clasificación…"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Class="mb-3" />
                <MudTable Items="_sinPago.Filas" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm"
                          Elevation="0" RowsPerPage="15" T="ReporteSinPagoFila" Class="tabla-seguimiento"
                          Filter="new Func<ReporteSinPagoFila, bool>(FiltrarSinPago)">
                    <HeaderContent>
                        <MudTh><MudTableSortLabel SortBy="new Func<ReporteSinPagoFila, object>(x => x.IdCliente)">ID cliente</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ReporteSinPagoFila, object>(x => x.Cliente)">Cliente</MudTableSortLabel></MudTh>
                        <MudTh>Dirección</MudTh>
                        <MudTh>Teléfono</MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ReporteSinPagoFila, object>(x => x.Zona ?? string.Empty)">Zona</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ReporteSinPagoFila, object>(x => x.Ruta ?? string.Empty)">Ruta</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ReporteSinPagoFila, object>(x => x.Clasificacion ?? string.Empty)">Clasificación</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ReporteSinPagoFila, object>(x => (object?)x.FechaUltimoPago ?? DateTimeOffset.MinValue)">Último pago</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right;"><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<ReporteSinPagoFila, object>(x => x.DiasSinPago)">Días sin pago</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right;"><MudTableSortLabel SortBy="new Func<ReporteSinPagoFila, object>(x => x.SaldoPendiente)">Saldo pendiente</MudTableSortLabel></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID cliente">@context.IdCliente</MudTd>
                        <MudTd DataLabel="Cliente"><b>@context.Cliente</b></MudTd>
                        <MudTd DataLabel="Dirección">@Mostrar(context.Direccion)</MudTd>
                        <MudTd DataLabel="Teléfono">@Mostrar(context.TelefonoPrincipal)</MudTd>
                        <MudTd DataLabel="Zona">@Mostrar(context.Zona)</MudTd>
                        <MudTd DataLabel="Ruta">@Mostrar(context.Ruta)</MudTd>
                        <MudTd DataLabel="Clasificación">@Mostrar(context.Clasificacion)</MudTd>
                        <MudTd DataLabel="Último pago">@FechaCorta(context.FechaUltimoPago)</MudTd>
                        <MudTd DataLabel="Días sin pago" Style="text-align:right;"><MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@ColorRango(RangoDias(context.DiasSinPago))">@context.DiasSinPago</MudChip></MudTd>
                        <MudTd DataLabel="Saldo pendiente" Style="text-align:right;"><b>@context.SaldoPendiente.ToString("C2")</b></MudTd>
                    </RowTemplate>
                    <NoRecordsContent>@SinDatosFragment</NoRecordsContent>
                    <PagerContent>
                        <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Filas:" />
                    </PagerContent>
                </MudTable>
            </MudPaper>
        }
    </MudTabPanel>

    <!-- ===================== RANKING DE DEUDORES ===================== -->
    <MudTabPanel Text="Ranking de deudores" Icon="@Icons.Material.Filled.EmojiEvents">
        <MudPaper Elevation="0" Class="pa-4">
            <div class="seccion-titulo mb-3">
                <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="Size.Small" Class="mr-1" />
                Filtros del ranking de deudores
            </div>
            <MudGrid Spacing="2" Class="align-end">
                <MudItem xs="12" sm="6" md="4">
                    <AutocompletarCatalogo TItem="ZonaDto" Label="Zona" Placeholder="Todas"
                                           @bind-Value="_rkZona"
                                           Items="_zonas"
                                           ObtenerId="@(z => z.IdZona)"
                                           ObtenerTexto="@(z => z.Descripcion)" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <AutocompletarCatalogo TItem="RutaAdminDto" Label="Ruta" Placeholder="Todas"
                                           @bind-Value="_rkRuta"
                                           Items="_rutas"
                                           ObtenerId="@(r => r.IdRuta)"
                                           ObtenerTexto="@(r => r.Descripcion)" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <AutocompletarCatalogo TItem="ClasificaionClienteDto" Label="Clasificación" Placeholder="Todas"
                                           @bind-Value="_rkClasificacion"
                                           Items="_clasificaciones"
                                           ObtenerId="@(c => c.IdClasificaionCliente)"
                                           ObtenerTexto="@(c => c.Descripcion)" />
                </MudItem>
            </MudGrid>

            <div class="d-flex justify-end mt-3 contenedor-generar">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Assessment"
                           OnClick="GenerarRankingAsync" Disabled="_cargando" Class="boton-generar">
                    Generar reporte
                </MudButton>
            </div>
        </MudPaper>

        @if (_cargando && _tabActivo == 3)
        {
            @CargandoFragment
        }
        else if (_ranking is not null)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-3 ma-2">
                <div class="seccion-titulo mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Size="Size.Small" Class="mr-1" />
                    Ranking de deudores (@_ranking.Filas.Count)
                </div>
                <MudGrid Spacing="2" Class="mb-3">
                    @Tarjeta("Mayor deudor", Mostrar(_ranking.MayorDeudor), Icons.Material.Filled.EmojiEvents, Color.Secondary, 3)
                    @Tarjeta("Top 10 acumulado", _ranking.Top10Acumulado.ToString("C2"), Icons.Material.Filled.Leaderboard, Color.Error, 3)
                    @Tarjeta("Saldo total", _ranking.SaldoTotal.ToString("C2"), Icons.Material.Filled.AccountBalanceWallet, Color.Warning, 3)
                    @Tarjeta("Participación Top 10", _ranking.ParticipacionTop10.ToString("0.##") + " %", Icons.Material.Filled.PieChart, Color.Info, 3)
                </MudGrid>
                <div class="contenedor-exportar mb-3">
                    <MudButton Variant="Variant.Outlined" Color="Color.Success" Class="boton-exportar" StartIcon="@Icons.Material.Filled.FileDownload"
                               OnClick="ExportarRanking" Disabled="@(_cargando || _exportando || _ranking.Filas.Count == 0)">
                        Exportar a Excel
                    </MudButton>
                </div>
                <MudTextField T="string" @bind-Value="_rkBusqueda" Immediate="true"
                              Placeholder="Buscar por cliente, dirección, teléfono, zona, ruta o clasificación…"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Class="mb-3" />
                <MudTable Items="_ranking.Filas" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm"
                          Elevation="0" RowsPerPage="15" T="ReporteRankingDeudoresFila" Class="tabla-seguimiento"
                          Filter="new Func<ReporteRankingDeudoresFila, bool>(FiltrarRanking)">
                    <HeaderContent>
                        <MudTh><MudTableSortLabel SortBy="new Func<ReporteRankingDeudoresFila, object>(x => x.Posicion)">Posición</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ReporteRankingDeudoresFila, object>(x => x.Cliente)">Cliente</MudTableSortLabel></MudTh>
                        <MudTh>Dirección</MudTh>
                        <MudTh>Teléfono</MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ReporteRankingDeudoresFila, object>(x => x.Zona ?? string.Empty)">Zona</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ReporteRankingDeudoresFila, object>(x => x.Ruta ?? string.Empty)">Ruta</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ReporteRankingDeudoresFila, object>(x => x.Clasificacion ?? string.Empty)">Clasificación</MudTableSortLabel></MudTh>
