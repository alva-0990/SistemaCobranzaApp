@page "/operaciones-ventas"

@using MudBlazor
@using SistemaCobranzaApp.Shared.Components
@using SistemaCobranzaApp.Shared.Dtos
@using SistemaCobranzaApp.Shared.Services
@inject ApiCliente Api
@inject IDialogService _dialogo
@inject ISnackbar _snackbar

<MudTabs Elevation="2" Rounded="true" Color="Color.Primary" ApplyEffectsToContainer="true"
         PanelClass="pa-0 pt-4" SliderColor="Color.Warning" Class="ma-2 tabs-remarcados">

    <!-- ===================== CONDICIONES ===================== -->
    <MudTabPanel Text="Condiciones" Icon="@Icons.Material.Filled.CreditCard">
        <MudPaper Elevation="0" Class="pa-4">
            <div class="barra-acciones">
                <MudTextField T="string"
                              Value="_busquedaCondicion"
                              ValueChanged="@(v => { _busquedaCondicion = v; })"
                              Immediate="true"
                              Placeholder="Buscar condición por descripción o ID..."
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              AdornmentColor="Color.Primary"
                              Clearable="true"
                              Class="buscador-remarcado" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AbrirModalNuevaCondicion"
                           Class="boton-nuevo">
                    Nueva condición
                </MudButton>
            </div>

            @if (_cargandoCondiciones)
            {
                <div class="d-flex justify-center pa-8">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                </div>
            }
            else
            {
                <MudTable Items="CondicionesFiltradas" Hover="true" Dense="true"
                          Breakpoint="Breakpoint.Sm" Elevation="0" RowsPerPage="10">
                    <HeaderContent>
                        <MudTh Style="width:10%;">ID</MudTh>
                        <MudTh>Descripción</MudTh>
                        <MudTh Style="width:15%;">Estatus</MudTh>
                        <MudTh Style="width:15%; text-align:right;">Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">@context.IdCondicion</MudTd>
                        <MudTd DataLabel="Descripción"><b>@context.Descripcion</b></MudTd>
                        <MudTd DataLabel="Estatus">@ChipEstatus(context.Activo)</MudTd>
                        <MudTd DataLabel="Acciones" Style="text-align:right;">
                            @AccionesFila(() => AbrirModalEditarCondicion(context),
                                () => AlternarEstatusCondicion(context), context.Activo)
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>@EstadoVacio("No hay condiciones que coincidan.")</NoRecordsContent>
                    <PagerContent>
                        <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Filas:" />
                    </PagerContent>
                </MudTable>
            }
        </MudPaper>
    </MudTabPanel>

    <!-- ===================== PLAZOS / MESES ===================== -->
    <MudTabPanel Text="Plazos / Meses" Icon="@Icons.Material.Filled.CalendarMonth">
        <MudPaper Elevation="0" Class="pa-4">
            <div class="barra-acciones">
                <MudTextField T="string"
                              Value="_busquedaMes"
                              ValueChanged="@(v => { _busquedaMes = v; })"
                              Immediate="true"
                              Placeholder="Buscar plazo por descripción, meses o ID..."
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              AdornmentColor="Color.Secondary"
                              Clearable="true"
                              Class="buscador-remarcado" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AbrirModalNuevoMes"
                           Class="boton-nuevo">
                    Nuevo plazo
                </MudButton>
            </div>

            @if (_cargandoMeses)
            {
                <div class="d-flex justify-center pa-8">
                    <MudProgressCircular Indeterminate="true" Color="Color.Secondary" />
                </div>
            }
            else
            {
                <MudTable Items="MesesFiltrados" Hover="true" Dense="true"
                          Breakpoint="Breakpoint.Sm" Elevation="0" RowsPerPage="10">
                    <HeaderContent>
                        <MudTh Style="width:10%;">ID</MudTh>
                        <MudTh Style="width:15%;">Meses</MudTh>
                        <MudTh>Descripción</MudTh>
                        <MudTh Style="width:15%;">Estatus</MudTh>
                        <MudTh Style="width:15%; text-align:right;">Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">@context.Id</MudTd>
                        <MudTd DataLabel="Meses">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary">
                                @context.NumMeses
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Descripción"><b>@context.Descripcion</b></MudTd>
                        <MudTd DataLabel="Estatus">@ChipEstatus(context.Activo)</MudTd>
                        <MudTd DataLabel="Acciones" Style="text-align:right;">
                            @AccionesFila(() => AbrirModalEditarMes(context),
                                () => AlternarEstatusMes(context), context.Activo)
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>@EstadoVacio("No hay plazos que coincidan.")</NoRecordsContent>
                    <PagerContent>
                        <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Filas:" />
                    </PagerContent>
                </MudTable>
            }
        </MudPaper>
    </MudTabPanel>

    <!-- ===================== MOVIMIENTOS ===================== -->
    <MudTabPanel Text="Movimientos" Icon="@Icons.Material.Filled.SwapHoriz">
        <MudPaper Elevation="0" Class="pa-4">
            <div class="barra-acciones">
                <MudTextField T="string"
                              Value="_busquedaMovimiento"
                              ValueChanged="@(v => { _busquedaMovimiento = v; })"
                              Immediate="true"
                              Placeholder="Buscar movimiento por descripción o ID..."
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              AdornmentColor="Color.Primary"
                              Clearable="true"
                              Class="buscador-remarcado" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AbrirModalNuevoMovimiento"
                           Class="boton-nuevo">
                    Nuevo movimiento
                </MudButton>
            </div>

            @if (_cargandoMovimientos)
            {
                <div class="d-flex justify-center pa-8">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                </div>
            }
            else
            {
                <MudTable Items="MovimientosFiltrados" Hover="true" Dense="true"
                          Breakpoint="Breakpoint.Sm" Elevation="0" RowsPerPage="10">
                    <HeaderContent>
                        <MudTh Style="width:10%;">ID</MudTh>
                        <MudTh>Descripción</MudTh>
                        <MudTh Style="width:15%;">Estatus</MudTh>
                        <MudTh Style="width:15%; text-align:right;">Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">@context.Id</MudTd>
                        <MudTd DataLabel="Descripción"><b>@context.Descripcion</b></MudTd>
                        <MudTd DataLabel="Estatus">@ChipEstatus(context.Activo)</MudTd>
                        <MudTd DataLabel="Acciones" Style="text-align:right;">
                            @AccionesFila(() => AbrirModalEditarMovimiento(context),
                                () => AlternarEstatusMovimiento(context), context.Activo)
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>@EstadoVacio("No hay movimientos que coincidan.")</NoRecordsContent>
                    <PagerContent>
                        <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Filas:" />
                    </PagerContent>
                </MudTable>
            }
        </MudPaper>
    </MudTabPanel>

    <!-- ===================== ESTATUS VENTA ===================== -->
    <MudTabPanel Text="Estatus Venta" Icon="@Icons.Material.Filled.FactCheck">
        <MudPaper Elevation="0" Class="pa-4">
            <div class="barra-acciones">
                <MudTextField T="string"
                              Value="_busquedaEstatus"
                              ValueChanged="@(v => { _busquedaEstatus = v; })"
                              Immediate="true"
                              Placeholder="Buscar estatus por descripción o ID..."
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              AdornmentColor="Color.Secondary"
                              Clearable="true"
                              Class="buscador-remarcado" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AbrirModalNuevoEstatus"
                           Class="boton-nuevo">
                    Nuevo estatus
                </MudButton>
            </div>

            @if (_cargandoEstatus)
            {
                <div class="d-flex justify-center pa-8">
                    <MudProgressCircular Indeterminate="true" Color="Color.Secondary" />
                </div>
            }
            else
            {
                <MudTable Items="EstatusFiltrados" Hover="true" Dense="true"
                          Breakpoint="Breakpoint.Sm" Elevation="0" RowsPerPage="10">
                    <HeaderContent>
                        <MudTh Style="width:10%;">ID</MudTh>
                        <MudTh>Descripción</MudTh>
                        <MudTh Style="width:15%;">Estatus</MudTh>
                        <MudTh Style="width:15%; text-align:right;">Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">@context.Id</MudTd>
                        <MudTd DataLabel="Descripción"><b>@context.Descripcion</b></MudTd>
                        <MudTd DataLabel="Estatus">@ChipEstatus(context.Activo)</MudTd>
                        <MudTd DataLabel="Acciones" Style="text-align:right;">
                            @AccionesFila(() => AbrirModalEditarEstatus(context),
                                () => AlternarEstatusEstatus(context), context.Activo)
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>@EstadoVacio("No hay estatus que coincidan.")</NoRecordsContent>
                    <PagerContent>
                        <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Filas:" />
                    </PagerContent>
                </MudTable>
            }
        </MudPaper>
    </MudTabPanel>

    <!-- ===================== FRECUENCIAS DE PAGO ===================== -->
    <MudTabPanel Text="Frecuencias de Pago" Icon="@Icons.Material.Filled.EventRepeat">
        <MudPaper Elevation="0" Class="pa-4">
            <div class="barra-acciones">
                <MudTextField T="string"
                              Value="_busquedaFrecuencia"
                              ValueChanged="@(v => { _busquedaFrecuencia = v; })"
                              Immediate="true"
                              Placeholder="Buscar frecuencia por descripción, días o ID..."
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              AdornmentColor="Color.Primary"
                              Clearable="true"
                              Class="buscador-remarcado" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AbrirModalNuevaFrecuencia"
                           Class="boton-nuevo">
                    Nueva frecuencia
                </MudButton>
            </div>

            @if (_cargandoFrecuencias)
            {
                <div class="d-flex justify-center pa-8">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                </div>
            }
            else
            {
                <MudTable Items="FrecuenciasFiltradas" Hover="true" Dense="true"
                          Breakpoint="Breakpoint.Sm" Elevation="0" RowsPerPage="10">
                    <HeaderContent>
                        <MudTh Style="width:10%;">ID</MudTh>
                        <MudTh Style="width:15%;">Días periodo</MudTh>
                        <MudTh>Descripción</MudTh>
                        <MudTh Style="width:15%;">Estatus</MudTh>
                        <MudTh Style="width:15%; text-align:right;">Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">@context.Id</MudTd>
                        <MudTd DataLabel="Días periodo">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">
                                @context.DiasPeriodo
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Descripción"><b>@context.Descripcion</b></MudTd>
                        <MudTd DataLabel="Estatus">@ChipEstatus(context.Activo)</MudTd>
                        <MudTd DataLabel="Acciones" Style="text-align:right;">
                            @AccionesFila(() => AbrirModalEditarFrecuencia(context),
                                () => AlternarEstatusFrecuencia(context), context.Activo)
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>@EstadoVacio("No hay frecuencias que coincidan.")</NoRecordsContent>
                    <PagerContent>
                        <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Filas:" />
                    </PagerContent>
                </MudTable>
            }
        </MudPaper>
    </MudTabPanel>
    <!-- ===================== CATÁLOGO DE COMISIONES ===================== -->
    <MudTabPanel Text="Catálogo de comisión ventas" Icon="@Icons.Material.Filled.Percent">
        <MudPaper Elevation="0" Class="pa-4">
            <div class="barra-acciones">
                <MudTextField T="string" @bind-Value="_busquedaComision" Immediate="true"
                              Placeholder="Buscar comisión por nombre, tipo de cálculo o ID..."
                              Variant="Variant.Outlined" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" AdornmentColor="Color.Primary"
                              Clearable="true" Class="buscador-remarcado" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="AbrirModalNuevaComision"
                           Class="boton-nuevo">Nueva comisión</MudButton>
            </div>
            @if (_cargandoComisiones)
            {
                <div class="d-flex justify-center pa-8">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                </div>
            }
            else
            {
                <MudTable Items="ComisionesFiltradas" Hover="true" Dense="true"
                          Breakpoint="Breakpoint.Sm" Elevation="0" RowsPerPage="10">
                    <HeaderContent>
                        <MudTh>ID</MudTh>
                        <MudTh>Nombre del esquema</MudTh>
                        <MudTh>Tipo de cálculo</MudTh>
                        <MudTh>Comisión contado</MudTh>
                        <MudTh>Comisión crédito</MudTh>
                        <MudTh>Estatus</MudTh>
                        <MudTh Style="text-align:right;">Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">@context.Id</MudTd>
                        <MudTd DataLabel="Nombre del esquema"><b>@context.NombreEsquema</b></MudTd>
                        <MudTd DataLabel="Tipo de cálculo">@(context.TipoCalculo == "PORCENTAJE" ? "Porcentaje" : "Monto fijo")</MudTd>
                        <MudTd DataLabel="Comisión contado">@FormatearComision(context.ComisionContado, context.TipoCalculo)</MudTd>
                        <MudTd DataLabel="Comisión crédito">@FormatearComision(context.ComisionCredito, context.TipoCalculo)</MudTd>
                        <MudTd DataLabel="Estatus">@ChipEstatus(context.Activo)</MudTd>
                        <MudTd DataLabel="Acciones" Style="text-align:right;">
                            @AccionesFila(() => AbrirModalEditarComision(context),
                                () => AlternarEstatusComision(context), context.Activo)
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>@EstadoVacio("No hay comisiones que coincidan.")</NoRecordsContent>
                    <PagerContent>
                        <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Filas:" />
                    </PagerContent>
                </MudTable>
            }
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@{
    RenderFragment ChipEstatus(bool activo) => __builder =>
    {
        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                 Color="@(activo ? Color.Success : Color.Default)">
            @(activo ? "Activo" : "Inactivo")
        </MudChip>
    };

    RenderFragment AccionesFila(Func<Task> onEditar, Func<Task> onAlternar, bool activo) => __builder =>
    {
        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Info"
                       Title="Editar" OnClick="@(async () => await onEditar())" />
        @if (activo)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Error"
                           Title="Desactivar" OnClick="@(async () => await onAlternar())" />
        }
        else
        {
            <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success"
                           Title="Reactivar" OnClick="@(async () => await onAlternar())" />
        }
    };

    RenderFragment EstadoVacio(string mensaje) => __builder =>
    {
        <div class="pa-8 text-center">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary" />
            <MudText Color="Color.Secondary" Class="mt-2">@mensaje</MudText>
        </div>
    };
}

<style>
    .barra-acciones {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
    }

    .barra-acciones .buscador-remarcado { flex: 1 1 auto; min-width: 0; }
    .boton-nuevo { white-space: nowrap; flex: 0 0 auto; }
    .buscador-remarcado .mud-input-outlined-border { border-width: 2px; }

    .tabs-remarcados .mud-tab { opacity: 0.65; font-weight: 500; transition: opacity 0.15s ease, background-color 0.15s ease; }
    .tabs-remarcados .mud-tab.mud-tab-active { opacity: 1; font-weight: 800; background-color: rgba(255,255,255,0.18); border-radius: 8px 8px 0 0; }
    .tabs-remarcados .mud-tab-slider { height: 4px; }
</style>

@code {
    private List<CondicionCreditoDto> _condiciones = new();
    private List<MesDto> _meses = new();
    private List<MovimientoDto> _movimientos = new();
    private List<EstatusVentaDto> _estatus = new();
    private List<CatalogoFrecuenciaPagoDto> _frecuencias = new();

    private List<CatalogoComisionDto> _comisiones = new();
    private bool _cargandoComisiones;
    private string _busquedaComision = "";

    private IEnumerable<CatalogoComisionDto> ComisionesFiltradas
    {
        get
        {
            var q = _busquedaComision?.Trim() ?? "";
            return string.IsNullOrEmpty(q) ? _comisiones : _comisiones.Where(x =>
                x.Id.ToString().Contains(q, StringComparison.OrdinalIgnoreCase)
                || x.NombreEsquema.Contains(q, StringComparison.OrdinalIgnoreCase)
                || x.TipoCalculo.Contains(q, StringComparison.OrdinalIgnoreCase)
                || (x.TipoCalculo == "FIJO" && "Monto fijo".Contains(q, StringComparison.OrdinalIgnoreCase)));
        }
    }

    private static string FormatearComision(decimal valor, string tipoCalculo)
        => tipoCalculo == "PORCENTAJE" ? $"{valor:N2} %" : valor.ToString("C2");

    private bool _cargandoCondiciones;
    private bool _cargandoMeses;
    private bool _cargandoMovimientos;
    private bool _cargandoEstatus;
    private bool _cargandoFrecuencias;

    private string _busquedaCondicion = "";
    private string _busquedaMes = "";
    private string _busquedaMovimiento = "";
    private string _busquedaEstatus = "";
    private string _busquedaFrecuencia = "";

    // ===================== Filtros =====================

    private IEnumerable<CondicionCreditoDto> CondicionesFiltradas
    {
        get
        {
            var q = _busquedaCondicion?.Trim() ?? "";
            if (string.IsNullOrEmpty(q)) return _condiciones;
            return _condiciones.Where(x =>
                x.IdCondicion.ToString().Contains(q, StringComparison.OrdinalIgnoreCase)
                || (x.Descripcion ?? "").Contains(q, StringComparison.OrdinalIgnoreCase));
        }
    }

    private IEnumerable<MesDto> MesesFiltrados
    {
        get
        {
            var q = _busquedaMes?.Trim() ?? "";
            if (string.IsNullOrEmpty(q)) return _meses;
            return _meses.Where(x =>
                x.Id.ToString().Contains(q, StringComparison.OrdinalIgnoreCase)
                || x.NumMeses.ToString().Contains(q, StringComparison.OrdinalIgnoreCase)
                || (x.Descripcion ?? "").Contains(q, StringComparison.OrdinalIgnoreCase));
        }
    }

    private IEnumerable<MovimientoDto> MovimientosFiltrados
    {
        get
        {
            var q = _busquedaMovimiento?.Trim() ?? "";
            if (string.IsNullOrEmpty(q)) return _movimientos;
            return _movimientos.Where(x =>
                x.Id.ToString().Contains(q, StringComparison.OrdinalIgnoreCase)
                || (x.Descripcion ?? "").Contains(q, StringComparison.OrdinalIgnoreCase));
        }
    }

    private IEnumerable<EstatusVentaDto> EstatusFiltrados
    {
        get
        {
            var q = _busquedaEstatus?.Trim() ?? "";
            if (string.IsNullOrEmpty(q)) return _estatus;
            return _estatus.Where(x =>
                x.Id.ToString().Contains(q, StringComparison.OrdinalIgnoreCase)
                || (x.Descripcion ?? "").Contains(q, StringComparison.OrdinalIgnoreCase));
        }
    }

    private IEnumerable<CatalogoFrecuenciaPagoDto> FrecuenciasFiltradas
    {
        get
        {
            var q = _busquedaFrecuencia?.Trim() ?? "";
            if (string.IsNullOrEmpty(q)) return _frecuencias;
            return _frecuencias.Where(x =>
                x.Id.ToString().Contains(q, StringComparison.OrdinalIgnoreCase)
                || x.DiasPeriodo.ToString().Contains(q, StringComparison.OrdinalIgnoreCase)
                || (x.Descripcion ?? "").Contains(q, StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarCondiciones();
        await CargarMeses();
        await CargarMovimientos();
        await CargarEstatus();
        await CargarFrecuencias();
        await CargarComisiones();
    }

    // ===================== Carga =====================

    private async Task CargarCondiciones()
    {
        _cargandoCondiciones = true;
        var (datos, error) = await Api.ListarCondicionesCreditoAdminAsync();
        if (error is not null) _snackbar.Add(error, Severity.Error);
        _condiciones = datos ?? new();
        _cargandoCondiciones = false;
    }

    private async Task CargarMeses()
    {
        _cargandoMeses = true;
        var (datos, error) = await Api.ListarMesesAdminAsync();
        if (error is not null) _snackbar.Add(error, Severity.Error);
        _meses = datos ?? new();
        _cargandoMeses = false;
    }

    private async Task CargarMovimientos()
    {
        _cargandoMovimientos = true;
        var (datos, error) = await Api.ListarMovimientosAdminAsync();
        if (error is not null) _snackbar.Add(error, Severity.Error);
        _movimientos = datos ?? new();
        _cargandoMovimientos = false;
    }

    private async Task CargarEstatus()
    {
        _cargandoEstatus = true;
        var (datos, error) = await Api.ListarEstatusVentaAdminAsync();
        if (error is not null) _snackbar.Add(error, Severity.Error);
        _estatus = datos ?? new();
        _cargandoEstatus = false;
    }

    private async Task CargarFrecuencias()
    {
        _cargandoFrecuencias = true;
        var (datos, error) = await Api.ListarFrecuenciasPagoAdminAsync();
        if (error is not null) _snackbar.Add(error, Severity.Error);
        _frecuencias = datos ?? new();
        _cargandoFrecuencias = false;
    }

    // ===================== Condiciones =====================

    private async Task AbrirModalNuevaCondicion()
    {
        var modelo = new DialogoGenerico.FormModel { Activo = true };
