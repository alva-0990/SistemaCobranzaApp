    // ===================== Catálogo de comisiones =====================

    private async Task CargarComisiones()
    {
        _cargandoComisiones = true;
        try
        {
            var (datos, error) = await Api.ListarComisionesAdminAsync();
            if (error is not null) _snackbar.Add(error, Severity.Error);
            _comisiones = datos ?? new();
        }
        finally
        {
            _cargandoComisiones = false;
        }
    }

    private async Task AbrirModalNuevaComision()
    {
        var m = await MostrarDialogoComision("Registrar nueva comisión", new());
        if (m is null) return;

        var (_, error) = await Api.CrearComisionAsync(new CrearCatalogoComisionRequest(
            m.NombreEsquema.Trim(), m.TipoCalculo, m.ComisionContado, m.ComisionCredito));
        Notificar(error, $"Comisión '{m.NombreEsquema}' registrada.");
        if (error is null) await CargarComisiones();
    }

    private async Task AbrirModalEditarComision(CatalogoComisionDto c)
    {
        var modelo = new DialogoCatalogoComision.FormModel
        {
            NombreEsquema = c.NombreEsquema,
            TipoCalculo = c.TipoCalculo,
            ComisionContado = c.ComisionContado,
            ComisionCredito = c.ComisionCredito,
            Activo = c.Activo
        };
        var m = await MostrarDialogoComision("Modificar comisión", modelo, true);
        if (m is null) return;

        var (_, error) = await Api.ActualizarComisionAsync(c.Id, new ActualizarCatalogoComisionRequest(
            m.NombreEsquema.Trim(), m.TipoCalculo, m.ComisionContado, m.ComisionCredito, m.Activo));
        Notificar(error, $"Comisión '{m.NombreEsquema}' actualizada.");
        if (error is null) await CargarComisiones();
    }

    private async Task AlternarEstatusComision(CatalogoComisionDto c)
    {
        var (_, error) = c.Activo
            ? await Api.DarDeBajaComisionAsync(c.Id)
            : await Api.ActualizarComisionAsync(c.Id, new ActualizarCatalogoComisionRequest(
                c.NombreEsquema, c.TipoCalculo, c.ComisionContado, c.ComisionCredito, true));
        Notificar(error, $"Comisión '{c.NombreEsquema}' {(c.Activo ? "desactivada" : "reactivada")}.");
        if (error is null) await CargarComisiones();
    }

    private async Task<DialogoCatalogoComision.FormModel?> MostrarDialogoComision(
        string titulo, DialogoCatalogoComision.FormModel modelo, bool esEdicion = false)
    {
        var opciones = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var parametros = new DialogParameters<DialogoCatalogoComision>
        {
            { x => x.Titulo, titulo },
            { x => x.Modelo, modelo },
            { x => x.EsEdicion, esEdicion }
        };
        var dialogo = await _dialogo.ShowAsync<DialogoCatalogoComision>(titulo, parametros, opciones);
        var resultado = await dialogo.Result;
        return resultado is { Canceled: false, Data: DialogoCatalogoComision.FormModel datos } ? datos : null;
    }

