@page "/vendedores-cobradores"

@using MudBlazor
@using SistemaCobranzaApp.Shared.Components
@using SistemaCobranzaApp.Shared.Dtos
@using SistemaCobranzaApp.Shared.Services
@inject ApiCliente Api

<MudTabs Elevation="2" Rounded="true" Color="Color.Primary" ApplyEffectsToContainer="true"
         PanelClass="pa-0 pt-4" SliderColor="Color.Warning" Class="ma-2 tabs-remarcados">

    <!-- ===================== COBRADORES ===================== -->
    <MudTabPanel Text="Cobradores" Icon="@Icons.Material.Filled.Groups">
        <MudPaper Elevation="0" Class="pa-4">
            <div class="barra-acciones">
                <MudTextField T="string"
                              Value="_busquedaCobradores"
                              ValueChanged="@(v => { _busquedaCobradores = v; FiltrarCobradores(); })"
                              Immediate="true"
                              Placeholder="Buscar cobrador por nombre, zona o usuario..."
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              AdornmentColor="Color.Primary"
                              Clearable="true"
                              Class="buscador-remarcado" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PersonAdd"
                           OnClick="AbrirModalNuevoCobrador"
                           Class="boton-nuevo">
                    Nuevo
                </MudButton>
            </div>

            @if (_cargandoCobradores)
            {
                <div class="d-flex justify-center pa-8">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                </div>
            }
            else
            {
                <MudTable Items="_cobradoresFiltrados" Hover="true" Dense="true"
                          Breakpoint="Breakpoint.Sm" Elevation="0" RowsPerPage="10">
                    <HeaderContent>
                        <MudTh Style="width:10%;">ID</MudTh>
                        <MudTh>Nombre</MudTh>
                        <MudTh>Zona asignada</MudTh>
                        <MudTh>Usuario</MudTh>
                        <MudTh Style="width:15%;">Estatus</MudTh>
                        <MudTh Style="width:15%; text-align:right;">Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">@context.IdCobrador</MudTd>
                        <MudTd DataLabel="Nombre"><b>@context.Nombre</b></MudTd>
                        <MudTd DataLabel="Zona">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">
                                @(string.IsNullOrWhiteSpace(context.Zona) ? "Sin zona" : context.Zona)
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Usuario">@(context.Usuario ?? "Sin usuario")</MudTd>
                        <MudTd DataLabel="Estatus">@ChipEstatus(context.Activo)</MudTd>
                        <MudTd DataLabel="Acciones" Style="text-align:right;">
                            @AccionesFila(() => AbrirModalEditarCobrador(context),
                                () => AlternarEstatusCobrador(context), context.Activo)
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        @EstadoVacio("No hay cobradores que coincidan.")
                    </NoRecordsContent>
                    <PagerContent>
                        <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Filas:" />
                    </PagerContent>
                </MudTable>
            }
        </MudPaper>
    </MudTabPanel>

    <!-- ===================== VENDEDORES ===================== -->
    <MudTabPanel Text="Vendedores" Icon="@Icons.Material.Filled.Badge">
        <MudPaper Elevation="0" Class="pa-4">
            <div class="barra-acciones">
                <MudTextField T="string"
                              Value="_busquedaVendedores"
                              ValueChanged="@(v => { _busquedaVendedores = v; FiltrarVendedores(); })"
                              Immediate="true"
                              Placeholder="Buscar vendedor por nombre, zona o usuario..."
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              AdornmentColor="Color.Secondary"
                              Clearable="true"
                              Class="buscador-remarcado" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.PersonAdd"
                           OnClick="AbrirModalNuevoVendedor"
                           Class="boton-nuevo">
                    Nuevo
                </MudButton>
            </div>

            @if (_cargandoVendedores)
            {
                <div class="d-flex justify-center pa-8">
                    <MudProgressCircular Indeterminate="true" Color="Color.Secondary" />
                </div>
            }
            else
            {
                <MudTable Items="_vendedoresFiltrados" Hover="true" Dense="true"
                          Breakpoint="Breakpoint.Sm" Elevation="0" RowsPerPage="10">
                    <HeaderContent>
                        <MudTh Style="width:10%;">ID</MudTh>
                        <MudTh>Nombre</MudTh>
                        <MudTh>Zona asignada</MudTh>
                        <MudTh>Usuario</MudTh>
                        <MudTh Style="width:15%;">Estatus</MudTh>
                        <MudTh Style="width:15%; text-align:right;">Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">@context.IdVendedor</MudTd>
                        <MudTd DataLabel="Nombre"><b>@context.Nombre</b></MudTd>
                        <MudTd DataLabel="Zona">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary">
                                @(string.IsNullOrWhiteSpace(context.Zona) ? "Sin zona" : context.Zona)
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Usuario">@(context.Usuario ?? "Sin usuario")</MudTd>
                        <MudTd DataLabel="Estatus">@ChipEstatus(context.Activo)</MudTd>
                        <MudTd DataLabel="Acciones" Style="text-align:right;">
                            @AccionesFila(() => AbrirModalEditarVendedor(context),
                                () => AlternarEstatusVendedor(context), context.Activo)
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        @EstadoVacio("No hay vendedores que coincidan.")
                    </NoRecordsContent>
                    <PagerContent>
                        <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Filas:" />
                    </PagerContent>
                </MudTable>
            }
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@{
    RenderFragment ChipEstatus(bool activo) => __builder =>
    {
        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                 Color="@(activo ? Color.Success : Color.Default)">
            @(activo ? "Activo" : "Inactivo")
        </MudChip>
    };

    // Acciones de fila: Editar + alternar Baja/Reactivar según el estatus.
    RenderFragment AccionesFila(Func<Task> onEditar, Func<Task> onAlternar, bool activo) => __builder =>
    {
        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Info"
                       Title="Editar" OnClick="@(async () => await onEditar())" />
        @if (activo)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Error"
                           Title="Dar de baja" OnClick="@(async () => await onAlternar())" />
        }
        else
        {
            <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success"
                           Title="Reactivar" OnClick="@(async () => await onAlternar())" />
        }
    };

    RenderFragment EstadoVacio(string mensaje) => __builder =>
    {
        <div class="pa-8 text-center">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary" />
            <MudText Color="Color.Secondary" Class="mt-2">@mensaje</MudText>
        </div>
    };
}

<style>
    .barra-acciones {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
    }

    .barra-acciones .buscador-remarcado { flex: 1 1 auto; min-width: 0; }
    .boton-nuevo { white-space: nowrap; flex: 0 0 auto; }

    /* Buscador remarcado */
    .buscador-remarcado .mud-input-outlined-border { border-width: 2px; }

    /* ===== Tabs: resaltar claramente el seleccionado ===== */
    /* Tabs inactivos: atenuados para contraste. */
    .tabs-remarcados .mud-tab {
        opacity: 0.65;
        font-weight: 500;
        transition: opacity 0.15s ease, background-color 0.15s ease;
    }

    /* Tab activo: totalmente opaco, en negrita y con fondo sutil. */
    .tabs-remarcados .mud-tab.mud-tab-active {
        opacity: 1;
        font-weight: 800;
        background-color: rgba(255, 255, 255, 0.18);
        border-radius: 8px 8px 0 0;
    }

    /* Subrayado (slider) del tab activo más grueso y visible. */
    .tabs-remarcados .mud-tab-slider {
        height: 4px;
    }
</style>

@code {
    [Inject] private IDialogService _dialogo { get; set; } = null!;
    [Inject] private ISnackbar _snackbar { get; set; } = null!;

    private string _busquedaCobradores = "";
    private string _busquedaVendedores = "";
    private bool _cargandoCobradores;
    private bool _cargandoVendedores;

    private List<CobradorDto> _cobradoresTodo = new();
    private List<CobradorDto> _cobradoresFiltrados = new();
    private List<VendedorDto> _vendedoresTodo = new();
    private List<VendedorDto> _vendedoresFiltrados = new();
    private List<ZonaDto> _zonas = new();
    private List<UsuarioDto> _usuarios = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarZonas();
        await CargarCobradores();
        await CargarVendedores();
    }

    private async Task CargarZonas()
    {
        var (datos, _) = await Api.ListarZonasOperativasAsync();
        _zonas = datos ?? new();
    }

    private async Task CargarCobradores()
    {
        _cargandoCobradores = true;
        var (datos, error) = await Api.ListarCobradoresAdminAsync(incluirInactivos: true);
        if (error is not null) _snackbar.Add(error, Severity.Error);
        _cobradoresTodo = datos ?? new();
        FiltrarCobradores();
        _cargandoCobradores = false;
    }

    private async Task CargarVendedores()
    {
        _cargandoVendedores = true;
        var (datos, error) = await Api.ListarVendedoresAdminAsync(incluirInactivos: true);
        if (error is not null) _snackbar.Add(error, Severity.Error);
        _vendedoresTodo = datos ?? new();
        FiltrarVendedores();
        _cargandoVendedores = false;
    }

    private void FiltrarCobradores()
    {
        var q = _busquedaCobradores?.Trim() ?? "";
        _cobradoresFiltrados = string.IsNullOrEmpty(q)
            ? _cobradoresTodo
            : _cobradoresTodo.Where(c =>
                (c.Nombre?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                || (c.Zona?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                || (c.Usuario?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
    }

    private void FiltrarVendedores()
    {
        var q = _busquedaVendedores?.Trim() ?? "";
        _vendedoresFiltrados = string.IsNullOrEmpty(q)
            ? _vendedoresTodo
            : _vendedoresTodo.Where(v =>
                (v.Nombre?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                || (v.Zona?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                || (v.Usuario?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
    }

    // ===================== Cobradores =====================

    private async Task AbrirModalNuevoCobrador()
    {
        var modelo = new DialogoPersona.FormModel { Activo = true };
        var m = await MostrarDialogo("Dar de alta cobrador", Icons.Material.Filled.PersonAdd, "Nombre del cobrador", modelo);
        if (m is null) return;

        var (_, error) = await Api.CrearCobradorAsync(m.Nombre, m.IdZona, idUsuario: m.IdUsuario);
        Notificar(error, $"Cobrador '{m.Nombre}' registrado.");
        if (error is null) await CargarCobradores();
    }

    private async Task AbrirModalEditarCobrador(CobradorDto c)
    {
        var modelo = new DialogoPersona.FormModel { Nombre = c.Nombre, IdZona = c.IdZona, IdUsuario = c.IdUsuario, Activo = c.Activo };
        var m = await MostrarDialogo("Modificar cobrador", Icons.Material.Filled.Badge, "Nombre del cobrador", modelo);
        if (m is null) return;

        var (_, error) = await Api.ActualizarCobradorAsync(c.IdCobrador, m.Nombre, m.IdZona, m.Activo, idUsuario: m.IdUsuario);
        Notificar(error, $"Cobrador '{m.Nombre}' actualizado.");
        if (error is null) await CargarCobradores();
    }

    // Alterna estatus: si está activo lo da de baja; si está inactivo lo reactiva.
    private async Task AlternarEstatusCobrador(CobradorDto c)
    {
        if (c.Activo)
        {
            var (_, error) = await Api.DarDeBajaCobradorAsync(c.IdCobrador);
            Notificar(error, $"Cobrador '{c.Nombre}' dado de baja.");
            if (error is null) await CargarCobradores();
        }
        else
        {
            // Reactivar: actualizamos conservando nombre/zona y marcando activo.
            var (_, error) = await Api.ActualizarCobradorAsync(c.IdCobrador, c.Nombre, c.IdZona, true, idUsuario: c.IdUsuario);
            Notificar(error, $"Cobrador '{c.Nombre}' reactivado.");
            if (error is null) await CargarCobradores();
        }
    }

    // ===================== Vendedores =====================

    private async Task AbrirModalNuevoVendedor()
    {
        var modelo = new DialogoPersona.FormModel { Activo = true };
        var m = await MostrarDialogo("Dar de alta vendedor", Icons.Material.Filled.GroupAdd, "Nombre del vendedor", modelo);
        if (m is null) return;

        var (_, error) = await Api.CrearVendedorAsync(m.Nombre, m.IdZona, idUsuario: m.IdUsuario);
        Notificar(error, $"Vendedor '{m.Nombre}' registrado.");
        if (error is null) await CargarVendedores();
    }

    private async Task AbrirModalEditarVendedor(VendedorDto v)
    {
        var modelo = new DialogoPersona.FormModel { Nombre = v.Nombre, IdZona = v.IdZona, IdUsuario = v.IdUsuario, Activo = v.Activo };
        var m = await MostrarDialogo("Modificar vendedor", Icons.Material.Filled.ManageAccounts, "Nombre del vendedor", modelo);
        if (m is null) return;

        var (_, error) = await Api.ActualizarVendedorAsync(v.IdVendedor, m.Nombre, m.IdZona, m.Activo, idUsuario: m.IdUsuario);
        Notificar(error, $"Vendedor '{m.Nombre}' actualizado.");
        if (error is null) await CargarVendedores();
    }

    private async Task AlternarEstatusVendedor(VendedorDto v)
    {
        if (v.Activo)
        {
            var (_, error) = await Api.DarDeBajaVendedorAsync(v.IdVendedor);
            Notificar(error, $"Vendedor '{v.Nombre}' dado de baja.");
            if (error is null) await CargarVendedores();
        }
        else
        {
            var (_, error) = await Api.ActualizarVendedorAsync(v.IdVendedor, v.Nombre, v.IdZona, true, idUsuario: v.IdUsuario);
            Notificar(error, $"Vendedor '{v.Nombre}' reactivado.");
            if (error is null) await CargarVendedores();
        }
    }

    // ===================== Helpers =====================

    private async Task<DialogoPersona.FormModel?> MostrarDialogo(
        string titulo, string icono, string labelNombre, DialogoPersona.FormModel modelo)
    {
        var (usuarios, errorUsuarios) = await Api.ListarUsuariosAsync(incluirInactivos: true);
        if (errorUsuarios is not null)
        {
            _snackbar.Add(errorUsuarios, Severity.Error);
            return null;
        }
        _usuarios = usuarios ?? new();
        var opciones = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var parametros = new DialogParameters<DialogoPersona>
        {
            { x => x.Titulo, titulo },
            { x => x.Icono, icono },
            { x => x.LabelNombre, labelNombre },
            { x => x.Modelo, modelo },
            { x => x.Zonas, _zonas },
            { x => x.MostrarUsuario, true },
            { x => x.Usuarios, _usuarios.Where(u => u.Activo || u.IdUsuario == modelo.IdUsuario).OrderBy(u => u.Usuario).ToList() }
        };
        var dialogo = await _dialogo.ShowAsync<DialogoPersona>(titulo, parametros, opciones);
        var resultado = await dialogo.Result;
        return resultado is { Canceled: false, Data: DialogoPersona.FormModel datos } ? datos : null;
    }

    private void Notificar(string? error, string exito)
    {
        if (error is null) _snackbar.Add(exito, Severity.Success);
        else _snackbar.Add(error, Severity.Error);
    }
}
