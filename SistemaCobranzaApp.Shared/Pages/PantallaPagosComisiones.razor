@page "/pagos-comisiones"

@using MudBlazor
@using SistemaCobranzaApp.Shared.Components
@using SistemaCobranzaApp.Shared.Dtos
@using SistemaCobranzaApp.Shared.Services
@inject ApiCliente Api
@inject IDescargaArchivo Descarga
@inject EstadoEmpresaGlobal EmpresaGlobal
@inject IDialogService _dialogo
@inject ISnackbar _snackbar

<style>
    .barra-filtros-responsiva {
        display: flex;
        flex-direction: column;
        gap: 12px;
        width: 100%;
    }
    @@media (min-width: 768px) {
        .barra-filtros-responsiva {
            flex-direction: row;
            align-items: center;
        }
        .f-item-compacto {
            flex: 1;
            min-width: 140px;
        }
        .btn-buscar-compacto {
            min-width: 130px;
            height: 40px;
            margin-top: 6px;
        }
    }

    /* Barra de acciones (Seleccionadas / Monto Total / Botón).
       Móvil: apilada a ancho completo. Escritorio: en fila con el botón a la derecha. */
    .barra-acciones {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 12px;
    }
    .barra-acciones .chips-seleccion {
        display: flex;
        flex-direction: column;
        gap: 8px;
        width: 100%;
    }
    /* En móvil cada chip indicador ocupa todo el ancho. */
    .barra-acciones .chips-seleccion .mud-chip {
        width: 100%;
        justify-content: flex-start;
    }
    .barra-acciones .boton-accion {
        width: 100%;
    }
    @@media (min-width: 768px) {
        .barra-acciones {
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
        }
        .barra-acciones .chips-seleccion {
            flex-direction: row;
            flex-wrap: wrap;
            width: auto;
        }
        .barra-acciones .chips-seleccion .mud-chip {
            width: auto;
        }
        .barra-acciones .boton-accion {
            width: auto;
        }
    }
</style>

<MudTabs Elevation="2" Rounded="true" Color="Color.Primary" ApplyEffectsToContainer="true"
         PanelClass="pa-0 pt-4" SliderColor="Color.Warning" Class="ma-2 tabs-remarcados">

    <!-- ============================================================= -->
    <!-- ================= PESTAÑA 1: LIBERACIÓN MANUAL ================= -->
    <!-- ============================================================= -->
    <MudTabPanel Text="Liberar Créditos" Icon="@Icons.Material.Filled.LockOpen">
        <MudPaper Elevation="0" Class="pa-4">
            
            <div class="encabezado-seccion mb-4">
                <MudIcon Icon="@Icons.Material.Filled.LockOpen" Color="Color.Primary" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.h6" Class="titulo-seccion">Liberación Manual de Comisiones a Crédito</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Seleccione las comisiones de crédito en estatus PENDIENTE y autorice su cambio manual a DISPONIBLE para que pasen a la caja de cobro.
                    </MudText>
                </div>
            </div>

            <div class="barra-filtros-responsiva mb-3">
                <AutocompletarCatalogo TItem="ZonaDto" Label="Zona" Placeholder="Todas" Class="f-item-compacto"
                                       @bind-Value="_fZonaLib"
                                       Items="_zonas"
                                       ObtenerId="@(z => z.IdZona)"
                                       ObtenerTexto="@(z => z.Descripcion)" />

                <AutocompletarCatalogo TItem="VendedorDto" Label="Vendedor" Placeholder="Todos" Class="f-item-compacto"
                                       @bind-Value="_fVendedorLib"
                                       Items="_vendedoresFiltradosLib"
                                       ObtenerId="@(v => v.IdVendedor)"
                                       ObtenerTexto="@(v => v.Nombre)" />

                <MudDatePicker Label="Desde" @bind-Date="_fDesdeLib" Variant="Variant.Outlined" Clearable="true" Class="f-item-compacto" />
                <MudDatePicker Label="Hasta" @bind-Date="_fHastaLib" Variant="Variant.Outlined" Clearable="true" Class="f-item-compacto" />

                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Search" OnClick="CargarComisionesPendientes" Class="btn-buscar-compacto fw-bold">
                    Buscar
                </MudButton>
            </div>

            @if (_cargandoLib)
            {
                <div class="d-flex justify-center pa-8"><MudProgressCircular Indeterminate="true" /></div>
            }
            else
            {
                <div class="barra-acciones mb-3">
                    <div class="chips-seleccion">
                        <MudChip T="string" Color="Color.Secondary" Variant="Variant.Text"><b>Seleccionadas:</b> @_seleccionadasLib.Count</MudChip>
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Text"><b>Monto Total:</b> @_montoTotalSeleccionadoLib.ToString("C2")</MudChip>
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.AssignmentTurnedIn" Class="boton-accion" Disabled="@(!_seleccionadasLib.Any() || _procesandoLib)" OnClick="ProcesarLiberacionManual">
                        @(_procesandoLib ? "Liberando..." : "Autorizar y Pasar a Disponible")
                    </MudButton>
                </div>

                <MudTextField T="string" @bind-Value="_busquedaLib" Immediate="true"
                              Placeholder="Buscar por zona, vendedor, folio o producto…"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Class="mb-3" />
                <MudTable Items="_comisionesPendientes" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm"
                          Elevation="0" RowsPerPage="20" T="ComisionPendientePagoDto" Class="tabla-seguimiento"
                          Filter="new Func<ComisionPendientePagoDto, bool>(FiltrarLib)">
                    <HeaderContent>
                        <MudTh Style="width: 50px; text-align: center;">
                            <MudCheckBox T="bool" Value="_todosSeleccionadosLib" ValueChanged="AlternarTodosCheckboxesLib" Color="Color.Primary" Dense="true" />
                        </MudTh>
                        <MudTh><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<ComisionPendientePagoDto, object>(x => x.FechaCalculo)">Fecha Cálculo</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ComisionPendientePagoDto, object>(x => x.NombreZona ?? string.Empty)">Zona</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ComisionPendientePagoDto, object>(x => x.NombreVendedor ?? string.Empty)">Vendedor</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ComisionPendientePagoDto, object>(x => x.CodigoVenta ?? string.Empty)">Folio Venta</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ComisionPendientePagoDto, object>(x => x.DescripcionProducto ?? string.Empty)">Producto</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right;"><MudTableSortLabel SortBy="new Func<ComisionPendientePagoDto, object>(x => x.MontoComision)">Monto Comisión</MudTableSortLabel></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Style="text-align: center;">
                            <MudCheckBox T="bool" Value="@_seleccionadasLib.Contains(context.IdComision)" ValueChanged="@((bool check) => AlternarSeleccionFilaLib(context.IdComision, check))" Color="Color.Primary" Dense="true" />
                        </MudTd>
                        <MudTd DataLabel="Fecha Cálculo">@context.FechaCalculo.EnZonaProyecto().DateTime.ToString("dd/MM/yyyy HH:mm")</MudTd>
                        <MudTd DataLabel="Zona"><MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">@context.NombreZona</MudChip></MudTd>
                        <MudTd DataLabel="Vendedor"><b>@context.NombreVendedor</b></MudTd>
                        <MudTd DataLabel="Folio Venta"><code>@context.CodigoVenta</code></MudTd>
                        <MudTd DataLabel="Producto">@context.DescripcionProducto</MudTd>
                        <MudTd DataLabel="Monto Comisión" Style="text-align:right; font-weight:bold;" Class="text-primary">@context.MontoComision.ToString("C2")</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="pa-4 text-center">
                            <MudText Typo="Typo.body1" Color="Color.Secondary">🚩 No se encontraron comisiones en estatus <b>PENDIENTE</b>.</MudText>
                        </div>
                    </NoRecordsContent>
                    <PagerContent>
                        <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Filas:" />
                    </PagerContent>
                </MudTable>
            }
        </MudPaper>
    </MudTabPanel>
       <!-- ============================================================= -->
    <!-- ==================== PESTAÑA 2: CAJA / PAGO ==================== -->
    <!-- ============================================================= -->
    <MudTabPanel Text="Caja (Pagar Disponibles)" Icon="@Icons.Material.Filled.Payments">
        <MudPaper Elevation="0" Class="pa-4">
            
            <div class="encabezado-seccion mb-4">
                <MudIcon Icon="@Icons.Material.Filled.Payments" Color="Color.Primary" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.h6" Class="titulo-seccion">Pago Manual de Comisiones Disponibles</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Consulte, audite y liquide las comisiones en estatus DISPONIBLE de los vendedores. Filtre por zona, vendedor o rango de fechas y confirme los pagos masivos de forma segura.
                    </MudText>
                </div>
            </div>

            <div class="barra-filtros-responsiva mb-3">
                <AutocompletarCatalogo TItem="ZonaDto" Label="Zona" Placeholder="Todas" Class="f-item-compacto"
                                       @bind-Value="_fZona"
                                       Items="_zonas"
                                       ObtenerId="@(z => z.IdZona)"
                                       ObtenerTexto="@(z => z.Descripcion)" />

                <AutocompletarCatalogo TItem="VendedorDto" Label="Vendedor" Placeholder="Todos" Class="f-item-compacto"
                                       @bind-Value="_fVendedor"
                                       Items="_vendedoresFiltrados"
                                       ObtenerId="@(v => v.IdVendedor)"
                                       ObtenerTexto="@(v => v.Nombre)" />

                <MudDatePicker Label="Desde" @bind-Date="_fDesde" Variant="Variant.Outlined" Clearable="true" Class="f-item-compacto" />
                <MudDatePicker Label="Hasta" @bind-Date="_fHasta" Variant="Variant.Outlined" Clearable="true" Class="f-item-compacto" />

                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Search" OnClick="CargarComisiones" Class="btn-buscar-compacto fw-bold">
                    Buscar
                </MudButton>
            </div>

            @if (_cargandoComisiones)
            {
                <div class="d-flex justify-center pa-8"><MudProgressCircular Indeterminate="true" /></div>
            }
            else
            {
                <div class="barra-acciones mb-3">
                    <div class="chips-seleccion">
                        <MudChip T="string" Color="Color.Secondary" Variant="Variant.Text"><b>Seleccionadas:</b> @_seleccionadas.Count</MudChip>
                        <MudChip T="string" Color="Color.Success" Variant="Variant.Text"><b>Monto Total:</b> @_montoTotalSeleccionado.ToString("C2")</MudChip>
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.PriceCheck" Class="boton-accion" Disabled="@(!_seleccionadas.Any() || _procesandoPago)" OnClick="ProcesarPagoManual">
                        @(_procesandoPago ? "Procesando..." : "Confirmar Pago de Seleccionadas")
                    </MudButton>
                </div>

                <MudTextField T="string" @bind-Value="_busquedaCaja" Immediate="true"
                              Placeholder="Buscar por zona, vendedor, folio o producto…"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Class="mb-3" />
                <MudTable Items="_comisiones" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm"
                          Elevation="0" RowsPerPage="20" T="ComisionPendientePagoDto" Class="tabla-seguimiento"
                          Filter="new Func<ComisionPendientePagoDto, bool>(FiltrarCaja)">
                    <HeaderContent>
                        <MudTh Style="width: 50px; text-align: center;">
                            <MudCheckBox T="bool" Value="_todosSeleccionados" ValueChanged="AlternarTodosCheckboxes" Color="Color.Primary" Dense="true" />
                        </MudTh>
                        <MudTh><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<ComisionPendientePagoDto, object>(x => x.FechaCalculo)">Fecha Cálculo</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ComisionPendientePagoDto, object>(x => x.NombreZona ?? string.Empty)">Zona</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ComisionPendientePagoDto, object>(x => x.NombreVendedor ?? string.Empty)">Vendedor</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ComisionPendientePagoDto, object>(x => x.CodigoVenta ?? string.Empty)">Folio Venta</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ComisionPendientePagoDto, object>(x => x.DescripcionProducto ?? string.Empty)">Producto</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right;"><MudTableSortLabel SortBy="new Func<ComisionPendientePagoDto, object>(x => x.MontoComision)">Monto Comisión</MudTableSortLabel></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Style="text-align: center;">
                            <MudCheckBox T="bool" Value="@_seleccionadas.Contains(context.IdComision)" ValueChanged="@((bool check) => AlternarSeleccionFila(context.IdComision, check))" Color="Color.Primary" Dense="true" />
                        </MudTd>
                        <MudTd DataLabel="Fecha Cálculo">@context.FechaCalculo.EnZonaProyecto().DateTime.ToString("dd/MM/yyyy HH:mm")</MudTd>
                        <MudTd DataLabel="Zona"><MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">@context.NombreZona</MudChip></MudTd>
                        <MudTd DataLabel="Vendedor"><b>@context.NombreVendedor</b></MudTd>
                        <MudTd DataLabel="Folio Venta"><code>@context.CodigoVenta</code></MudTd>
                        <MudTd DataLabel="Producto">@context.DescripcionProducto</MudTd>
                        <MudTd DataLabel="Monto Comisión" Style="text-align:right; font-weight:bold;" Class="text-success">@context.MontoComision.ToString("C2")</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="pa-4 text-center">
                            <MudText Typo="Typo.body1" Color="Color.Secondary">🚩 No se encontraron comisiones en estatus <b>DISPONIBLE</b>.</MudText>
                        </div>
                    </NoRecordsContent>
                    <PagerContent>
                        <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Filas:" />
                    </PagerContent>
                </MudTable>
            }
        </MudPaper>
    </MudTabPanel>
    <!-- ============================================================= -->
    <!-- ==================== PESTAÑA 3: HISTORIAL =================== -->
    <!-- ============================================================= -->
    <MudTabPanel Text="Historial de Pagos" Icon="@Icons.Material.Filled.History">
        <MudPaper Elevation="0" Class="pa-4">
            
            <div class="encabezado-seccion mb-4">
                <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Primary" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.h6" Class="titulo-seccion">Historial de Comisiones Liquidadas</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Consulte la bitácora histórica de comisiones que ya fueron pagadas en efectivo a los vendedores. Filtre por zona, vendedor y rango de fechas.
                    </MudText>
                </div>
            </div>

            <div class="barra-filtros-responsiva mb-3">
                <AutocompletarCatalogo TItem="ZonaDto" Label="Zona" Placeholder="Todas" Class="f-item-compacto"
                                       @bind-Value="_fZonaHist"
                                       Items="_zonas"
                                       ObtenerId="@(z => z.IdZona)"
                                       ObtenerTexto="@(z => z.Descripcion)" />

                <AutocompletarCatalogo TItem="VendedorDto" Label="Vendedor" Placeholder="Todos" Class="f-item-compacto"
                                       @bind-Value="_fVendedorHist"
                                       Items="_vendedoresFiltradosHist"
                                       ObtenerId="@(v => v.IdVendedor)"
                                       ObtenerTexto="@(v => v.Nombre)" />

                <MudDatePicker Label="Desde" @bind-Date="_fDesdeHist" Variant="Variant.Outlined" Clearable="true" Class="f-item-compacto" />
                <MudDatePicker Label="Hasta" @bind-Date="_fHastaHist" Variant="Variant.Outlined" Clearable="true" Class="f-item-compacto" />

                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Search" OnClick="CargarHistorialPagadas" Class="btn-buscar-compacto fw-bold">
                    Buscar
                </MudButton>
            </div>

            @if (_cargandoHistorial)
            {
                <div class="d-flex justify-center pa-8"><MudProgressCircular Indeterminate="true" /></div>
            }
            else
            {
                <div class="barra-acciones mb-3">
                    <div class="chips-seleccion">
                        <MudChip T="string" Color="Color.Success" Variant="Variant.Text">
                            <b>Total Histórico Pagado:</b> @_montoTotalHistorial.ToString("C2")
                        </MudChip>
                    </div>
                    <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.FileDownload"
                               Class="boton-accion" OnClick="ExportarHistorial"
                               Disabled="@(_exportando || _comisionesHistorial.Count == 0)">
                        Exportar a Excel
                    </MudButton>
                </div>

                <MudTextField T="string" @bind-Value="_busquedaHist" Immediate="true"
                              Placeholder="Buscar por zona, vendedor, folio o producto…"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Class="mb-3" />
                <MudTable Items="_comisionesHistorial" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm"
                          Elevation="0" RowsPerPage="20" T="ComisionPendientePagoDto" Class="tabla-seguimiento"
                          Filter="new Func<ComisionPendientePagoDto, bool>(FiltrarHist)">
                    <HeaderContent>
                        <MudTh><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<ComisionPendientePagoDto, object>(x => x.FechaCalculo)">Fecha Pago / Registro</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ComisionPendientePagoDto, object>(x => x.NombreZona ?? string.Empty)">Zona</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ComisionPendientePagoDto, object>(x => x.NombreVendedor ?? string.Empty)">Vendedor</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ComisionPendientePagoDto, object>(x => x.CodigoVenta ?? string.Empty)">Folio Venta</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<ComisionPendientePagoDto, object>(x => x.DescripcionProducto ?? string.Empty)">Producto</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right;"><MudTableSortLabel SortBy="new Func<ComisionPendientePagoDto, object>(x => x.MontoComision)">Monto Pagado</MudTableSortLabel></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Fecha Pago / Registro">@context.FechaCalculo.EnZonaProyecto().DateTime.ToString("dd/MM/yyyy HH:mm")</MudTd>
                        <MudTd DataLabel="Zona"><MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">@context.NombreZona</MudChip></MudTd>
                        <MudTd DataLabel="Vendedor"><b>@context.NombreVendedor</b></MudTd>
                        <MudTd DataLabel="Folio Venta"><code>@context.CodigoVenta</code></MudTd>
                        <MudTd DataLabel="Producto">@context.DescripcionProducto</MudTd>
                        <MudTd DataLabel="Monto Pagado" Style="text-align:right; font-weight:bold;" Class="text-success">@context.MontoComision.ToString("C2")</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="pa-4 text-center">
                            <MudText Typo="Typo.body1" Color="Color.Secondary">🚩 No se encontraron registros de comisiones pagadas.</MudText>
                        </div>
                    </NoRecordsContent>
                    <PagerContent>
                        <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Filas:" />
                    </PagerContent>
                </MudTable>
            }
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    private const string ComponenteLog = "PantallaPagosComisiones";

    private List<ZonaDto> _zonas = new();
    private List<VendedorDto> _vendedoresGlobales = new();
    private bool _exportando;
    private string? _busquedaLib;
    private string? _busquedaCaja;
    private string? _busquedaHist;
    
    // ---- Pestaña 1: Liberaciones (Pendientes) ----
    private List<ComisionPendientePagoDto> _comisionesPendientes = new();
    private bool _cargandoLib;
    private bool _procesandoLib;
    private long? _fZonaLib;
    private long? _fVendedorLib;
    private DateTime? _fDesdeLib;
    private DateTime? _fHastaLib;
    private HashSet<long> _seleccionadasLib = new();
    private decimal _montoTotalSeleccionadoLib => _comisionesPendientes.Where(c => _seleccionadasLib.Contains(c.IdComision)).Sum(c => c.MontoComision);
    private bool _todosSeleccionadosLib => _comisionesPendientes.Any() && _seleccionadasLib.Count == _comisionesPendientes.Count;
    private List<VendedorDto> _vendedoresFiltradosLib => _fZonaLib.HasValue ? _vendedoresGlobales.Where(v => v.IdZona == _fZonaLib.Value).ToList() : _vendedoresGlobales;

    // ---- Pestaña 2: Caja (Disponibles) ----
    private List<ComisionPendientePagoDto> _comisiones = new();
    private bool _cargandoComisiones;
    private bool _procesandoPago;
    private long? _fZona;
    private long? _fVendedor;
    private DateTime? _fDesde;
    private DateTime? _fHasta;
    private HashSet<long> _seleccionadas = new();
    private decimal _montoTotalSeleccionado => _comisiones.Where(c => _seleccionadas.Contains(c.IdComision)).Sum(c => c.MontoComision);
    private bool _todosSeleccionados => _comisiones.Any() && _seleccionadas.Count == _comisiones.Count;
    private List<VendedorDto> _vendedoresFiltrados => _fZona.HasValue ? _vendedoresGlobales.Where(v => v.IdZona == _fZona.Value).ToList() : _vendedoresGlobales;

    // ---- Pestaña 3: Historial de Pagos ----
    private List<ComisionPendientePagoDto> _comisionesHistorial = new();
    private bool _cargandoHistorial;
    private long? _fZonaHist;
    private long? _fVendedorHist;
    private DateTime? _fDesdeHist = FechaProyecto.Hoy.AddMonths(-1);
    private DateTime? _fHastaHist = FechaProyecto.Hoy;
    private decimal _montoTotalHistorial => _comisionesHistorial.Sum(c => c.MontoComision);
    private List<VendedorDto> _vendedoresFiltradosHist => _fZonaHist.HasValue ? _vendedoresGlobales.Where(v => v.IdZona == _fZonaHist.Value).ToList() : _vendedoresGlobales;

    protected override async Task OnInitializedAsync()
    {
        await CargarCatalogos();
        await Task.WhenAll(CargarComisionesPendientes(), CargarComisiones(), CargarHistorialPagadas());
    }

    private async Task CargarCatalogos()
    {
        var (zonas, _) = await Api.ListarZonasOperativasAsync();
        _zonas = zonas ?? new();

        var (vend, _) = await Api.ListarVendedoresOperativosAsync();
        _vendedoresGlobales = vend ?? new();
    }

    private async Task CargarComisionesPendientes()
    {
        _cargandoLib = true;
        _seleccionadasLib.Clear();

        var filtros = new FiltroComisionesRequest(IdVendedor: _fVendedorLib, IdZona: _fZonaLib, FechaDesde: _fDesdeLib, FechaHasta: _fHastaLib);
        var (datos, error) = await Api.ListarComisionesPendientesLiberarAsync(filtros);
        _cargandoLib = false;

        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        _comisionesPendientes = datos ?? new();
    }

    private async Task CargarComisiones()
    {
        _cargandoComisiones = true;
        _seleccionadas.Clear(); 

        var filtros = new FiltroComisionesRequest(IdVendedor: _fVendedor, IdZona: _fZona, FechaDesde: _fDesde, FechaHasta: _fHasta);
        var (datos, error) = await Api.ListarComisionesPendientesPagoAsync(filtros);
        _cargandoComisiones = false;

        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        _comisiones = datos ?? new();
    }

    private async Task CargarHistorialPagadas()
    {
        _cargandoHistorial = true;

        var filtros = new FiltroComisionesRequest(IdVendedor: _fVendedorHist, IdZona: _fZonaHist, FechaDesde: _fDesdeHist, FechaHasta: _fHastaHist);
        var (datos, error) = await Api.ListarHistorialComisionesPagadasAsync(filtros);
        _cargandoHistorial = false;

        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }
        _comisionesHistorial = datos ?? new();
    }

    // Handlers Pestaña 1
    private void AlternarSeleccionFilaLib(long id, bool check) => _ = check ? _seleccionadasLib.Add(id) : _seleccionadasLib.Remove(id);
    private void AlternarTodosCheckboxesLib(bool check) => _seleccionadasLib = check ? _comisionesPendientes.Select(c => c.IdComision).ToHashSet() : new();

    // Handlers Pestaña 2
    private void AlternarSeleccionFila(long id, bool check) => _ = check ? _seleccionadas.Add(id) : _seleccionadas.Remove(id);
    private void AlternarTodosCheckboxes(bool check) => _seleccionadas = check ? _comisiones.Select(c => c.IdComision).ToHashSet() : new();

    private async Task ProcesarLiberacionManual()
    {
        if (!_seleccionadasLib.Any()) return;
        var ok = await ConfirmarDialogo("Confirmar Liberación", $"¿Liberar manual {_seleccionadasLib.Count} comisiones por {_montoTotalSeleccionadoLib.ToString("C2")} a estatus DISPONIBLE?", "Liberar Comisiones", Color.Success);
        if (!ok) return;

        _procesandoLib = true;
        var (res, error) = await Api.ProcesarLiberacionComisionesAsync(new ProcesarPagoComisionesRequest(_seleccionadasLib.ToList()));
        _procesandoLib = false;

        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }

        _snackbar.Add($"Se liberaron {res} comisiones correctamente.", Severity.Success);
        await Task.WhenAll(CargarComisionesPendientes(), CargarComisiones(), CargarHistorialPagadas());
    }

    private async Task ProcesarPagoManual()
    {
        if (!_seleccionadas.Any()) return;
        var ok = await ConfirmarDialogo("Confirmar liquidación", $"¿Asentar el pago manual de las {_seleccionadas.Count} comisiones por un total de {_montoTotalSeleccionado.ToString("C2")}?", "Liquidar y Pagar", Color.Success);
        if (!ok) return;

        _procesandoPago = true;
        var (res, error) = await Api.ProcesarPagoComisionesAsync(new ProcesarPagoComisionesRequest(_seleccionadas.ToList()));
        _procesandoPago = false;

        if (error is not null) { _snackbar.Add(error, Severity.Error); return; }

        _snackbar.Add($"Se aplicó el pago correctamente para {res} comisiones.", Severity.Success);
        await Task.WhenAll(CargarComisiones(), CargarHistorialPagadas()); 
    }

    // ---- Búsqueda de las tablas ----
    private bool FiltrarLib(ComisionPendientePagoDto c) => CoincideComision(c, _busquedaLib);
    private bool FiltrarCaja(ComisionPendientePagoDto c) => CoincideComision(c, _busquedaCaja);
    private bool FiltrarHist(ComisionPendientePagoDto c) => CoincideComision(c, _busquedaHist);

    private static bool CoincideComision(ComisionPendientePagoDto c, string? termino)
    {
        if (string.IsNullOrWhiteSpace(termino)) return true;
        return Contiene(c.NombreZona, termino) || Contiene(c.NombreVendedor, termino)
            || Contiene(c.CodigoVenta, termino) || Contiene(c.DescripcionProducto, termino);
    }

    private static bool Contiene(string? valor, string termino)
        => (valor ?? string.Empty).Contains(termino, StringComparison.OrdinalIgnoreCase);

    // ---- Exportación a Excel del historial (mismo estándar que Reportes) ----
    private async Task ExportarHistorial()
    {
        if (_exportando || _comisionesHistorial.Count == 0) return;
        _exportando = true;
        try
        {
            var info = new ReporteExcelInfo
            {
                Empresa = EmpresaGlobal.Info?.NombreCorto
                          ?? EmpresaGlobal.Identidad?.NombreCorto
                          ?? "Sistema Cobranza",
                Titulo = "HISTORIAL DE COMISIONES PAGADAS",
                FechaGeneracion = FechaProyecto.Ahora.DateTime,
                Filtros = new()
                {
                    ["Zona"] = _zonas.FirstOrDefault(z => z.IdZona == _fZonaHist)?.Descripcion ?? "Todas",
                    ["Vendedor"] = _vendedoresGlobales.FirstOrDefault(v => v.IdVendedor == _fVendedorHist)?.Nombre ?? "Todos",
                    ["Desde"] = FechaFiltro(_fDesdeHist),
                    ["Hasta"] = FechaFiltro(_fHastaHist)
                },
                Kpis = new()
                {
                    Kpi("Comisiones", _comisionesHistorial.Count.ToString()),
                    Kpi("Total pagado", _montoTotalHistorial.ToString("C2"))
                }
            };
            string[] columnas = ["Fecha pago / registro", "Zona", "Vendedor", "Folio venta", "Producto", "Monto pagado"];
            var filas = _comisionesHistorial.Select(c => new object?[]
            {
                c.FechaCalculo.EnZonaProyecto().DateTime.ToString("dd/MM/yyyy HH:mm"),
                c.NombreZona, c.NombreVendedor, c.CodigoVenta, c.DescripcionProducto, c.MontoComision
            });
            var bytes = ExportadorExcel.Crear(info, columnas, filas, [6]);
            await Descarga.GuardarAsync($"Historial-Comisiones-{FechaProyecto.Ahora:yyyyMMdd-HHmmssfff}.xlsx", bytes);
        }
        catch (Exception ex) { _snackbar.Add($"No se pudo exportar el historial: {ex.Message}", Severity.Error); }
        finally { _exportando = false; }
    }

    private static ReporteExcelKpi Kpi(string nombre, string valor) => new() { Nombre = nombre, Valor = valor };

    private static string FechaFiltro(DateTime? d, string vacio = "Sin límite") => d is { } v ? v.ToString("dd/MM/yyyy") : vacio;

    private async Task<bool> ConfirmarDialogo(string titulo, string mensaje, string textoAceptar, Color color)
    {
        var opciones = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var parametros = new DialogParameters<DialogoConfirmacion>
        {
            { x => x.Titulo, titulo }, { x => x.Mensaje, mensaje }, { x => x.TextoAceptar, textoAceptar }, { x => x.ColorAceptar, color }, { x => x.Icono, Icons.Material.Filled.CheckCircle }, { x => x.ColorIcono, color }
        };
        var dialogo = await _dialogo.ShowAsync<DialogoConfirmacion>(titulo, parametros, opciones);
        var resultado = await dialogo.Result;
        return resultado is { Canceled: false, Data: true };
    }
