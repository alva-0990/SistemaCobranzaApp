@page "/admin/zonas"
@inherits ZonasBase

<div class="cobranza-container">
    
    <!-- Encabezado Principal -->
    <div class="cobranza-header">
        <div class="header-title-zone">
            <span class="menu-icon">☰</span>
            <h2>Productos / Zonas</h2>
        </div>
        <button class="btn-crear-nuevo" @onclick="NuevaZona">CREAR NUEVO</button>
    </div>

    <!-- Filtros de Control -->
    <div class="cobranza-filters">
        <div class="filter-group">
            <label>Tipo</label>
            <select class="form-select">
                <option>Todos</option>
            </select>
        </div>
    </div>

    <!-- Contenedor del Catálogo Principal -->
    <div class="catalog-content">
        @if (Ocupado && ZonasList.Count == 0)
        {
            <div class="state-placeholder">Cargando registros desde la API...</div>
        }
        else if (ZonasList.Count == 0)
        {
            <div class="state-placeholder">No hay registros cargados en la base de datos (Puerto 8081).</div>
        }
        else
        {
            <!-- VISTA ESCRITORIO: Tabla Horizontal Compacta -->
            <div class="desktop-table-view">
                <table class="cobranza-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre de producto / Descripción</th>
                            <th style="text-align: center;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var zona in ZonasList)
                        {
                            <tr>
                                <td class="td-id">#@zona.IdZona</td>
                                <td class="td-desc">@zona.Descripcion</td>
                                <td class="td-actions">
                                    <button class="action-icon btn-tbl-edit" title="Editar" @onclick="() => Editar(zona)">📝</button>
                                    <button class="action-icon btn-tbl-delete" title="Dar de baja" @onclick="() => DarDeBajaAsync(zona)">🗑️</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- VISTA MÓVIL ANDROID: Acordeones Compactos Inteligentes -->
            <div class="mobile-list-view">
                @foreach (var zona in ZonasList)
                {
                    <div class="mobile-row-card">
                        <div class="card-summary" @onclick="() => AlternarDetalle(zona.IdZona)">
                            <span class="arrow-indicator @(IdExpandido == zona.IdZona ? "expanded" : "")">▼</span>
                            <span class="card-main-text">@zona.Descripcion</span>
                            <span class="card-id-tag">#@zona.IdZona</span>
                        </div>
                        
                        @if (IdExpandido == zona.IdZona)
                        {
                            <div class="card-expanded-details">
                                <div class="detail-line">
                                    <span class="detail-label">Nombre:</span>
                                    <span class="detail-value">@zona.Descripcion</span>
                                </div>
                                <div class="detail-line">
                                    <span class="detail-label">Estado:</span>
                                    <span class="status-badge badge-active">Activo</span>
                                </div>
                                <div class="detail-actions-row">
                                    <span class="detail-label">Acción:</span>
                                    <div class="actions-wrapper">
                                        <button class="circle-btn edit-circle" @onclick="() => Editar(zona)">📝</button>
                                        <button class="circle-btn delete-circle" @onclick="() => DarDeBajaAsync(zona)">🗑️</button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            
            <!-- Paginador Inferior Responsivo -->
            <div class="cobranza-pagination">
                <div class="pagination-selector">
                    <span>Mostrando</span>
                    <select class="select-mini">
                        <option>10</option>
                    </select>
                    <span>de @ZonasList.Count entradas</span>
                </div>
                <div class="pagination-buttons">
                    <button class="btn-pag-arrow" disabled>◀</button>
                    <button class="btn-pag-arrow" disabled>▶</button>
                </div>
            </div>
        }
    </div>

    <!-- Modal Formulario Flotante de Alta/Edición -->
    @if (FormularioVisible)
    {
        <div class="modal-backdrop">
            <div class="modal-box">
                <h4 class="modal-title">@(IdEditando is null ? "Nueva zona" : "Editar zona")</h4>
                <div class="form-group-modal">
                    <label>Descripción / Nombre</label>
                    <input type="text" @bind="Descripcion" disabled="@Ocupado" class="input-flat" placeholder="Ej. Tecamachalco" />
                </div>
                
                @if (!string.IsNullOrEmpty(MensajeError))
                {
                    <div class="error-toast">@MensajeError</div>
                }

                <div class="modal-buttons">
                    <button class="btn-mdl btn-mdl-cancel" @onclick="Cancelar" disabled="@Ocupado">Cancelar</button>
                    <button class="btn-mdl btn-mdl-save" @onclick="KeepGuardar" disabled="@Ocupado">Guardar</button>
                </div>
            </div>
        </div>
    }
</div>
