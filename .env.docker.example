# =====================================================================
# Variables para docker-compose. Copia este archivo como ".env" en la
# RAÍZ del repo (junto a docker-compose.yml) y EDITA los valores reales.
#
#   cp .env.docker.example .env
#   nano .env
#
# Docker Compose lee ".env" automáticamente. NO subas el ".env" real al repo.
# =====================================================================

# Contraseña de PostgreSQL (la usa el contenedor de BD y la cadena de conexión de la API).
POSTGRES_PASSWORD=CAMBIAR_POR_CONTRASENA_FUERTE

# La MISMA contraseña, codificada para URL (la usa Evolution en su cadena postgresql://).
# Obligatoria si la contraseña tiene caracteres como # * ! @ : / ?
# Genérala con:  python3 -c "import urllib.parse;print(urllib.parse.quote(input(),safe=''))"
# Si la contraseña solo tiene letras y números, pon el mismo valor que POSTGRES_PASSWORD.
POSTGRES_PASSWORD_URL=CAMBIAR_POR_CONTRASENA_CODIFICADA

# Clave JWT de la API. Genera una con:  openssl rand -base64 48
JWT_KEY=CAMBIAR_POR_CLAVE_ALEATORIA_MINIMO_32_BYTES
JWT_MINUTOS=900

# URL pública de la API que consumirá el Web (y la app). Debe coincidir con el hostname
# mapeado en el túnel de Cloudflare.
WEB_API_BASEURL=https://api.cobragil.com

# Token del túnel de Cloudflare (Zero Trust → Networks → Tunnels → tu túnel → token).
TUNNEL_TOKEN=PEGA_AQUI_EL_TOKEN_DEL_TUNEL

# =====================================================================
# WhatsApp (Evolution API) - SOLO datos de conexión (secretos).
# Prender/apagar el envío, notificar venta/pago, plantillas y purga se
# controlan desde la tabla de parámetros (parametrossistema), NO aquí.
# Mientras estos tres valores estén vacíos, el worker deja los mensajes
# en 'Pendiente' sin gastar reintentos.
#
# - WHATSAPP_BASEURL: la API alcanza Evolution por la red interna de Docker.
#   Déjalo en http://evolution:8080 (nombre del servicio del compose).
# - WHATSAPP_APIKEY: la INVENTAS tú (cadena larga). Debe ser la MISMA que
#   AUTHENTICATION_API_KEY del servicio 'evolution'. Genera una con:
#       openssl rand -hex 32
# - WHATSAPP_INSTANCIA: el nombre que le des al crear la instancia (ver README/pasos).
# =====================================================================
WHATSAPP_BASEURL=http://evolution:8080
WHATSAPP_INSTANCIA=cobranza
WHATSAPP_APIKEY=dc9dd05c13155052df0f19216e6e827dfec4813d96be484ca45bfcb1fe5e3d0a

# - WHATSAPP_WEBHOOK_SECRET: la INVENTAS tú. Evolution la envía en el header
#   X-Webhook-Secret al avisar respuestas de clientes (BAJA). Debe ser la MISMA
#   que se registra en el webhook de Evolution (ver deploy/GUIA-WHATSAPP.md).
#   Genera una con:  openssl rand -hex 24
WHATSAPP_WEBHOOK_SECRET=


# =====================================================================
# WhatsApp API OFICIAL (Meta Cloud API) - SOLO secretos de conexion.
# Se usa unicamente cuando el parametro WHATSAPP_PROVEEDOR = OFICIAL
# (tabla parametrossistema). Con EVOLUTION se ignoran.
# Ver deploy/GUIA-WHATSAPP-PROVEEDORES.md.
#
# - WHATSAPP_OFICIAL_PHONE_NUMBER_ID: "Identificador del numero de telefono" en
#   Meta > WhatsApp > Configuracion de la API.
# - WHATSAPP_OFICIAL_ACCESS_TOKEN: token PERMANENTE de un usuario del sistema.
#   Es un secreto: no lo subas al repo.
# =====================================================================
WHATSAPP_OFICIAL_PHONE_NUMBER_ID=
WHATSAPP_OFICIAL_ACCESS_TOKEN=
WHATSAPP_OFICIAL_VERSION_API=v21.0
