# =====================================================================
# Variables para docker-compose. Copia este archivo como ".env" en la
# RAÍZ del repo (junto a docker-compose.yml) y EDITA los valores reales.
#
#   cp .env.docker.example .env
#   nano .env
#
# Docker Compose lee ".env" automáticamente. NO subas el ".env" real al repo.
# =====================================================================

# Contraseña de PostgreSQL (la usa el contenedor de BD y la cadena de conexión de la API).
POSTGRES_PASSWORD=CAMBIAR_POR_CONTRASENA_FUERTE

# Clave JWT de la API. Genera una con:  openssl rand -base64 48
JWT_KEY=CAMBIAR_POR_CLAVE_ALEATORIA_MINIMO_32_BYTES
JWT_MINUTOS=900

# URL pública de la API que consumirá el Web (y la app). Debe coincidir con el hostname
# mapeado en el túnel de Cloudflare.
WEB_API_BASEURL=https://api.cobragil.com

# Token del túnel de Cloudflare (Zero Trust → Networks → Tunnels → tu túnel → token).
TUNNEL_TOKEN=PEGA_AQUI_EL_TOKEN_DEL_TUNEL
