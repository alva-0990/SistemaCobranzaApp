# =====================================================================
# Configuración del Web — copiar al servidor como /etc/cobranza/web.env
# y editar si cambia la URL de la API.
#
#   sudo cp deploy/cobranza-web.env.example /etc/cobranza/web.env
#   sudo nano /etc/cobranza/web.env
#   sudo chmod 600 /etc/cobranza/web.env
# =====================================================================

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:8080

# URL pública de la API (Cloudflare Tunnel)
ApiSettings__BaseUrl=https://api.cobragil.com
