# =====================================================================
# Secretos de la API — copiar al servidor como /etc/cobranza/api.env
# y EDITAR con los valores reales. NO subir este archivo con secretos al repo.
#
#   sudo mkdir -p /etc/cobranza
#   sudo cp deploy/cobranza-api.env.example /etc/cobranza/api.env
#   sudo nano /etc/cobranza/api.env        # <-- edita aquí tus secretos
#   sudo chmod 600 /etc/cobranza/api.env
#   sudo chown root:root /etc/cobranza/api.env
#
# ASP.NET Core lee estas variables y SOBRESCRIBE appsettings.json.
# La anidación se expresa con doble guion bajo: Seccion__Clave.
# =====================================================================

# Entorno de ejecución
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:8081

# --- Base de datos PostgreSQL (misma contraseña que en docker-compose.yml) ---
ConnectionStrings__Cobranza=Host=127.0.0.1;Port=5432;Database=sistema_cobranza;Username=cobranza;Password=CAMBIAR_POR_CONTRASENA_FUERTE

# --- JWT (genera la clave con: openssl rand -base64 48) ---
Jwt__Issuer=SistemaCobranza
Jwt__Audience=SistemaCobranza
Jwt__Key=CAMBIAR_POR_CLAVE_ALEATORIA_MINIMO_32_BYTES
Jwt__MinutosVigencia=900
